---
import Icon from './Icon.astro';
import { CONTACTO } from '../consts';
---

<section id="contacto" class="relative bg-surface-2 border-t border-white/10 py-24 md:py-32 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="max-w-2xl mx-auto text-center">
      <h2 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] text-balance text-fg" style="letter-spacing:-0.03em">
        Empieza por una página.
      </h2>
      <p class="mt-6 text-fg-muted text-base md:text-lg leading-relaxed">
        Escríbenos la dirección de tu sitio y te respondemos con la revisión.
      </p>
      <a
        href={CONTACTO}
        class="mt-8 inline-flex items-center gap-2 bg-paper hover:bg-white text-bg text-sm font-semibold px-6 py-3 rounded-full transition-colors"
      >
        Enviar la dirección de mi sitio
        <Icon name="arrowRight" />
      </a>
    </div>
  </div>
</section>
