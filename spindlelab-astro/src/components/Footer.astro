---
import Icon from './Icon.astro';
import { CONTACTO, EMAIL } from '../consts';

const COLUMNAS = [
  {
    titulo: 'Servicios',
    links: [
      { label: 'Auditoría SEO Técnica', href: '#servicios' },
      { label: 'Optimización AEO/GEO', href: '#servicios' },
      { label: 'Consultoría Mensual', href: '#servicios' },
      { label: 'Desarrollo Web', href: '#desarrollo-web' },
    ],
  },
  {
    titulo: 'Sitio',
    links: [
      { label: 'Nuestro Método', href: '#metodo' },
      { label: 'Contacto', href: '#contacto' },
    ],
  },
];
---

<footer class="bg-[#080D0A] border-t border-white/10 px-4 sm:px-6 pt-16 pb-10">
  <div class="max-w-6xl mx-auto">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr_1.2fr]">
      <div>
        <p class="text-2xl font-bold tracking-tight text-[#F4F6F3]" style="font-family:'Gabarito','Manrope',sans-serif">
          SpindleLab<span class="text-[#C9A227]">.</span>
        </p>
        <p class="mt-4 text-sm text-[#9FB2A0] leading-relaxed max-w-xs">
          SEO técnico y visibilidad en motores de IA (AEO/GEO) para empresas B2B y financieras en Chile.
        </p>
      </div>

      {
        COLUMNAS.map((col) => (
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-[0.15em] text-[#85AB8B] mb-4">
              {col.titulo}
            </h4>
            <ul class="flex flex-col gap-2.5">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="text-sm text-[#C7D2C6] hover:text-white transition-colors">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-[0.15em] text-[#85AB8B] mb-4">Contacto</h4>
        <ul class="flex flex-col gap-2.5 text-sm text-[#C7D2C6]">
          <li class="flex items-center gap-2">
            <Icon name="mapPin" class="w-4 h-4 text-[#9FB2A0]" />
            Santiago, Chile
          </li>
          <li>
            <a href={CONTACTO} class="flex items-center gap-2 hover:text-white transition-colors">
              <Icon name="mail" class="w-4 h-4 text-[#9FB2A0]" />
              {EMAIL}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#9FB2A0]/70">
      <span>© 2026 SpindleLab. Todos los derechos reservados.</span>
      <span>SEO técnico · AEO/GEO · Chile</span>
    </div>
  </div>
</footer>
