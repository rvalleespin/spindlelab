---
import Icon from './Icon.astro';

// Cómo hacemos legible el rigor: qué se mide, de forma verificable. Nada inventado.
const PRUEBAS = [
  {
    icon: 'bot',
    titulo: 'Menciones en IA, medidas',
    desc: 'Registramos si ChatGPT, Gemini y Perplexity te nombran ante las preguntas que hacen tus clientes. Con fecha, no de memoria.',
  },
  {
    icon: 'lineChart',
    titulo: 'Antes y después',
    desc: 'Cada cambio parte de una línea base y se vuelve a medir. Reportamos si te recomiendan más, no métricas de vanidad.',
  },
  {
    icon: 'scanSearch',
    titulo: 'Lo ves tú primero',
    desc: 'El diagnóstico inicial es tuyo antes de pagar nada: qué te frena hoy y qué mueve la aguja, en una página.',
  },
];
---

<section
  id="evidencia"
  class="relative overflow-hidden bg-bg border-t border-white/10 py-24 md:py-32 px-4 sm:px-6 scroll-mt-20"
>
  <video
    data-lazyvideo
    class="absolute inset-0 w-full h-full object-cover"
    src="/video/evidencia-oficina.mp4"
    poster="/video/evidencia-oficina.jpg"
    muted
    loop
    playsinline
    preload="none"></video>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:linear-gradient(to bottom, rgba(14,20,27,0.88) 0%, rgba(14,20,27,0.80) 42%, rgba(14,20,27,0.84) 70%, rgba(14,20,27,0.94) 100%)"
  >
  </div>
  <div class="relative z-10 max-w-6xl mx-auto">
    <div data-reveal class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-support mb-4">Evidencia</p>
      <h2 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] text-fg" style="letter-spacing:-0.03em">
        Mostramos, no prometemos<span class="text-gold">.</span>
      </h2>
      <p class="mt-6 text-fg-muted text-base md:text-lg leading-relaxed max-w-xl">
        No pedimos que nos creas. Así medimos tu visibilidad en IA, de forma que puedas verificarlo tú
        mismo desde el primer día.
      </p>
    </div>

    <div class="mt-12 md:mt-16 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        PRUEBAS.map((p, i) => (
          <div data-reveal style={`transition-delay:${i * 90}ms`}>
            <div class="h-full rounded-2xl border border-white/10 bg-surface p-6 md:p-7">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-support/10 text-support mb-5">
                <Icon name={p.icon} class="w-5 h-5" />
              </span>
              <h3 class="font-display text-lg font-semibold text-fg mb-2.5">{p.titulo}</h3>
              <p class="text-sm text-fg-muted leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Slot reservado para el primer caso real con datos (cuando haya permiso del cliente) -->
    <div data-reveal style="transition-delay:120ms">
      <div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-5 rounded-2xl border border-dashed border-white/15 bg-surface px-6 py-5 md:px-7">
        <span class="flex items-center justify-center w-10 h-10 shrink-0 rounded-xl bg-support/10 text-support">
          <Icon name="sparkles" class="w-5 h-5" />
        </span>
        <p class="text-sm text-fg-muted leading-relaxed">
          <span class="font-semibold text-fg">Caso real con datos, en camino.</span>
          Publicaremos aquí el primero con cifras en cuanto un cliente nos dé permiso. Hasta
          entonces, no verás testimonios ni resultados inventados.
        </p>
      </div>
    </div>
  </div>
</section>
