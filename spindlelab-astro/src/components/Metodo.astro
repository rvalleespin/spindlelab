---
const PASOS = [
  {
    n: '01',
    titulo: 'Diagnóstico técnico',
    desc: 'Auditamos tu sitio en profundidad: rastreo, indexación, velocidad y datos estructurados.',
  },
  {
    n: '02',
    titulo: 'Estrategia AEO/GEO',
    desc: 'Diseñamos la hoja de ruta para que los modelos de IA te citen y recomienden.',
  },
  {
    n: '03',
    titulo: 'Implementación',
    desc: 'Ejecutamos los cambios técnicos y de contenido en conjunto con tu equipo.',
  },
  {
    n: '04',
    titulo: 'Monitoreo',
    desc: 'Medimos menciones en IA, posiciones clásicas y tráfico orgánico quincenalmente.',
  },
];
---

<section id="metodo" class="relative bg-bg py-24 md:py-32 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-support mb-4">Método Spindle</p>
      <h2 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] text-fg" style="letter-spacing:-0.03em">
        Cuatro pasos. Resultados medibles.
      </h2>
    </div>

    <div class="mt-12 md:mt-16 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        PASOS.map((p, i) => (
          <div data-reveal style={`transition-delay:${i * 90}ms`}>
            <div class="h-full rounded-2xl border border-white/10 bg-surface p-6 md:p-7">
              <div class={`font-display text-4xl md:text-5xl font-semibold mb-5 ${p.n === '01' ? 'text-gold' : 'text-fg-muted'}`} style="letter-spacing:-0.03em">
                {p.n}
              </div>
              <h3 class="font-display text-lg font-semibold text-fg mb-2.5">{p.titulo}</h3>
              <p class="text-sm text-fg-muted leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
