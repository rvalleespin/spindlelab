---
import Icon from './Icon.astro';
import { CONTACTO } from '../consts';

// El motor de adquisición: el filo (Visibilidad SEO+IA) va destacado arriba;
// las otras 3 piezas conectadas van en la fila de abajo.
const PIEZAS = [
  {
    icon: 'users',
    titulo: 'Gestión de redes sociales',
    desc: 'Presencia, comunidad y pauta social en LinkedIn y Meta: aparece y conversa donde tu cliente ya pasa el día. El diseño y el video los sumamos con partners.',
    href: '/servicios/redes-sociales/',
  },
  {
    icon: 'target',
    titulo: 'Paid media (Google)',
    desc: 'Google Ads optimizado con IA: captura a quien ya está buscando lo que ofreces, con el presupuesto bajo control.',
    href: '/servicios/paid-media/',
  },
  {
    icon: 'code',
    titulo: 'Desarrollo web',
    desc: 'La base donde todo aterriza. Sitios a medida con panel de administración y SEO técnico desde el primer commit.',
    href: '/servicios/desarrollo-web/',
    id: 'desarrollo-web',
  },
];

const CIFRAS = [
  { valor: '24 h', label: 'Entrega del diagnóstico inicial' },
  { valor: '1 sitio', label: 'Para ser la referencia en tu nicho' },
  { valor: '20 min', label: 'Reunión de alineación estratégica' },
  { valor: '4 piezas', label: 'Un motor de adquisición conectado' },
];
---

<section id="servicios" class="relative overflow-hidden bg-surface-2 py-24 md:py-32 px-4 sm:px-6 scroll-mt-20">
  <video
    data-lazyvideo
    class="absolute inset-0 w-full h-full object-cover"
    src="/video/servicios-oficina.mp4"
    poster="/video/servicios-oficina.jpg"
    muted
    loop
    playsinline
    preload="none"></video>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:linear-gradient(to bottom, rgba(19,26,34,0.86) 0%, rgba(19,26,34,0.78) 42%, rgba(19,26,34,0.82) 70%, rgba(19,26,34,0.93) 100%)"
  >
  </div>
  <div class="relative z-10 max-w-6xl mx-auto">
    <div data-reveal class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-support mb-4">
        Motor de adquisición digital
      </p>
      <h2 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] text-fg" style="letter-spacing:-0.03em">
        Cuatro piezas conectadas. Un solo motor.
      </h2>
      <p class="mt-5 text-fg-muted text-[15px] md:text-base leading-relaxed">
        Somos una agencia de marketing con IA. Nuestro eje principal es el SEO técnico, la visibilidad
        en motores de IA y el desarrollo web. Completamos la ruta con Google y Meta Ads para que tu
        negocio sea aún más relevante. El contenido creativo lo entregas tú y nosotros lo hacemos
        funcionar.
      </p>
    </div>

    <!-- El filo: pieza destacada -->
    <div data-reveal class="mt-12 md:mt-14">
      <div class="rounded-2xl border border-support/40 bg-support/[0.07] p-7 md:p-9">
        <div class="flex items-center gap-3 mb-4">
          <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-support/12 text-support">
            <Icon name="scanSearch" class="w-5 h-5" />
          </span>
          <span class="text-[10px] font-semibold uppercase tracking-wider text-bg bg-support rounded-full px-2.5 py-1">
            El filo del motor
          </span>
        </div>
        <h3 class="font-display text-xl md:text-2xl font-semibold text-fg" style="letter-spacing:-0.02em">
          Visibilidad: SEO técnico + IA (AEO/GEO)
        </h3>
        <p class="mt-3 text-sm md:text-[15px] text-fg-muted leading-relaxed max-w-2xl">
          Que te encuentren en Google y en las respuestas de ChatGPT, Gemini y Perplexity. Es donde
          ganamos la pelea, y la puerta de entrada al resto del motor. Tres formas de trabajarla,
          según tu momento.
        </p>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2.5 text-sm font-semibold">
          <a href="/servicios/auditoria-seo-tecnica/" class="text-support hover:text-support/80 transition-colors">Auditoría SEO Técnica →</a>
          <a href="/servicios/visibilidad-en-ia/" class="text-support hover:text-support/80 transition-colors">Visibilidad en IA →</a>
          <a href="/servicios/acompanamiento-mensual/" class="text-support hover:text-support/80 transition-colors">Acompañamiento mensual →</a>
        </div>
      </div>
    </div>

    <!-- Las otras 3 piezas del motor -->
    <div class="mt-5 grid sm:grid-cols-3 gap-5">
      {
        PIEZAS.map((p, i) => (
          <div data-reveal id={p.id} class="scroll-mt-24" style={`transition-delay:${i * 90}ms`}>
            <a
              href={p.href}
              class="group flex h-full flex-col rounded-2xl border border-white/10 bg-surface p-6 md:p-7 transition-colors duration-300 hover:border-support/40 hover:bg-white/[0.05]"
            >
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-support/12 text-support mb-5">
                <Icon name={p.icon} class="w-5 h-5" />
              </span>
              <h3 class="font-display text-lg font-semibold text-fg mb-2.5">{p.titulo}</h3>
              <p class="text-sm text-fg-muted leading-relaxed flex-1">{p.desc}</p>
              <span class="mt-4 text-sm font-semibold text-support">Ver detalle →</span>
            </a>
          </div>
        ))
      }
    </div>

    <div data-reveal style="transition-delay:120ms">
      <div class="mt-12 md:mt-14 grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-6 rounded-2xl border border-white/10 bg-bg/60 px-6 py-8 md:py-10">
        {
          CIFRAS.map((c) => (
            <div class="text-center">
              <div
                class:list={[
                  'text-2xl md:text-3xl font-display font-semibold',
                  c.valor === '1 sitio' ? 'text-gold' : 'text-fg',
                ]}
                style="letter-spacing:-0.02em"
              >
                {c.valor}
              </div>
              <div class="mt-1.5 text-xs text-fg-muted leading-snug max-w-[18ch] mx-auto">
                {c.label}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Fuera de la cartera: el contenido creativo va con partners -->
    <div data-reveal style="transition-delay:150ms">
      <div class="mt-6 flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-5 rounded-2xl border border-white/10 bg-white/[0.02] px-6 py-5 md:px-7">
        <span class="flex items-center justify-center w-10 h-10 shrink-0 rounded-xl bg-white/[0.05] text-fg-muted">
          <Icon name="sparkles" class="w-5 h-5" />
        </span>
        <div class="flex-1">
          <p class="text-sm font-semibold text-fg">El contenido creativo va por separado, y está bien.</p>
          <p class="text-sm text-fg-muted leading-relaxed mt-1">
            Las piezas gráficas y el video no entran en el motor: los coordinamos con partners cuando
            los necesitas. Nosotros orquestamos la máquina de adquisición; tú sumas la creatividad sin
            multiplicar interlocutores.
          </p>
        </div>
        <a
          href="/servicios/"
          class="shrink-0 text-sm font-semibold text-support hover:text-support/80 transition-colors"
        >
          Ver el motor completo →
        </a>
      </div>
    </div>
  </div>
</section>
