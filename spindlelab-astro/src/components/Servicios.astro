---
import Icon from './Icon.astro';

// Las cuatro soluciones con su precio de partida publicado (siempre "desde" y más IVA).
// Los precios salen de las páginas de cada servicio: si cambian allá, cambian acá.
const SOLUCIONES = [
  {
    icon: 'scanSearch',
    titulo: 'Búsqueda y visibilidad en IA',
    desc: 'Revisamos si Google y las IA pueden leer tu sitio y entender a qué te dedicas, y te dejamos un plan ordenado por impacto. Que la IA pueda leerlo es el requisito para que un asistente como ChatGPT te entienda; no garantiza que te nombre.',
    precio: 'Desde $400.000 + IVA.',
    links: [
      { label: 'Auditoría SEO técnica', href: '/servicios/auditoria-seo-tecnica/' },
      { label: 'Visibilidad en IA', href: '/servicios/visibilidad-en-ia/' },
    ],
  },
  {
    icon: 'target',
    titulo: 'Anuncios en Google y redes',
    desc: 'Anuncios para quien ya está buscando lo que vendes, y gestión de redes con calendario, pauta y reporte.',
    precio:
      'Google Ads desde $350.000 al mes + IVA; redes desde $390.000 al mes + IVA. La inversión en pauta va aparte.',
    links: [
      { label: 'Paid media (Google)', href: '/servicios/paid-media/' },
      { label: 'Gestión de redes', href: '/servicios/redes-sociales/' },
    ],
  },
  {
    icon: 'code',
    titulo: 'Sitio web a medida',
    desc: 'Con panel para que edites tú y SEO técnico desde el diseño. Desde una página de campaña hasta un sitio de doce páginas.',
    precio: 'Desde $390.000 + IVA.',
    links: [{ label: 'Desarrollo web', href: '/servicios/desarrollo-web/' }],
    id: 'desarrollo-web',
  },
  {
    icon: 'lineChart',
    titulo: 'Acompañamiento mensual',
    desc: 'Implementación y medición cada mes, con informe y reunión. Para quien ya hizo la primera parte y quiere sostenerla.',
    precio: 'Desde $590.000 al mes + IVA.',
    links: [{ label: 'Acompañamiento mensual', href: '/servicios/acompanamiento-mensual/' }],
  },
];
---

<section id="servicios" class="relative overflow-hidden bg-surface-2 py-24 md:py-32 px-4 sm:px-6 scroll-mt-20">
  <video
    data-lazyvideo
    class="absolute inset-0 w-full h-full object-cover"
    src="/video/servicios-oficina.mp4"
    poster="/video/servicios-oficina.jpg"
    muted
    loop
    playsinline
    preload="none"></video>
  <div
    class="absolute inset-0 pointer-events-none"
    style="background:linear-gradient(to bottom, rgba(19,26,34,0.86) 0%, rgba(19,26,34,0.78) 42%, rgba(19,26,34,0.82) 70%, rgba(19,26,34,0.93) 100%)"
  >
  </div>
  <div class="relative z-10 max-w-6xl mx-auto">
    <div data-reveal class="max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-support mb-4">
        Soluciones
      </p>
      <h2 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] text-balance text-fg" style="letter-spacing:-0.03em">
        Lo que podemos hacer por ti
      </h2>
      <p class="mt-5 text-fg-muted text-[15px] md:text-base leading-relaxed">
        Cada solución tiene su página, con lo que incluye y su precio de partida (más IVA).
      </p>
    </div>

    <div class="mt-12 md:mt-14 grid sm:grid-cols-2 gap-5">
      {
        SOLUCIONES.map((s, i) => (
          <div data-reveal id={s.id} class="scroll-mt-24" style={`transition-delay:${i * 90}ms`}>
            <div class="flex h-full flex-col rounded-2xl border border-white/10 bg-surface p-6 md:p-7">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-support/10 text-support mb-5">
                <Icon name={s.icon} class="w-5 h-5" />
              </span>
              <h3 class="font-display text-xl font-semibold text-fg mb-2.5" style="letter-spacing:-0.02em">{s.titulo}</h3>
              <p class="text-sm text-fg-muted leading-relaxed">{s.desc}</p>
              <p class="mt-4 text-sm font-semibold text-fg leading-relaxed flex-1">{s.precio}</p>
              <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2.5 text-sm font-semibold">
                {s.links.map((l) => (
                  <a href={l.href} class="text-support hover:text-support/80 transition-colors">
                    {l.label} →
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
