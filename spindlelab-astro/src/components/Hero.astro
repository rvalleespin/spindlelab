---
import Icon from './Icon.astro';
import { CONTACTO } from '../consts';
---

<section id="top" class="relative w-full min-h-screen overflow-hidden bg-bg flex flex-col">
  <video
    id="hero-video"
    class="absolute inset-0 z-0 w-full h-full object-cover"
    src="/hero-hilo-de-oro.mp4"
    poster="/video/hero-hilo-de-oro.jpg"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"></video>

  <!-- Velo oscuro para legibilidad -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none"
    style="background:linear-gradient(to bottom, rgba(14,20,27,0.74) 0%, rgba(14,20,27,0.38) 26%, rgba(14,20,27,0.38) 54%, rgba(14,20,27,0.92) 100%)"
  >
  </div>

  <!-- Texto del hero -->
  <div class="relative z-10 flex flex-col items-center text-center pt-28 sm:pt-32 md:pt-36 px-4 sm:px-6">
    <h1
      class="font-display font-normal leading-[0.95] text-fg text-[2rem] sm:text-4xl md:text-5xl lg:text-[4.75rem] xl:text-[5.25rem] max-w-5xl"
      style="letter-spacing:-0.035em"
    >
      No compites solo en Google.{' '}
      <span class="text-fg">
        Compites en las<br class="hidden sm:block" /> respuestas de la <span class="text-gold">IA</span>.
      </span>
    </h1>
    <p class="mt-6 sm:mt-8 text-fg-muted text-sm sm:text-base md:text-lg leading-relaxed max-w-md px-2">
      SEO técnico y visibilidad en IA para que los motores te recomienden antes que a tu competencia.
    </p>
    <p class="mt-4 text-fg-faint text-xs sm:text-sm font-medium tracking-wide">
      Optimizamos para ChatGPT · Gemini · Perplexity · Google SGE
    </p>
  </div>

  <!-- Espaciador flexible: empuja la barra inferior al fondo sin solaparse con el título -->
  <div class="relative z-10 flex-1 min-h-[2rem]"></div>

  <!-- Barra inferior en flujo: CTA (izq) + método (der) -->
  <div class="relative z-10 px-4 sm:px-6 md:px-10 pb-6 sm:pb-8 md:pb-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <!-- Bloque CTA -->
      <div class="max-w-sm">
        <div class="flex items-center gap-2 text-fg mb-3">
          <Icon name="sparkles" />
          <span class="text-sm font-semibold">Diagnóstico en 24 h</span>
        </div>
        <p class="text-fg-muted text-xs leading-relaxed mb-6 max-w-xs">
          Revisamos tu sitio, tu competencia y tu presencia en IA, y te entregamos en una página qué te
          frena y qué mueve la aguja. Sin costo, sin compromiso.
        </p>
        <div class="flex items-center gap-4 flex-wrap">
          <a
            href={CONTACTO}
            class="bg-paper hover:bg-white text-bg text-sm font-semibold px-5 sm:px-6 py-2.5 sm:py-3 rounded-full transition-colors shadow-sm"
          >
            Agenda tu diagnóstico
          </a>
          <a href="#servicios" class="text-fg-muted text-sm font-semibold hover:text-fg transition-colors">
            Ver soluciones
          </a>
        </div>
      </div>

      <!-- Enlace al método -->
      <a
        href="#metodo"
        class="hidden sm:flex items-center gap-2 text-fg-muted text-sm hover:text-fg transition-colors"
      >
        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-white/10 backdrop-blur-sm hover:bg-white/15 transition-colors">
          <Icon name="play" class="w-3 h-3 ml-0.5" fill="currentColor" />
        </span>
        <span class="font-medium">Método SpindleLab</span>
        <span class="text-fg-faint">4 pasos</span>
      </a>
    </div>
  </div>
</section>

<script>
  const v = document.getElementById('hero-video') as HTMLVideoElement | null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection && (navigator as any).connection.saveData === true;
  if (v && (reduceMotion || saveData)) {
    // Modo Bajo Consumo / Ahorro de Datos: solo el poster, cero descarga del mp4.
    v.removeAttribute('autoplay');
    v.preload = 'none';
  } else if (v) {
    v.muted = true;
    let started = false;
    const cleanup = () => {
      v.removeEventListener('canplay', start);
      window.removeEventListener('pointerdown', start);
      window.removeEventListener('keydown', start);
      window.removeEventListener('touchstart', start);
      window.removeEventListener('scroll', start);
    };
    function start() {
      if (started || !v) return;
      v.play()
        .then(() => {
          started = true;
          cleanup();
        })
        .catch(() => {});
    }
    start();
    v.addEventListener('canplay', start);
    window.addEventListener('pointerdown', start);
    window.addEventListener('keydown', start);
    window.addEventListener('touchstart', start, { passive: true });
    window.addEventListener('scroll', start, { passive: true });
  }
</script>
