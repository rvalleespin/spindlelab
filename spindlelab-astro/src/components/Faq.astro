---
// FAQ de nivel-marca en el home: define la entidad y responde en formato citable
// (el home es la primera URL que fetchea un motor de IA). Texto visible en el DOM + FAQPage.
const FAQS = [
  {
    q: '¿Qué es SpindleLab?',
    a: 'SpindleLab es una consultoría chilena de SEO técnico y visibilidad en motores de IA (AEO/GEO). Ayudamos a empresas B2B y de sectores donde la confianza pesa —finanzas, salud, legal— a que Google y los buscadores de IA como ChatGPT, Gemini y Perplexity las encuentren, las entiendan y las recomienden.',
  },
  {
    q: '¿Qué es AEO/GEO y en qué se diferencia del SEO tradicional?',
    a: 'El SEO clásico busca que rankees en la lista de resultados de Google. AEO/GEO (optimización para motores de respuesta y generativos) busca que la IA te cite como fuente cuando alguien pregunta. Son dos juegos distintos: rankear primero en Google no te mete en la respuesta de ChatGPT.',
  },
  {
    q: '¿Cómo miden si la IA te recomienda?',
    a: 'Con un protocolo repetible: hacemos las preguntas que haría tu cliente en los principales motores de IA y registramos, con fecha, si apareces, cómo te describen y a quién citan. Medimos antes y después, para que lo verifiques tú, no de memoria.',
  },
  {
    q: '¿Para qué tipo de empresas trabajan?',
    a: 'Nos enfocamos en sectores donde la confianza es crítica (finanzas, salud, legal, B2B), porque ahí las exigencias de autoridad (E-E-A-T) son mayores y es donde más movemos la aguja. Si tu rubro es otro, el diagnóstico gratis nos dirá si podemos ayudarte.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://spindlelab.cl/#faq',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="relative bg-bg border-t border-white/10 py-24 md:py-32 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-3xl mx-auto">
    <div data-reveal class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-support mb-4">Preguntas frecuentes</p>
      <h2 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] text-fg" style="letter-spacing:-0.03em">
        Lo esencial, en claro.
      </h2>
    </div>

    <div class="mt-10 flex flex-col gap-3">
      {
        FAQS.map((f) => (
          <details data-reveal class="group rounded-2xl border border-white/10 bg-surface px-6 py-5 md:px-7">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none text-base md:text-lg font-semibold text-fg">
              {f.q}
              <span class="shrink-0 text-support text-2xl leading-none transition-transform duration-300 group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-sm md:text-[15px] text-fg-muted leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
</section>
