---
// FAQ de la home: cinco preguntas, en formato citable (el home es la primera URL que fetchea
// un motor de IA). Texto visible en el DOM + FAQPage generado de este mismo arreglo, así que
// el JSON-LD y lo que se ve no pueden diferir.
const FAQS = [
  {
    q: '¿Cuánto cuesta?',
    a: 'Cada solución publica su precio de partida, con lo que incluye, más IVA. Por ejemplo, desde $350.000 al mes la gestión de Google Ads, desde $390.000 una página web, desde $490.000 una auditoría SEO y desde $590.000 al mes el acompañamiento. La revisión de una página es gratis.',
  },
  {
    q: '¿Qué necesitan de mí para partir?',
    a: 'La dirección de tu sitio. Si avanzamos, te vamos a pedir acceso de lectura a tu analítica y a Search Console, y para implementar, un acceso acotado a tu sitio. Si hay que mirar tu proceso de ventas, también cómo registras las consultas y cuántas se cierran.',
  },
  {
    q: '¿Y si el problema no es mi sitio?',
    a: 'Entonces te lo decimos. La revisión puede mostrar que tu sitio está en orden, y en ese caso la conversación de 20 minutos sirve para ver dónde mirar.',
  },
  {
    q: '¿Prometen resultados?',
    a: 'No. Lo que dejamos por escrito es el método, los entregables y los plazos. Lo que responde una IA o lo que decide un cliente no lo controla nadie.',
  },
  {
    q: '¿Hay contrato de permanencia?',
    a: 'Un proyecto se paga por fases. El acompañamiento mensual tiene un mínimo de 3 meses y después sigue mes a mes, con aviso de 30 días.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://spindlelab.cl/#faq',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="relative bg-bg border-t border-white/10 py-24 md:py-32 px-4 sm:px-6 scroll-mt-20">
  <div class="max-w-3xl mx-auto">
    <div data-reveal class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-support mb-4">Preguntas frecuentes</p>
      <h2 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.05] text-balance text-fg" style="letter-spacing:-0.03em">
        Lo esencial, en claro.
      </h2>
    </div>

    <div class="mt-10 flex flex-col gap-3">
      {
        FAQS.map((f) => (
          <details data-reveal class="group rounded-2xl border border-white/10 bg-surface px-6 py-5 md:px-7">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none text-base md:text-lg font-semibold text-fg">
              {f.q}
              <span class="shrink-0 text-support text-2xl leading-none transition-transform duration-300 group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-3 text-sm md:text-[15px] text-fg-muted leading-relaxed">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
</section>
