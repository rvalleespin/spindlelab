---
// UN VIDEO DE A (spec §3.1 y §3.5): la imagen quieta abajo y el <video> encima, con su pausa.
//   · Dos fuentes, el mismo contenido: VP9/WebM primero y H.264/MP4 después, para Safari (§3.5.1).
//   · muted, loop, playsinline, preload="none", sin controls ni autoplay en el HTML, aria-hidden (§3.1.1, §3.5.2).
//   · Lo arranca video.mjs, solo a la vista y sin movimiento reducido ni ahorro de datos; se pausa fuera de la vista.
//   · La imagen quieta es el póster (el primer cuadro): es lo primero que se pinta y lo único que queda sin JS. Su alt
//     es la descripción del video (Clara la escribe en «medios»); vacío si es un ambiente sin información (la portada).
//   · `fuentes` (la portada, §3.1.2): las fuentes se eligen por el ancho al cargar, [{ desde: 834, webm, mp4 }, { webm, mp4 }].
// Los techos de peso (§3.5.5) y las reglas de qué video va dónde (§3.3) los cumple quien lo usa.
import Pausa from './Pausa.astro';
interface Fuente {
  desde?: number;
  webm: string;
  mp4: string;
}
interface Props {
  poster: string;
  ancho: number;
  alto: number;
  webm?: string;
  mp4?: string;
  fuentes?: Fuente[];
  /** Clase de la proporción del marco (p-169, p-45…) u otras del sistema. */
  clase?: string;
  /** A sangre, sin radio (§1.5): la portada, la cinta y el medio principal del caso bajo 834. */
  sangre?: boolean;
  descripcion?: string;
  /** La pausa arriba a la derecha (la portada) y no abajo (§3.1.3). */
  pausaArriba?: boolean;
  /** En la primera pantalla: la imagen quieta se pide de entrada y con prioridad (candidata a LCP, §3.1). */
  primeraPantalla?: boolean;
}
const {
  poster, ancho, alto, webm, mp4, fuentes, clase, sangre = false, descripcion = '', pausaArriba = false,
  primeraPantalla = false,
} = Astro.props;
---
<div class:list={['medio', 'video', clase, { 'medio--sangre': sangre }]} data-video data-fuentes={fuentes ? JSON.stringify(fuentes) : undefined}>
  <img class="video__quieta" src={poster} alt={descripcion} width={ancho} height={alto} loading={primeraPantalla ? 'eager' : 'lazy'} fetchpriority={primeraPantalla ? 'high' : undefined} decoding="async" />
  <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
    {!fuentes && webm && <source src={webm} type="video/webm" />}
    {!fuentes && mp4 && <source src={mp4} type="video/mp4" />}
  </video>
  <Pausa arriba={pausaArriba} />
</div>

<script>
  import '../../scripts/archivo/video.mjs';
</script>
