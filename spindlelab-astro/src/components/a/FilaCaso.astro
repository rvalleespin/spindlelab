---
// UNA FILA DE MEDIOS DEL CASO (spec §2.3; lock §21.2): solo las cuatro formas de Koto (una 16:9; par 4:5 | 4:5; 4:5 |
// dos 1,62 apilados; dos 1,62 apilados | 4:5) y el hueco nombrado de Praxi (§3.3), con el pie de Clara debajo de la
// fila. `entrada`: la fila entra a la vista una vez con el resorte «entrada» (§1.6: una por sección). Tanda 3.
import MedioCaso from './MedioCaso.astro';
import Icono from './Icono.astro';

interface Props {
  fila: { forma: string; medios: any[]; pie: string; enlace?: { texto: string; destino: string } | null };
  hueco?: string;
  entrada?: boolean;
}
const { fila: f, hueco = '', entrada = false } = Astro.props;
const e = entrada ? '' : undefined;
---
{f.forma === 'hueco' ? (
  <div class="fila fila--hueco" data-entrada={e}>
    <div class="hueco p-169"><p class="chico">{hueco}</p></div>
  </div>
) : (
  <figure class:list={['fila', `fila--${f.forma}`]} data-entrada={e}>
    <div class="fila__medios">
      {f.forma === '169' && <MedioCaso medio={f.medios[0]} clase="p-169" />}
      {f.forma === 'par' && <><MedioCaso medio={f.medios[0]} clase="p-45" /><MedioCaso medio={f.medios[1]} clase="p-45" /></>}
      {f.forma === '45-162' && <><MedioCaso medio={f.medios[0]} clase="p-45" /><div class="pila"><MedioCaso medio={f.medios[1]} /><MedioCaso medio={f.medios[2]} /></div></>}
      {f.forma === '162-45' && <><div class="pila"><MedioCaso medio={f.medios[0]} /><MedioCaso medio={f.medios[1]} /></div><MedioCaso medio={f.medios[2]} clase="p-45" /></>}
    </div>
    {(f.pie || f.enlace) && (
      <figcaption class="pie">
        {f.pie}
        {f.enlace && <> <a class="subrayado" href={f.enlace.destino}>{f.enlace.texto}<Icono nombre="fuera" /></a></>}
      </figcaption>
    )}
  </figure>
)}
