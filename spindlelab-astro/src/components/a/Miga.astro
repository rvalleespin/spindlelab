---
// LA MIGA DE A (spec §2, «Lo común», 5): mono 11, separada por «·», la actual en blanco; su BreadcrumbList (Simón,
// senales-obra.md) dice lo mismo. Como la miga del v3 anterior: nav con nombre («Miga de pan»), lista ordenada, el
// último eslabón es la página actual (aria-current, sin enlace) y el separador va con aria-hidden.
//   <Miga items={[{ texto: 'Inicio', href: '/v3/' }, { texto: 'Trabajo', href: '/v3/trabajo/' }, { texto: 'Praxi' }]} />
interface Eslabon {
  texto: string;
  href?: string;
}
interface Props {
  items: Eslabon[];
}
const { items } = Astro.props;
const ultimo = items.length - 1;
---
<nav class="miga rotulo" aria-label="Miga de pan">
  <ol>{items.map((e, i) => <li>{i > 0 && <span class="miga__sep" aria-hidden="true">·</span>}{i === ultimo ? <span aria-current="page">{e.texto}</span> : <a href={e.href}>{e.texto}</a>}</li>)}</ol>
</nav>
