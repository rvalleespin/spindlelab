---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Agencia de marketing con IA en Chile · SpindleLab',
  description = 'Auditamos tu sitio y tu presencia en IA para que ChatGPT, Gemini y Perplexity te recomienden antes que tu competencia. Diagnóstico gratis en 24 horas.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': 'https://spindlelab.cl/#org',
      name: 'SpindleLab',
      url: 'https://spindlelab.cl/',
      logo: 'https://spindlelab.cl/assets/img/favicon-512.png',
      email: 'hola@spindlelab.cl',
      description:
        'SEO técnico, visibilidad en motores de IA (AEO/GEO) y desarrollo web a medida para empresas B2B y financieras en Chile.',
      areaServed: { '@type': 'Country', name: 'Chile' },
      address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
      knowsAbout: [
        'SEO técnico',
        'AEO',
        'GEO',
        'Visibilidad en IA',
        'E-E-A-T',
        'Datos estructurados',
        'Desarrollo web a medida',
      ],
      sameAs: [
        'https://www.linkedin.com/company/spindlelab/',
        'https://www.instagram.com/spindle.lab/',
      ],
      founder: { '@id': 'https://spindlelab.cl/#autor-ramon' },
      makesOffer: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', '@id': 'https://spindlelab.cl/servicios/auditoria-seo-tecnica/#service', name: 'Auditoría SEO Técnica' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', '@id': 'https://spindlelab.cl/servicios/visibilidad-en-ia/#service', name: 'Visibilidad en IA (AEO/GEO)' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', '@id': 'https://spindlelab.cl/servicios/acompanamiento-mensual/#service', name: 'Acompañamiento Mensual' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', '@id': 'https://spindlelab.cl/servicios/redes-sociales/#service', name: 'Gestión de Redes Sociales' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', '@id': 'https://spindlelab.cl/servicios/paid-media/#service', name: 'Paid Media (Google)' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', '@id': 'https://spindlelab.cl/servicios/desarrollo-web/#service', name: 'Desarrollo Web' } },
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://spindlelab.cl/#website',
      url: 'https://spindlelab.cl/',
      name: 'SpindleLab',
      inLanguage: 'es-CL',
      publisher: { '@id': 'https://spindlelab.cl/#org' },
    },
    {
      '@type': 'Person',
      '@id': 'https://spindlelab.cl/#autor-ramon',
      name: 'Ramón Vallejos',
      jobTitle: 'Consultor de SEO técnico y visibilidad en IA (AEO/GEO)',
      image: 'https://spindlelab.cl/assets/img/ramon-vallejos.jpg',
      url: 'https://spindlelab.cl/nosotros/',
      worksFor: { '@id': 'https://spindlelab.cl/#org' },
      knowsAbout: ['SEO técnico', 'AEO', 'GEO', 'Visibilidad en motores de IA', 'Datos estructurados', 'E-E-A-T'],
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Universidad de Barcelona' },
        { '@type': 'CollegeOrUniversity', name: 'Universidad Andrés Bello' },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />

    <!-- Google tag (gtag.js): NO se carga hasta que haya consentimiento. Hasta el 22-sep se
         cargaba siempre, con Consent Mode en denegado, y así igual le mandaba a Google un aviso
         sin cookies de cada página vista a quien había dicho que no (medido en la red). Ahora el
         archivo se pide recién cuando la persona acepta: __spindlelabInitGA, que también llama
         /js/consent-banner.js al pulsar Aceptar. La función gtag() se define igual aunque no
         haga nada, porque hay código que la llama directo (el generate_lead de /contacto/), y
         sin ella lanzaría un error justo después de un envío exitoso. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var __spindlelabConsent = (function(){
        try { return localStorage.getItem('spindlelab_consent'); } catch(e){ return null; }
      })();
      function __spindlelabInitGA(){
        if (window.__spindlelabGAInited) return;
        window.__spindlelabGAInited = true;
        // Lo que se haya encolado antes del permiso (un generate_lead, un chequeo_completado)
        // se descarta: nada de lo que pasó antes de aceptar se manda después de aceptar.
        window.dataLayer.length = 0;
        gtag('consent', 'default', {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted'
        });
        gtag('js', new Date());
        gtag('config', 'G-J40VW9E0TW');
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-J40VW9E0TW';
        document.head.appendChild(s);
      }
      if (__spindlelabConsent === 'granted') { __spindlelabInitGA(); }
    </script>

    <!-- Meta Pixel Code — no tiene consent mode propio, así que no se inicializa hasta
         que haya consentimiento. Sin noscript: no se puede pedir consentimiento sin
         JavaScript, así que tampoco se rastrea sin JavaScript. -->
    <script is:inline>
      function __spindlelabInitMeta() {
        if (window.__spindlelabMetaInited) return;
        window.__spindlelabMetaInited = true;
        (function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '2885353628478565');
        fbq('track', 'PageView');
      }
      if (__spindlelabConsent === 'granted') {
        __spindlelabInitMeta();
      }
    </script>
    <!-- End Meta Pixel Code -->

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0E141B" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SpindleLab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://spindlelab.cl/assets/img/og-marca.jpg?v=4" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="SpindleLab. SEO técnico y visibilidad en IA" />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg?v=4" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Inter alojada en el sitio (ver /fonts/inter.css): antes venía de Google Fonts, que
         recibía la IP de cada visitante en cada página, aceptara o no las cookies. -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/inter.css?v=1" />
  </head>
  <body class="bg-bg">
    <slot />

    <!-- Reveal al hacer scroll (con red de seguridad). -->
    <script>
      const els = document.querySelectorAll('[data-reveal]');
      const reveal = (el: Element) => el.classList.add('is-visible');
      if (!('IntersectionObserver' in window)) {
        els.forEach(reveal);
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                reveal(e.target);
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => {
          io.observe(el);
          // Red de seguridad: nunca dejar contenido oculto si IO no dispara.
          window.setTimeout(() => reveal(el), 2500);
        });
      }
    </script>

    <!-- Videos de sección: reproducir solo en pantalla (carga diferida). -->
    <script>
      const lazyVids = document.querySelectorAll('video[data-lazyvideo]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const small = window.matchMedia('(max-width: 680px)').matches;
      const saveData = (navigator as any).connection && (navigator as any).connection.saveData === true;
      const blockVideo = reduce || small || saveData;
      if (lazyVids.length && !blockVideo && 'IntersectionObserver' in window) {
        const vio = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              const v = e.target as HTMLVideoElement;
              if (e.isIntersecting) {
                v.play().catch(() => {});
              } else {
                v.pause();
              }
            });
          },
          { threshold: 0.25 }
        );
        lazyVids.forEach((v) => vio.observe(v));
      }
    </script>

    <div id="cookie-banner" hidden>
      <style>
        #cookie-banner{position:fixed;left:0;right:0;bottom:0;z-index:999;background:#161D26;border-top:1px solid rgba(247,245,240,.12);padding:18px 20px}
        #cookie-banner .cb-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
        #cookie-banner p{margin:0;font-size:13.5px;color:rgba(242,239,232,.72);line-height:1.5;max-width:640px;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
        #cookie-banner a{color:#2FA99B;font-weight:600}
        #cookie-banner .cb-actions{display:flex;gap:10px;flex:none}
        #cookie-banner button{font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.04em;padding:10px 20px;border-radius:999px;cursor:pointer;border:1.5px solid transparent}
        #cookie-reject{background:transparent;color:#F2EFE8;border-color:rgba(247,245,240,.35)}
        #cookie-reject:hover{background:rgba(247,245,240,.08)}
        #cookie-accept{background:#F4F6F3;color:#12201A;border-color:#F4F6F3}
        #cookie-accept:hover{background:#FFFFFF}
        #cookie-banner[hidden]{display:none}
        @media(max-width:680px){#cookie-banner .cb-inner{flex-direction:column;align-items:stretch}#cookie-banner .cb-actions{justify-content:flex-end}}
      </style>
      <div class="cb-inner">
        <p>Usamos Google Analytics y Meta Pixel para entender cómo se usa este sitio. Puedes aceptarlos o rechazarlos. Más detalle en la <a href="/privacidad/">política de privacidad</a>.</p>
        <div class="cb-actions">
          <button type="button" id="cookie-reject">Rechazar</button>
          <button type="button" id="cookie-accept">Aceptar</button>
        </div>
      </div>
    </div>
    <script is:inline src="/js/consent-banner.js?v=3" defer></script>
  </body>
</html>
