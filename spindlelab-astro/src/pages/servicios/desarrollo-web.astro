---
// DESARROLLO WEB SOBRE A · ARCHIVO (obra E12, corrida 2, tanda 4). Diego, 19-oct-2026.
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md §2.4 (la plantilla interior y su fila de Desarrollo
// web) y §3.4 (la franja es Combeau fotografía, no Doceavo: nunca un campo). Implementación de referencia: la vista 5 del
// prototipo (tableros/e12-direcciones/proto/a/servicios/desarrollo-web/); donde difieren, manda la spec. Lo que la spec
// no cubría está en spindlelab-v3/desvios.md, tanda 4.
//
// En orden: cabecera; franja; «En todos los planes» (lista); «Lo que construimos» (dos portadas 4:5 en c5 a c16, con el
// círculo del cursor); el glosario y los cuatro planes; «Cinco fases» (la fase a la vista pasa del gris al blanco:
// fases.mjs); preguntas; cierre con «Siguiente».
//
// El texto es de Clara, tal cual (src/data/archivo/texto/desarrollo-web.json). Los planes salen tal cual de
// oferta-v3.json (momentos[0].planes: nombre, precio, línea y puntos), comparados con la lista de Clara; las dos piezas,
// de las entradas de /trabajo/ (trabajo.json); los medios, de medios.json. Todo monto a la vista se compara con los JSON
// (servicios.mjs). Las señales son de Simón, e12/senales-obra.md §2.7: el grafo de hoy queda (Service con su
// OfferCatalog de cuatro planes y minPrice en CLP sin IVA, BreadcrumbList igual a la miga y FAQPage con las preguntas a
// la vista); la description del Service pasa a ser la de la página.
import Layout from '../../layouts/Layout.astro';
import PaginaA from '../../components/a/PaginaA.astro';
import Miga from '../../components/a/Miga.astro';
import Imagen from '../../components/a/Imagen.astro';
import Pieza from '../../components/a/Pieza.astro';
import Icono from '../../components/a/Icono.astro';
import { LAYOUT_A } from '../../components/a/layout-a';
import { textoDe, igualQue, contiene } from '../../data/archivo/texto.mjs';
import { SITIO, trozos, siguiente, soloMontosDe, monto } from '../../data/archivo/servicios.mjs';
import comun from '../../data/archivo/texto/comun.json';
import dw from '../../data/archivo/texto/desarrollo-web.json';
import trabajo from '../../data/archivo/texto/trabajo.json';
import medios from '../../data/archivo/medios.json';
import oferta from '../../data/oferta-v3.json';

const t = textoDe(dw, comun);
const pagina = dw.texto;
const m = medios.medios;
const dos = (id: string) => t(id) as { tinta: string; gris: string };
const RUTA = '/servicios/desarrollo-web/';

// ---- Cabecera
const miga = t('dw.miga').opciones as string[];
igualQue(miga.join(' · '), 'Inicio · Soluciones · Desarrollo web', 'desarrollo web, la miga');
const entradilla = t('dw.entradilla');
soloMontosDe(entradilla.texto, 'desarrollo-web', 'desarrollo web, la entradilla');
const trozosEntradilla = trozos(entradilla.texto, entradilla.enlaces);
const bPlanes = t('dw.boton.planes');
const bEscribir = t('dw.boton.escribir');
// «#planes» suelto no: todo enlace interno a un id va con su ruta (spec §5.2.2)
const aPlanes = bPlanes.destino.startsWith('#') ? `${RUTA}${bPlanes.destino}` : bPlanes.destino;

// ---- La franja (§2.4, §3.4): Combeau fotografía, recortada al centro; su alt, el de Clara para la franja. Debajo, el
// nombre de la pieza y su línea, los de su entrada de /trabajo/ (como el pie de la franja del prototipo).
const entradas = trabajo.texto.entradas as { id: string; nombre: string; bajada: string; linea: string; destino: string; cursor: string; pie?: string }[];
const entrada = (id: string) => {
  const e = entradas.find((x) => x.id === id);
  if (!e) throw new Error(`desarrollo web: la entrada «${id}» no está en trabajo.entradas`);
  return e;
};
const franja = { medio: m['combeau-fotografia-169'], alt: t('dw.franja.alt').texto, pieza: entrada('combeau-fotografia') };

// ---- En todos los planes
const incluye = ['1', '2', '3', '4', '6', '7'].map((n) => {
  const e = t(`dw.incluye.${n}`);
  return trozos(e.texto, e.enlaces);
});

// ---- Lo que construimos (obra E13): las dos entradas que quedan en /trabajo/, Combeau y Verifica y Cumple, con su destino
// de A. Verifica y Cumple es un sitio aparte: lleva la flecha ↗, el aviso para el lector de pantalla y el pie de la persona
// generada con IA, como en el muro.
const obra = [
  { id: 'combeau-fotografia', medio: m['combeau-fotografia-45'] },
  { id: 'verifica-y-cumple', medio: m['verifica-y-cumple-45'] },
].map((p) => ({ ...p, e: entrada(p.id) }));
const refObra = t('dw.obra.entradas').texto;
for (const p of obra) contiene(refObra, p.e.destino, `desarrollo web, destino de «${p.e.nombre}»`);
const bObra = t('dw.obra.boton');
const externo = t('comun.externo').texto as string;

// ---- Planes: tal cual de oferta-v3.json, comparados con la lista de Clara
const planes = oferta.momentos[0].planes;
const listaPlanes = t('dw.planes.lista').texto;
for (const p of planes) contiene(listaPlanes, `${p.n} · ${p.p}`, `desarrollo web, el plan «${p.n}»`);
const glosario = (t('dw.planes.glosario').items as string[]).map((x) => {
  const i = x.indexOf(': ');
  if (i < 0) throw new Error(`desarrollo web: el glosario no tiene «término: definición» en «${x}»`);
  return { termino: x.slice(0, i + 1), def: x.slice(i + 2) };
});

// ---- Cinco fases: «01 · Descubrimiento». El número es el de la lista ordenada: va con aria-hidden
const fases = [1, 2, 3, 4, 5].map((n) => {
  const e = t(`dw.fase.${n}`);
  const r = e.rotulo as string;
  const i = r.indexOf(' · ');
  return { numero: r.slice(0, i + 3), nombre: r.slice(i + 3), texto: e.texto };
});

// ---- Preguntas
const preguntas = [1, 2, 3, 4, 5].map((n) => ({ p: t(`dw.faq.${n}.p`).texto, r: t(`dw.faq.${n}.r`).texto }));
soloMontosDe(preguntas.map((q) => q.r).join(' '), 'desarrollo-web', 'desarrollo web, las preguntas');

// ---- Cierre y «Siguiente» (el de Clara, que es el que sigue en el orden de servicios.mjs). La flecha del texto de
// Clara («Visibilidad en IA →») es la flecha SVG: ninguna de las dos letras la trae (spec §1.2)
const c1 = t('dw.cierre.boton1');
const c2 = t('dw.cierre.boton2');
const sig = t('dw.siguiente');
const sigNombre = (sig.texto as string).replace(/\s*→$/, '');
igualQue(sigNombre, siguiente('desarrollo-web').nombre, 'desarrollo web, «Siguiente»');
igualQue(sig.destino, siguiente('desarrollo-web').href, 'desarrollo web, destino de «Siguiente»');

// ---- Señales (Simón, senales-obra.md §2.7)
const title = pagina.title;
const description = pagina.description;
if (title.length > 60 || description.length < 120 || description.length > 160) {
  throw new Error(`desarrollo web: title (${title.length}) o description (${description.length}) fuera de los largos de senales-obra.md §1.2`);
}
const url = `${SITIO}/servicios/desarrollo-web/`;
// Las cuatro ofertas del grafo de hoy, con su descripción de hoy; el nombre y el minPrice, de oferta-v3.json
const OFERTAS = [
  'Una página a medida pensada para una campaña y una oferta, con SEO técnico y medición desde el primer día. Entrega en ~1 semana.',
  'Home y hasta 5 páginas, SEO técnico base, un idioma. Entrega en ~3 semanas.',
  'Home y hasta 12 páginas, blog/CMS, SEO técnico y puesta a punto AEO/GEO. Entrega en ~4 a 6 semanas.',
  'Todo lo del Sitio Completo y más: páginas sin tope, integraciones a medida, arquitectura propia, multi-idioma. Se cotiza tras una reunión.',
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name: 'Desarrollo Web',
      serviceType: 'Desarrollo web a medida',
      description,
      provider: { '@id': `${SITIO}/#org` },
      areaServed: { '@type': 'Country', name: 'Chile' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Planes de Desarrollo Web',
        itemListElement: planes.map((p, i) => {
          const min = monto(p.p);
          return {
            '@type': 'Offer',
            name: p.n,
            description: OFERTAS[i],
            ...(min ? { priceSpecification: { '@type': 'PriceSpecification', minPrice: min, priceCurrency: 'CLP', valueAddedTaxIncluded: false } } : {}),
          };
        }),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: miga[0], item: `${SITIO}/` },
        { '@type': 'ListItem', position: 2, name: miga[1], item: `${SITIO}/servicios/` },
        { '@type': 'ListItem', position: 3, name: miga[2] },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: preguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
    },
  ],
};
const og = { src: '/assets/img/og-e12-desarrollo-web.jpg?v=3', alt: `SpindleLab: ${dos('dw.h1').tinta} ${dos('dw.h1').gris}` };
---
<Layout title={title} description={description} ogImage={og.src} ogImageAlt={og.alt} {...LAYOUT_A}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <PaginaA>
    {/* 1 · CABECERA (§2.4.1) */}
    <section class="reticula int-cab" aria-labelledby="h-titulo">
      <Miga items={[{ texto: miga[0], href: '/' }, { texto: miga[1], href: '/servicios/' }, { texto: miga[2] }]} />
      <h1 class="t-declaracion" id="h-titulo"><span class="tinta">{dos('dw.h1').tinta}</span> <span class="gris">{dos('dw.h1').gris}</span></h1>
      <p class="cuerpo caja">{trozosEntradilla.map((p) => (p.href ? <a href={p.href}>{p.texto}</a> : p.texto))}</p>
      <div class="botones">
        <a class="boton boton--claro" href={aPlanes}>{bPlanes.texto}</a>
        <a class="boton boton--placa" href={bEscribir.destino}>{bEscribir.texto}<Icono nombre="flecha" /></a>
      </div>
    </section>

    {/* 2 · LA FRANJA (§2.4.2, §3.4): Combeau fotografía a 2,39 desde 834 y 16:9 bajo 834, recortada al centro */}
    <figure class="reticula franja" data-entrada>
      <Imagen src={franja.medio.src} alt={franja.alt} ancho={franja.medio.ancho} alto={franja.medio.alto} primeraPantalla />
      <figcaption class="pie"><span class="tinta">{franja.pieza.nombre}</span> <span class="rotulo">· {franja.pieza.linea}</span></figcaption>
    </figure>

    {/* 3 · EN TODOS LOS PLANES (lista, c5 a c12) */}
    <section class="seccion reticula" aria-labelledby="h-incluye">
      <div class="int-sec__cab">
        <h2 class="t-declaracion" id="h-incluye"><span class="tinta">{dos('dw.incluye.h2').tinta}</span> <span class="gris">{dos('dw.incluye.h2').gris}</span></h2>
      </div>
      <ul class="int-sec__cuerpo int-lista">
        {incluye.map((tz) => <li><p class="cuerpo">{tz.map((p) => (p.href ? <a href={p.href}>{p.texto}</a> : p.texto))}</p></li>)}
      </ul>
    </section>

    {/* 4 · LO QUE CONSTRUIMOS: dos portadas 4:5 en c5 a c16, con el círculo del cursor (§4.2) */}
    <section class="seccion reticula" aria-labelledby="h-obra">
      <div class="int-sec__cab">
        <h2 class="t-declaracion" id="h-obra"><span class="tinta">{dos('dw.obra.h2').tinta}</span> <span class="gris">{dos('dw.obra.h2').gris}</span></h2>
      </div>
      <div class="int-sec__cuerpo int-sec__cuerpo--ancho">
        <div class="obra3">
          {obra.map((p, i) => (
            <Pieza id={`o-${p.id}`} nombre={p.e.nombre} bajada={p.e.bajada} linea={p.e.linea} destino={p.e.destino} cursor={p.e.cursor} medio={p.medio} forma="p-45" pie={p.e.pie} externo={externo} entrada={i === 0} />
          ))}
        </div>
        <div class="obra3__pie">
          <a class="boton boton--placa" href={bObra.destino}>{bObra.texto}<Icono nombre="flecha" /></a>
        </div>
      </div>
    </section>

    {/* 5 · PLANES (c5 a c16): el glosario antes de los planes (Clara), los cuatro planes y la nota */}
    <section class="seccion reticula" id="planes" aria-labelledby="h-planes">
      <div class="int-sec__cab">
        <h2 class="t-declaracion" id="h-planes"><span class="tinta">{dos('dw.planes.h2').tinta}</span> <span class="gris">{dos('dw.planes.h2').gris}</span></h2>
      </div>
      <div class="int-sec__cuerpo int-sec__cuerpo--ancho">
        <div class="glosario">
          <p class="rotulo glosario__rot">{t('dw.planes.glosario.rotulo').texto}</p>
          <ul class="glosario__lista">
            {glosario.map((g) => <li class="chico"><span class="tinta">{g.termino}</span> {g.def}</li>)}
          </ul>
        </div>
        {planes.map((p) => (
          <article class="plan">
            <div><h3>{p.n}</h3><p class="cuerpo plan__precio">{p.p}</p></div>
            <p class="cuerpo">{p.d}</p>
            <ul>{p.puntos.map((x) => <li>{x}</li>)}</ul>
          </article>
        ))}
        <div class="planes__pie">
          <p class="chico">{t('dw.planes.nota').texto}</p>
        </div>
      </div>
    </section>

    {/* 6 · CINCO FASES (c5 a c12): la fase a la vista pasa del gris al blanco en 167 ms (fases.mjs) */}
    <section class="seccion reticula" aria-labelledby="h-fases">
      <div class="int-sec__cab">
        <h2 class="t-declaracion" id="h-fases"><span class="tinta">{dos('dw.fases.h2').tinta}</span> <span class="gris">{dos('dw.fases.h2').gris}</span></h2>
      </div>
      <ol class="int-sec__cuerpo fases--vista">
        {fases.map((f) => (
          <li class="fase">
            <p class="t-fase t-display"><span aria-hidden="true">{f.numero}</span>{f.nombre}</p>
            <p class="cuerpo">{f.texto}</p>
          </li>
        ))}
      </ol>
    </section>

    {/* 7 · PREGUNTAS (c5 a c12) */}
    <section class="seccion reticula" aria-labelledby="h-faq">
      <div class="int-sec__cab">
        <h2 class="t-declaracion" id="h-faq">{t('dw.faq.h2').texto}</h2>
      </div>
      <div class="int-sec__cuerpo">
        {preguntas.map((q) => (
          <div class="pregunta"><h3>{q.p}</h3><p class="cuerpo">{q.r}</p></div>
        ))}
      </div>
    </section>

    {/* 8 · CIERRE (§2.4.4) y «Siguiente» */}
    <section class="seccion reticula" aria-labelledby="h-cierre">
      <div class="cierre">
        <h2 class="t-declaracion" id="h-cierre"><span class="tinta">{dos('dw.cierre.h2').tinta}</span> <span class="gris">{dos('dw.cierre.h2').gris}</span></h2>
        <p class="cuerpo">{t('dw.cierre.p').texto}</p>
        <div class="botones">
          <a class="boton boton--claro" href={c1.destino}>{c1.texto}<Icono nombre="flecha" /></a>
          <a class="boton boton--placa" href={c2.destino}>{c2.texto}</a>
        </div>
        <div class="int-siguiente">
          <p class="rotulo">{sig.rotulo}</p>
          <a class="t-titulo t-display subrayado" href={sig.destino}>{sigNombre}<Icono nombre="flecha" /></a>
        </div>
      </div>
    </section>
  </PaginaA>
</Layout>

<script>
  import '../../scripts/archivo/fases.mjs';
</script>
