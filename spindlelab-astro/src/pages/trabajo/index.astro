---
// ÍNDICE DE TRABAJO DE A · ARCHIVO (obra E12, corrida 2, tanda 2; recortado en la obra E13). Diego.
//
// La URL no cambia: /trabajo/ pasó de src/pages/v3/trabajo.astro (la página de driftime, que A reemplaza) a
// una carpeta, para que los casos vivan al lado (/trabajo/<caso>/); desde el corte a la raíz (E13), en src/pages/trabajo/.
//
// Contrato: spec-visual.md §2.2 (adónde lleva cada entrada), §3.3 (las portadas) y §4; desde E14, el trabajo fijo del
// prototipo de la home aprobado por Ramón (e14-home-koto/prototipo/).
//
// E13 (brief §1, decisión 3): el índice queda con dos entradas, el sitio de Combeau (un caso, con página) y Verifica y
// Cumple (una pieza propia que enlaza a verifica.spindlelab.cl). Salieron Praxi, los cuatro conceptos, el chequeo y
// spindlelab.cl. Con dos entradas el filtro (Cliente 1, Propio 1) no filtra nada y se sacó, como recomendó Clara
// (desvios/home.md, §3.8): quedan sin lector trabajo.filtro y trabajo.filtro.nombre.
//
// El texto es de Clara, tal cual (trabajo.json: el h1, la entradilla, el conteo y las dos entradas con su bajada, su línea
// mono y su destino). El conteo sale de las entradas y el build se cae si no dice lo mismo que el texto de Clara. Las
// señales, de Simón (senales-obra.md §2.2): CollectionPage + ItemList + BreadcrumbList; el ItemList sigue el orden del
// muro y cada entrada va con su url (la de Verifica y Cumple, externa).
//
// E14 (2-nov-2026): el muro dejó paso al trabajo fijo de la home; ver el comentario «E14» más abajo.
// E16 (3-nov-2026, Ramón): Verifica y Cumple tiene página de caso (/trabajo/verifica-y-cumple/) y su entrada lleva ahí, con
// una sola tarjeta (el spot); el JSON-LD la lista con esa url, interna.
import Layout from '../../layouts/Layout.astro';
import PaginaA from '../../components/a/PaginaA.astro';
import TrabajoFijo from '../../components/a/TrabajoFijo.astro';
import Miga from '../../components/a/Miga.astro';
import { LAYOUT_A } from '../../components/a/layout-a';
import { textoDe, igualQue, medioDe } from '../../data/archivo/texto.mjs';
import caso from '../../data/archivo/texto/caso-combeau.json';
import comun from '../../data/archivo/texto/comun.json';
import trabajo from '../../data/archivo/texto/trabajo.json';

const t = textoDe(trabajo, comun);
const pagina = trabajo.texto;
const externo = t('comun.externo').texto;

// E14 (2-nov): el muro de dos columnas pasa al trabajo fijo de la home (TrabajoFijo.astro, el mecanismo medido en Koto):
// el panel fijo con la miga, el h1, el conteo y la entradilla arriba, y abajo el nombre de la pieza activa, que cambia por
// máscara, con su bajada; a la derecha las tarjetas, la activa al 100 % y el resto al 20 %; bajo 834, una lista en 4:5.
// Las mismas tres tarjetas que la home (el recorrido de Combeau en video, su book y Verifica y Cumple con su pie); el texto
// de cada pieza es el de su entrada en trabajo.json, tal cual. desvios-construccion.md (E14).
type Entrada = { id: string; nombre: string; bajada: string; linea: string; destino: string; cursor: string; pie?: string; pie_video?: string; descripcion_video?: string };
const entradas = pagina.entradas as Entrada[];
const V = '/v3/trabajo/combeau/combeau-fotografia-recorrido';
const S = '/v3/trabajo/verifica/verifica-spot2';
const TARJETAS: Record<string, unknown[]> = {
  'combeau-fotografia': [
    {
      ancha: { src: `${V}-1440-poster.webp`, ancho: 1440, alto: 810, chica: { src: `${V}-960-poster.webp`, ancho: 960 } },
      angosta: { src: `${V}-390-poster.webp`, ancho: 780, alto: 1688 },
      video: { ancho: { webm: `${V}-1440.webm`, mp4: `${V}-1440.mp4` }, angosto: { webm: `${V}-390.webm`, mp4: `${V}-390.mp4` } },
    },
    {
      ancha: { src: '/v3/trabajo/combeau/combeau-modelo-169.webp', ancho: 1600, alto: 900, chica: { src: '/v3/trabajo/combeau/combeau-modelo-960.webp', ancho: 960 } },
      angosta: { src: '/v3/medios/combeau-modelo-45.webp', ancho: 780, alto: 975 },
      alt: (medioDe(caso, 'combeau-modelo-169.webp') as { alt: string }).alt,
    },
  ],
  'verifica-y-cumple': [
    // el spot (Ramón, 2-nov), con su pie (pie_video de trabajo.json); E16 (Ramón, 3-nov): la única tarjeta, la portada salió
    {
      ancha: { src: `${S}-1280-poster.webp`, ancho: 1280, alto: 720, chica: { src: `${S}-960-poster.webp`, ancho: 960 } },
      angosta: { src: `${S}-390-poster.webp`, ancho: 624, alto: 780 },
      video: { ancho: { webm: `${S}-1280.webm`, mp4: `${S}-1280.mp4` }, angosto: { webm: `${S}-390.webm`, mp4: `${S}-390.mp4` } },
    },
  ],
};
const piezas = entradas.map((e) => {
  const tarjetas = TARJETAS[e.id] as { pie?: string }[] | undefined;
  if (!tarjetas) throw new Error(`/trabajo/: la entrada «${e.id}» no tiene tarjetas`);
  // el pie del spot (Verifica y Cumple), bajo su tarjeta. E16: sin la portada, «pie» (el de la portada) ya no va aquí;
  // lo sigue leyendo /servicios/desarrollo-web/, que muestra la portada.
  if (e.pie_video) tarjetas[0].pie = e.pie_video;
  return { id: e.id, nombre: e.nombre, ficha: e.linea, texto: e.bajada, descripcion: e.descripcion_video, enlace: { texto: e.cursor, destino: e.destino }, tarjetas };
});
const conteo = t('trabajo.conteo').texto;
// El conteo (spec §2.2; Clara: «sale del dato»): el total, igual al texto de Clara.
igualQue(conteo, `(${entradas.length})`, '/trabajo/, el conteo del título');

// ---- Señales (Simón, senales-obra.md §2.2)
const title = pagina.title;
const description = pagina.description;
if (title.length > 60 || description.length < 120 || description.length > 160) {
  throw new Error(`/trabajo/: title (${title.length}) o description (${description.length}) fuera de los largos de senales-obra.md §1.2`);
}
const URL_FINAL = 'https://spindlelab.cl/trabajo/';
// La URL final (sin /) de adonde lleva cada entrada; la de fuera (Verifica y Cumple), tal cual.
const final = (d: string) => (/^https?:/.test(d) ? d : `https://spindlelab.cl${d.replace(/^\/\//, '/')}`);
// El nombre del ListItem (Simón): Combeau con su nombre completo (la entrada dice «Combeau»).
const nombreLista = (e: Entrada) => (e.id.startsWith('combeau-') ? `Bernardo ${e.nombre}` : e.nombre);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${URL_FINAL}#collectionpage`,
      url: URL_FINAL,
      name: title,
      description,
      inLanguage: 'es-CL',
      isPartOf: { '@id': 'https://spindlelab.cl/#website' },
      breadcrumb: { '@id': `${URL_FINAL}#breadcrumb` },
      mainEntity: { '@id': `${URL_FINAL}#itemlist` },
    },
    {
      '@type': 'ItemList',
      '@id': `${URL_FINAL}#itemlist`,
      numberOfItems: entradas.length,
      itemListElement: entradas.map((e, i) => ({ '@type': 'ListItem', position: i + 1, name: nombreLista(e), url: final(e.destino) })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${URL_FINAL}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://spindlelab.cl/' },
        { '@type': 'ListItem', position: 2, name: 'Trabajo', item: URL_FINAL },
      ],
    },
  ],
};
const h1 = t('trabajo.h1') as { tinta: string; gris: string };
const miga = (t('trabajo.miga').texto as string).split(' · ');
---
<Layout title={title} description={description} ogImage="/assets/img/og-e12-trabajo.jpg?v=3" ogImageAlt="Dos piezas de SpindleLab: la portada del sitio de un fotógrafo, en luz verde, y «Las 12 cosas que tu sitio tiene que dejar publicadas», de Verifica y Cumple, en blanco sobre azul." {...LAYOUT_A}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <PaginaA>
    <TrabajoFijo id="piezas" idTitulo="h-trabajo" piezas={piezas} arriba nivel="h2" externo={externo} primeraPantalla>
      <Fragment slot="cabeza">
        <Miga items={[{ texto: miga[0], href: '/' }, { texto: miga[1] }]} />
        <h1 class="t-declaracion" id="h-trabajo"><span class="tinta">{h1.tinta}</span> <span class="gris">{h1.gris}</span></h1>
        <p class="rotulo">{conteo}</p>
        <p class="chico">{t('trabajo.entradilla').texto}</p>
      </Fragment>
    </TrabajoFijo>
  </PaginaA>
</Layout>
