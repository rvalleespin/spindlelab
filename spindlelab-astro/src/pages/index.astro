---
// HOME DE A · COMPOSICIÓN KOTO (obra E14, 2-nov-2026, Diego). Antes: E13 (26 al 30-oct), en el historial de git.
//
// Contrato: el prototipo que aprobó Ramón el 2-nov («me gusta este acercamiento a la referencia… listo»),
// marketing/oficina/obras-web/spindlelab-v3/e14-home-koto/prototipo/ (Lucía), con el mecanismo medido en Koto
// (e14-home-koto/medicion-koto-scroll.md), el texto de Clara (e13/texto/home.json; qué id va dónde,
// e14-home-koto/texto-construccion.md), las imágenes de Bruno (e14-home-koto/plan-imagenes.md §7) y la comparación de
// Javiera (e14-home-koto/comparacion-koto.md). Lo que no es como el prototipo: e14-home-koto/desvios-construccion.md.
//
// En orden: portada (el hilo de oro se recoge al bajar) y la línea (sube renglón a renglón) → trabajo fijo (Combeau y
// Verifica y Cumple; TrabajoFijo.astro) → banda Sitio web a medida → banda Búsqueda y visibilidad en IA → fila de tres
// (anuncios, acompañamiento, cómo partimos) → contacto en filas, con quién responde. Sin preguntas frecuentes: el FAQPage
// sale del JSON-LD (home.json «senales»).
//
// Todo el texto sale de los JSON de Clara; los precios y los nombres de servicio, de oferta-v3.json y servicios-v3.json, y
// el build se cae si no son iguales, como texto, a los de Clara. El movimiento: home.mjs y trabajo-fijo.mjs, apagados con
// prefers-reduced-motion.
//
// Las clases de la portada (.portada-v, .portada-v__medio, .portada-v__pie) son las que miden las herramientas de
// portada de E12 (portada.mjs y contraste-portada.py): no se cambian sin cambiar esas dos.
import Layout from '../layouts/Layout.astro';
import PaginaA from '../components/a/PaginaA.astro';
import Video from '../components/a/Video.astro';
import Icono from '../components/a/Icono.astro';
import TrabajoFijo from '../components/a/TrabajoFijo.astro';
import { LAYOUT_A } from '../components/a/layout-a';
import { textoDe, igualQue, medioDe } from '../data/archivo/texto.mjs';
import comun from '../data/archivo/texto/comun.json';
import home from '../data/archivo/texto/home.json';
import trabajo from '../data/archivo/texto/trabajo.json';
import medios from '../data/archivo/medios.json';
import oferta from '../data/oferta-v3.json';
import servicios from '../data/servicios-v3.json';

const t = textoDe(home, comun);
const pagina = home.texto;
const m = medios.medios;
const dos = (id: string) => t(id) as { tinta: string; gris?: string };
const tx = (id: string) => t(id).texto as string;
const externo = tx('comun.externo');
type Medio = { archivo: string; alt?: string; pie?: string; descripcion?: string; columna?: string };
const medio = (archivo: string) => medioDe(home, archivo) as Medio;

// ---- 1 · Portada (igual que en E13)
const boton = t('home.portada.boton');
const secundario = t('home.portada.secundario');

// ---- Precios y enlaces: los nombres de servicio, los destinos y los precios salen de los JSON y se comparan, como texto,
// con los de Clara (texto-construccion.md §4 a §6): un dato que no coincida hace caer el build.
const sv = servicios as Record<string, { secciones: { planes?: { precio: string }[] }[] }>;
const precioDe = (slug: string, i: number) => sv[slug].secciones.find((s) => Array.isArray(s.planes))!.planes![i].precio;
const FILAS = [...oferta.momentos.flatMap((mo) => mo.items), ...oferta.tambien];
const enlaceDe = (slug: string, idBoton: string) => {
  const it = FILAS.find((f) => f.href.split('/').filter(Boolean).pop() === slug);
  if (!it) throw new Error(`home: «${slug}» no está en oferta-v3.json`);
  const b = t(idBoton);
  igualQue(`Ver ${it.n}`, b.texto, `home, el botón de ${slug}`);
  igualQue(it.href, b.destino, `home, el destino de ${slug}`);
  return { nombre: it.n as string, href: it.href as string, texto: b.texto as string };
};
const dw = enlaceDe('desarrollo-web', 'home.sitio.boton');
const via = enlaceDe('visibilidad-en-ia', 'home.busqueda.via.boton');
const aud = enlaceDe('auditoria-seo-tecnica', 'home.busqueda.aud.boton');
const paid = enlaceDe('paid-media', 'home.anuncios.paid.boton');
const redes = enlaceDe('redes-sociales', 'home.anuncios.redes.boton');
const aco = enlaceDe('acompanamiento-mensual', 'home.acompanamiento.boton');
const precioSitio = igualQue(oferta.momentos[0].planes[0].p, tx('home.sitio.precio'), 'home, el precio de Sitio web a medida');
const precioBusqueda = igualQue(precioDe('visibilidad-en-ia', 0), tx('home.busqueda.precio'), 'home, el precio de Búsqueda y visibilidad en IA');
// Anuncios: la primera frase es el precio de Paid Media; el resto («La inversión en pauta va aparte.») va en gris
const precioAnuncios = tx('home.anuncios.precio');
const corteAnuncios = precioAnuncios.indexOf('. ');
igualQue(precioDe('paid-media', 0), corteAnuncios < 0 ? precioAnuncios : precioAnuncios.slice(0, corteAnuncios), 'home, el precio de Paid Media');
const anunciosPrecio = corteAnuncios < 0 ? { a: precioAnuncios, b: '' } : { a: precioAnuncios.slice(0, corteAnuncios + 1), b: precioAnuncios.slice(corteAnuncios + 2) };
const precioAco = igualQue(precioDe('acompanamiento-mensual', 0), tx('home.acompanamiento.precio'), 'home, el precio del Acompañamiento mensual');
igualQue(aco.nombre, dos('home.acompanamiento.h2').tinta, 'home, el nombre del Acompañamiento mensual');
const partimos = t('home.partimos.boton');

// ---- 3 · Trabajo: dos piezas, tres tarjetas (el recorrido de Combeau en video, su book y Verifica y Cumple)
const recorrido = medio('combeau-fotografia-recorrido-1440.webm');
const modelo = medio('combeau-modelo-169.webp');
const verifica = medio('verifica-y-cumple-53.webp');
const spot = medio('verifica-spot-1280.webm');
const S = '/v3/trabajo/verifica/verifica-spot';
const V = '/v3/trabajo/combeau/combeau-fotografia-recorrido';
const piezas = [
  {
    id: 'combeau',
    nombre: tx('home.trabajo.combeau.nombre'),
    ficha: tx('home.trabajo.combeau.ficha'),
    texto: tx('home.trabajo.combeau.texto'),
    descripcion: recorrido.descripcion,
    enlace: { texto: tx('home.trabajo.combeau.boton'), destino: t('home.trabajo.combeau.boton').destino as string },
    tarjetas: [
      {
        ancha: { src: `${V}-1440-poster.webp`, ancho: 1440, alto: 810, chica: { src: `${V}-960-poster.webp`, ancho: 960 } },
        angosta: { src: `${V}-390-poster.webp`, ancho: 780, alto: 1688 },
        video: { ancho: { webm: `${V}-1440.webm`, mp4: `${V}-1440.mp4` }, angosto: { webm: `${V}-390.webm`, mp4: `${V}-390.mp4` } },
      },
      {
        ancha: { src: '/v3/trabajo/combeau/combeau-modelo-169.webp', ancho: 1600, alto: 900, chica: { src: '/v3/trabajo/combeau/combeau-modelo-960.webp', ancho: 960 } },
        angosta: { src: '/v3/medios/combeau-modelo-45.webp', ancho: 780, alto: 975 },
        alt: modelo.alt,
      },
    ],
  },
  {
    id: 'verifica',
    nombre: tx('home.trabajo.verifica.nombre'),
    ficha: tx('home.trabajo.verifica.ficha'),
    texto: tx('home.trabajo.verifica.texto'),
    aviso: tx('home.trabajo.verifica.aviso'),
    descripcion: spot.descripcion,
    enlace: { texto: tx('home.trabajo.verifica.boton'), destino: t('home.trabajo.verifica.boton').destino as string },
    tarjetas: [
      // el spot (idea de Ramón, 2-nov): el caballo a lápiz en un cuaderno toma color y sale galopando; la portada, después
      {
        ancha: { src: `${S}-1280-poster.webp`, ancho: 1280, alto: 720, chica: { src: `${S}-960-poster.webp`, ancho: 960 } },
        angosta: { src: `${S}-390-poster.webp`, ancho: 624, alto: 780 },
        video: { ancho: { webm: `${S}-1280.webm`, mp4: `${S}-1280.mp4` }, angosto: { webm: `${S}-390.webm`, mp4: `${S}-390.mp4` } },
        pie: tx(spot.pie as string),
      },
      {
        ancha: { src: m['verifica-y-cumple-53'].src, ancho: m['verifica-y-cumple-53'].ancho, alto: m['verifica-y-cumple-53'].alto },
        angosta: { src: m['verifica-y-cumple-45'].src, ancho: m['verifica-y-cumple-45'].ancho, alto: m['verifica-y-cumple-45'].alto },
        alt: verifica.alt,
        // obligatorio con la -53 y con la -45: en las dos se ve la persona a caballo (comparacion-koto.md §5.1)
        pie: tx(verifica.pie as string),
      },
    ],
  },
];
// «[ Todo el trabajo ] (2)»: el 2 es el conteo verdadero del índice de /trabajo/
const todo = t('home.trabajo.todo');
igualQue(todo.texto, `[ Todo el trabajo ] (${trabajo.texto.entradas.length})`, 'home, el corchete del trabajo');
const todoPartes = (todo.texto as string).match(/^\[ (.+) \] (\(\d+\))$/)!;

// ---- 4 y 5 · Las bandas grandes
const panel = medio('combeau-panel-colecciones-169.webp');
const chequeo = medio('chequeo-spindlelab-169.webp');
const chequeoEnlace = t('home.busqueda.chequeo');

// ---- 6 a 8 · La fila de tres: las imágenes de Bruno (plan-imagenes.md §7), 16:9 desde 834 y 4:5 bajo 834. El alt es el
// de Clara para cada columna, escrito mirando la -169 y la -45 (acta-qa-e14, defectos 1 y 2).
const fila = (pagina.secciones as { id: string; medios?: Medio[] }[]).find((s) => s.id === 'fila')!.medios!;
const altDe = (columna: string) => {
  const x = fila.find((f) => f.columna === columna);
  if (!x || !x.alt) throw new Error(`home, fila de tres: falta el alt de «${columna}»`);
  return x.alt;
};
const notas = [
  { k: 'anuncios', img: 'anuncios', precio: anunciosPrecio, enlaces: [paid, redes] },
  { k: 'acompanamiento', img: 'acompanamiento', precio: { a: precioAco, b: '' }, enlaces: [aco] },
  { k: 'partimos', img: 'como-partimos', precio: null, enlaces: [{ texto: partimos.texto as string, href: partimos.destino as string }] },
].map((n) => {
  const pie = fila.find((f) => f.columna === n.k)?.pie;
  return { ...n, h2: dos(`home.${n.k}.h2`), texto: tx(`home.${n.k}.texto`), alt: altDe(n.k), pie: pie ? tx(pie) : undefined };
});

// ---- 9 · Contacto
const quien = tx('home.contacto.quien.nombre');
const iQuien = quien.indexOf(' · ');
const correo = t('home.contacto.correo.direccion');
const ramon = medio('ramon-vallejos-34.webp');

// ---- Señales (Simón, home.json «senales»): title y description sin cambios; el FAQPage sale (ya no hay preguntas a la vista)
const title = pagina.title;
const description = pagina.description;
if (title.length > 60 || description.length < 120 || description.length > 160) {
  throw new Error(`home: title (${title.length}) o description (${description.length}) fuera de los largos de senales-obra.md §1.2`);
}
// datePublished es el de la portada publicada (2026-07-08); dateModified lo escribe el build, en la hora de Chile.
const PUBLICADA = '2026-07-08';
const construida = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Santiago', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
if (!/^\d{4}-\d{2}-\d{2}$/.test(construida) || construida < PUBLICADA) {
  throw new Error(`home: dateModified «${construida}» no es una fecha ISO posterior a datePublished (${PUBLICADA})`);
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://spindlelab.cl/#webpage',
      url: 'https://spindlelab.cl/',
      name: title,
      description,
      inLanguage: 'es-CL',
      isPartOf: { '@id': 'https://spindlelab.cl/#website' },
      about: { '@id': 'https://spindlelab.cl/#org' },
      datePublished: PUBLICADA,
      dateModified: construida,
    },
  ],
};
const og = { src: '/assets/img/og-e12-marca.jpg?v=3', alt: tx('home.portada.og-alt') };
// La imagen quieta de la portada: la de 1440 alcanza hasta 1440 de ancho a 1x (peso, desvios-construccion.md)
const POSTER_SRCSET = '/v3/portada/hilo-1440-poster.webp 1440w, /v3/portada/hilo-1920-poster.webp 1920w';
const SIZES_BANDA = '(min-width: 1194px) 62vw, (min-width: 834px) 58vw, calc(100vw - 32px)';
---
<Layout title={title} description={description} ogImage={og.src} ogImageAlt={og.alt} {...LAYOUT_A}>
  <link slot="head" rel="preload" as="image" href="/v3/portada/hilo-1920-poster.webp" imagesrcset={POSTER_SRCSET} imagesizes="100vw" fetchpriority="high" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <PaginaA>
    <script is:inline>if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('a-mov');</script>

    {/* 1 · PORTADA + 2 · LA LÍNEA. El escenario del hilo es pegajoso dentro de un fondo que cubre las dos: el texto sube por
         encima y, desde 834, entre el scroll 120 y una pantalla el video se recoge en una franja arriba (Koto §1). */}
    <section class="portada-v portada-v--recoge" aria-labelledby="portada-titulo">
      <div class="portada-v__fondo">
        <div class="portada-v__escenario">
          <Video
            clase="portada-v__medio"
            sangre
            pausaArriba
            primeraPantalla
            poster="/v3/portada/hilo-1920-poster.webp"
            posterSrcset={POSTER_SRCSET}
            posterSizes="100vw"
            ancho={1920}
            alto={1080}
            fuentes={[
              { desde: 834, webm: '/v3/portada/hilo-1920.webm', mp4: '/v3/portada/hilo-1920.mp4' },
              { webm: '/v3/portada/hilo-960.webm', mp4: '/v3/portada/hilo-960.mp4' },
            ]}
          />
        </div>
      </div>
      <div class="portada-v__pie">
        <div class="portada-v__decl">
          <p class="rotulo">{tx('home.portada.rotulo')}</p>
          <h1 class="t-portada" id="portada-titulo"><span class="tinta">{dos('home.portada.h1').tinta}</span> <span class="gris">{dos('home.portada.h1').gris}</span></h1>
          <p class="cuerpo entradilla">{tx('home.portada.entradilla')}</p>
        </div>
        <div class="portada-v__accion">
          <a class="boton boton--accion" id="portada-cta" href={boton.destino}>{boton.texto}<Icono nombre="flecha" /></a>
          <p class="chico">{tx('home.portada.microcopy')}</p>
          <p class="chico"><a href={secundario.destino}>{secundario.texto}</a></p>
        </div>
      </div>
      <div class="k-linea">
        <h2 class="t-declaracion k-linea__texto" data-lineas-scroll><span class="tinta">{dos('home.linea').tinta}</span> <span class="gris">{dos('home.linea').gris}</span></h2>
      </div>
    </section>

    {/* 3 · TRABAJO: el panel fijo con el nombre que cambia por máscara, la tarjeta encendida y el resto al 20 % (Koto §3) */}
    <TrabajoFijo id="trabajo" idTitulo="trabajo-h" piezas={piezas} nombreArriba aparece diferir externo={externo}>
      <h2 slot="cabeza" id="trabajo-h" class="t-declaracion"><span class="tinta">{dos('home.trabajo.rotulo').tinta}</span></h2>
      <a slot="final" class="k-tf__todo corchete" href={todo.destino}><span class="k-tf__corchetes"><span>[</span> {todoPartes[1]} <span>]</span></span>&nbsp;{todoPartes[2]}</a>
    </TrabajoFijo>

    {/* 4 · BANDA · SITIO WEB A MEDIDA. La imagen, el panel de Combeau de septiembre con su pie, hasta que Ramón decida. */}
    <section class="k-banda" aria-labelledby="b-sitio">
      <div class="k-banda__txt">
        <h2 id="b-sitio" class="t-siguiente"><span class="tinta">{dos('home.sitio.h2').tinta}</span> <span class="gris">{dos('home.sitio.h2').gris}</span></h2>
        <p class="cuerpo caja">{tx('home.sitio.texto')}</p>
        <p class="k-precio">{precioSitio}</p>
        <p class="chico"><a href={dw.href}>{dw.texto}</a></p>
      </div>
      <figure class="k-banda__medio" data-entra>
        <div class="medio p-169" data-entra-in>
          <img src="/v3/trabajo/combeau/combeau-panel-colecciones-169.webp" srcset="/v3/trabajo/combeau/combeau-panel-colecciones-169.webp 1600w" sizes={SIZES_BANDA} alt={panel.alt} width="1600" height="900" loading="lazy" decoding="async" />
        </div>
        <figcaption class="pie">{panel.pie}</figcaption>
      </figure>
    </section>

    {/* 5 · BANDA · BÚSQUEDA Y VISIBILIDAD EN IA. Un precio para el bloque; la captura real del chequeo de spindlelab.cl. */}
    <section class="k-banda" aria-labelledby="b-busqueda">
      <div class="k-banda__txt">
        <h2 id="b-busqueda" class="t-siguiente"><span class="tinta">{dos('home.busqueda.h2').tinta}</span> <span class="gris">{dos('home.busqueda.h2').gris}</span></h2>
        <p class="cuerpo caja">{tx('home.busqueda.texto')}</p>
        <p class="k-precio">{precioBusqueda}</p>
        <ul class="k-enlaces chico">
          <li><a href={via.href}>{via.texto}</a></li>
          <li><a href={aud.href}>{aud.texto}</a></li>
        </ul>
      </div>
      <figure class="k-banda__medio" data-entra>
        <div class="medio p-169" data-entra-in>
          <img src="/v3/medios/chequeo-spindlelab-169.webp" srcset="/v3/medios/chequeo-spindlelab-169.webp 1600w" sizes={SIZES_BANDA} alt={chequeo.alt} width="1600" height="900" loading="lazy" decoding="async" />
        </div>
        <figcaption class="pie">{tx('home.busqueda.pie')} · <a href={chequeoEnlace.destino}>{chequeoEnlace.texto}</a></figcaption>
      </figure>
    </section>

    {/* 6 a 8 · LA FILA DE TRES, como las noticias de Koto (§4): una grande y dos chicas, sin ningún efecto */}
    <section class="k-tres" aria-labelledby="h-anuncios">
      {notas.map((n, i) => (
        <article class="k-nota">
          <div class="medio k-nota__medio">
            <picture>
              <source media="(max-width: 833.98px)" srcset={`/v3/medios/e14-banda-${n.img}-45.webp 900w`} sizes="calc(100vw - 32px)" width="900" height="1125" />
              <img src={`/v3/medios/e14-banda-${n.img}-169.webp`} srcset={`/v3/medios/e14-banda-${n.img}-169.webp 1600w`} sizes={i === 0 ? '(min-width: 1194px) 44vw, 43vw' : '(min-width: 1194px) 28vw, 27vw'} alt={n.alt} width="1600" height="900" loading="lazy" decoding="async" />
            </picture>
          </div>
          {n.pie && <p class="pie">{n.pie}</p>}
          <h2 class="t-titulo" id={i === 0 ? 'h-anuncios' : undefined}><span class="tinta">{n.h2.tinta}</span> <span class="gris">{n.h2.gris}</span></h2>
          <p class="chico caja">{n.texto}</p>
          {n.precio && <p class="k-precio">{n.precio.a}{n.precio.b && <> <span class="gris">{n.precio.b}</span></>}</p>}
          <ul class="k-enlaces chico">
            {n.enlaces.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}
          </ul>
        </article>
      ))}
    </section>

    {/* 9 · CONTACTO, en filas como el de Koto (§5): las filas aparecen atadas al scroll y la foto de Ramón, donde Koto pone
         la del estudio, escala desde su esquina inferior izquierda al llegar. El botón es el claro (spec-visual §1.1). */}
    <section class="k-contacto" aria-labelledby="contacto-h">
      <div class="k-contacto__izq">
        <h2 id="contacto-h" class="t-declaracion"><span class="tinta">{dos('home.contacto.titulo').tinta}</span> <span class="gris">{dos('home.contacto.titulo').gris}</span></h2>
        <figure class="k-contacto__foto" data-foto>
          <div class="medio p-34"><img src={m['ramon-vallejos-34'].src} alt={ramon.alt} width={m['ramon-vallejos-34'].ancho} height={m['ramon-vallejos-34'].alto} loading="lazy" decoding="async" /></div>
        </figure>
      </div>
      <div class="k-contacto__filas">
        <div class="k-fila" data-fila><div class="k-fila__in">
          <p class="k-fila__rot chico">{tx('home.contacto.proyectos.rotulo')}</p>
          <div class="k-fila__cont">
            <p class="cuerpo"><span class="tinta">{tx('home.contacto.proyectos.texto')}</span></p>
            <a class="boton boton--claro" href={t('home.contacto.boton').destino}>{tx('home.contacto.boton')}<Icono nombre="flecha" /></a>
          </div>
        </div></div>
        <div class="k-fila" data-fila><div class="k-fila__in">
          <p class="k-fila__rot chico">{tx('home.contacto.correo.rotulo')}</p>
          <div class="k-fila__cont"><p class="cuerpo"><a href={correo.destino}>{correo.texto}</a></p></div>
        </div></div>
        <div class="k-fila" data-fila><div class="k-fila__in">
          <p class="k-fila__rot chico">{tx('home.contacto.quien.rotulo')}</p>
          <div class="k-fila__cont">
            <p class="cuerpo">{iQuien < 0 ? <span class="tinta">{quien}</span> : <><span class="tinta">{quien.slice(0, iQuien)}</span>{quien.slice(iQuien)}</>}</p>
            <p class="cuerpo caja">{tx('home.contacto.quien.p1')}</p>
            <p class="cuerpo caja">{tx('home.contacto.quien.p2')}</p>
