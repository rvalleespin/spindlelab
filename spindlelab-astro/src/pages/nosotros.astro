---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { CONTACTO } from '../consts';

const url = 'https://spindlelab.cl/nosotros/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${url}#aboutpage`,
      url,
      name: 'Nosotros · SpindleLab',
      description:
        'Detrás de SpindleLab está Ramón Vallejos. Marketing y crecimiento con IA, con evidencia antes que promesas. Revisión gratis de una página.',
      mainEntity: { '@id': 'https://spindlelab.cl/#autor-ramon' },
      about: { '@id': 'https://spindlelab.cl/#autor-ramon' },
      isPartOf: { '@id': 'https://spindlelab.cl/#website' },
    },
  ],
};

const PUNTOS = [
  {
    titulo: 'Empiezo por mirar',
    desc: 'Reviso tu sitio antes de cobrarte nada y te cuento lo que encontré.',
  },
  {
    titulo: 'Te digo qué se puede mover y qué no',
    desc: '',
  },
  {
    titulo: 'Lo dejo por escrito',
    desc: 'Alcance, fases, plazos y precio, antes de empezar.',
  },
];
---

<Layout
  title="Ramón Vallejos, consultor de marketing y crecimiento con IA · SpindleLab"
  description="Detrás de SpindleLab está Ramón Vallejos. Marketing y crecimiento con IA, con evidencia antes que promesas. Revisión gratis de una página."
>
  <Nav />
  <main>
    <article class="px-4 sm:px-6 pt-28 sm:pt-36 pb-24">
      <div class="max-w-3xl mx-auto">
        <nav class="flex items-center gap-2 text-xs text-fg-muted mb-6" aria-label="Migas de pan">
          <a href="/" class="hover:text-fg transition-colors">Inicio</a>
          <span>/</span>
          <span class="text-fg">Nosotros</span>
        </nav>

        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-support mb-4">Quiénes somos</p>
        <h1
          class="font-display text-3xl sm:text-4xl md:text-[2.75rem] leading-[1.08] text-fg"
          style="letter-spacing:-0.03em"
        >
          No te prometo. Te muestro.
        </h1>

        <div class="mt-10 flex items-center gap-5">
          <img
            src="/assets/img/ramon-vallejos.jpg"
            alt="Ramón Vallejos, consultor de SpindleLab"
            width="896"
            height="1200"
            loading="lazy"
            class="shrink-0 w-20 h-24 rounded-2xl border border-white/10 object-cover object-top"
          />
          <div>
            <p class="text-base font-semibold text-fg">Ramón Vallejos</p>
            <p class="text-sm text-fg-muted">Consultor de marketing y crecimiento con IA · Chile</p>
          </div>
        </div>

        <div class="mt-10 space-y-5 text-fg-muted leading-relaxed text-[1.05rem]">
          <p class="text-fg text-lg">
            Soy Ramón Vallejos y SpindleLab soy yo. Uso agentes de IA para el trabajo que se repite y
            reviso yo lo que te entrego. Como soy una persona, tomo pocos proyectos a la vez. Atiendo a
            todo Chile por videollamada.
          </p>
          <p>
            Antes trabajé en agencias. Coordiné la producción de piezas para ocho marcas nacionales en
            Universal McCann y trabajé la cuenta de LATAM Airlines en Graphene IPG, con campañas en cuatro
            países. Después hice pauta de retail y B2B en Incrementa, y contenido y SEO en Maggiore.
          </p>
        </div>

        <div class="mt-12 grid sm:grid-cols-2 gap-px bg-white/10 rounded-2xl overflow-hidden border border-white/10">
          {
            PUNTOS.map((p, i) => (
              <div class={`bg-surface p-6 md:p-7${PUNTOS.length % 2 === 1 && i === PUNTOS.length - 1 ? ' sm:col-span-2' : ''}`}>
                <h2 class={`text-base font-semibold text-fg${p.desc ? ' mb-1.5' : ''}`}>{p.titulo}</h2>
                {p.desc && <p class="text-sm text-fg-muted leading-relaxed">{p.desc}</p>}
              </div>
            ))
          }
        </div>

        <div class="mt-14 rounded-2xl border border-white/10 bg-surface-2 p-8 text-center">
          <p class="font-display text-2xl text-fg" style="letter-spacing:-0.02em">
            Escríbeme la dirección de tu sitio.
          </p>
          <p class="mt-2 text-sm text-fg-muted">
            Te respondo con la revisión.
          </p>
          <a
            href={CONTACTO}
            class="mt-6 inline-flex items-center gap-2 bg-paper hover:bg-white text-bg text-sm font-semibold px-6 py-3 rounded-full transition-colors"
          >
            Escribirme
            <Icon name="arrowRight" />
          </a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>
