---
// NOSOTROS SOBRE A · ARCHIVO (obra E12, corrida 2, tanda 5; reescrito en la obra E13, 26-oct-2026).
//
// Contrato: spindlelab-v3/spec-visual.md §2.4, fila «/nosotros/»: cabecera; el retrato 3:4 de Ramón en c1-c5 junto
// a la bio (c7-c14), como «Quién está detrás» de la home pero a la escala de la página; «Cómo trabajo» como sección;
// el cierre. Sin franja: el retrato es la imagen. En E13 se saca «Por qué un solo sistema» (subordinaba redes y pauta
// al sitio): la página queda con la bio, la trayectoria, las tres reglas de Ramón y el cierre, todo en su singular.
//
// El texto lo arma nosotros() en interiores.mjs, desde texto/nosotros.json (Clara). Señales de Simón,
// senales-obra.md §2.10; el jobTitle de #autor-ramon lo pone el Layout con la prop de layout-a.ts.
import Layout from '../layouts/Layout.astro';
import PaginaA from '../components/a/PaginaA.astro';
import Miga from '../components/a/Miga.astro';
import Imagen from '../components/a/Imagen.astro';
import Icono from '../components/a/Icono.astro';
import { LAYOUT_A } from '../components/a/layout-a';
import { nosotros } from '../data/archivo/interiores.mjs';
import medios from '../data/archivo/medios.json';

const m = nosotros();
const retrato = medios.medios['ramon-vallejos-34'];
---
<Layout title={m.title} description={m.description} ogImage={m.og.src} ogImageAlt={m.og.alt} {...LAYOUT_A}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(m.jsonLd)} />
  <PaginaA>
    {/* 1 · CABECERA (§2.4.1): el h1 de Ramón en una sola tinta (Clara) */}
    <section class="reticula int-cab" aria-labelledby="h-titulo">
      <Miga items={[{ texto: m.miga[0], href: '/' }, { texto: m.miga[1] }]} />
      <h1 class="t-declaracion" id="h-titulo">{m.h1}</h1>
      <p class="cuerpo caja">{m.linea}</p>
      <div class="botones">
        {m.botones.map((b) => <a class={`boton boton--${b.clase}`} href={b.href}>{b.texto}</a>)}
      </div>
    </section>

    {/* 2 · EL RETRATO Y LA BIO: el retrato 3:4 entero en c1-c5, la bio en c7-c14 apoyada abajo */}
    <section class="seccion reticula quien" aria-labelledby="h-trayectoria">
      <div class="quien__retrato" data-entrada>
        <Imagen src={retrato.src} alt={m.alt} ancho={retrato.ancho} alto={retrato.alto} clase="p-34" primeraPantalla />
      </div>
      <div class="quien__txt">
        <p class="cuerpo caja">{m.bio}</p>
        <p class="chico caja"><span class="tinta">{m.firma.nombre}</span>{m.firma.resto}</p>
        <h2 class="t-titulo quien__h2" id="h-trayectoria">{m.trayectoria.h2}</h2>
        <ul class="int-lista quien__lista">
          {m.trayectoria.lista.map((linea) => <li><p class="cuerpo">{linea.map((p) => (p.junto ? <span class="sin-corte">{p.texto}</span> : p.texto))}</p></li>)}
        </ul>
      </div>
    </section>

    {/* 3 · CÓMO TRABAJO: las tres reglas (lista, c5-c12) */}
    <section class="seccion reticula" aria-labelledby="h-como">
      <div class="int-sec__cab"><h2 class="t-declaracion" id="h-como">{m.como.h2}</h2></div>
      <ul class="int-sec__cuerpo int-lista">
        {m.como.lista.map((x) => <li><h3 class="int-lista__t tinta">{x.t}</h3><p class="cuerpo">{x.d}</p></li>)}
      </ul>
    </section>

    {/* 4 · CIERRE (§2.4.4) y «Siguiente · Método» */}
    <section class="seccion reticula" aria-labelledby="h-cierre">
      <div class="cierre">
        <h2 class="t-declaracion" id="h-cierre">{m.cierre.h2}</h2>
        <p class="cuerpo">{m.cierre.p}</p>
        <div class="botones">
          {m.cierre.botones.map((b, i) => <a class={`boton boton--${b.clase}`} href={b.href}>{b.texto}{i === 0 && <Icono nombre="flecha" />}</a>)}
        </div>
        <div class="int-siguiente">
          <p class="rotulo">{m.cierre.siguiente.rotulo}</p>
          <a class="t-titulo t-display subrayado" href={m.cierre.siguiente.href}>{m.cierre.siguiente.texto}<Icono nombre="flecha" /></a>
        </div>
      </div>
    </section>
  </PaginaA>
</Layout>
