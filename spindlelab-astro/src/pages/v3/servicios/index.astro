---
// SERVICIOS SOBRE A · ARCHIVO (obra E12, corrida 2, tanda 4). Diego, 19-oct-2026.
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md §2.4, fila /v3/servicios/: la cabecera («Qué
// hacemos»); una sección por momento de oferta-v3.json (a la izquierda su número y su situación, a la derecha sus
// servicios como filas enlazadas: el nombre a Título con la flecha, la línea de qué hace y el precio en blanco); «Lo que
// pones tú»; «Empieza por el chequeo». Sin campo de color por servicio (lo que Ramón rechazó de driftime). La plantilla
// interior vive en archivo.css (INTERIOR); lo que la spec no cubría está en spindlelab-v3/desvios.md, tanda 4.
//
// El texto es de Clara, tal cual (src/data/archivo/texto/servicios.json, copia de e12/texto/texto-obra.json). Los
// nombres, los destinos y los precios se comparan, como texto, con oferta-v3.json y servicios-v3.json, y el build se cae
// si no son iguales (servicios.mjs). «Lo que pones tú» queda como estaba: sus tres puntos salen de oferta-v3.json
// («fuera») y su título y su pie, de la nota de Clara que los cita.
// Las señales (title, description, JSON-LD, imagen al compartir) son de Simón, e12/senales-obra.md §2.7.
import Layout from '../../../layouts/Layout.astro';
import PaginaA from '../../../components/a/PaginaA.astro';
import Miga from '../../../components/a/Miga.astro';
import Icono from '../../../components/a/Icono.astro';
import { LAYOUT_A } from '../../../components/a/layout-a';
import { textoDe, igualQue, contiene } from '../../../data/archivo/texto.mjs';
import { ORDEN, SITIO, trozos, comprobarPrecio } from '../../../data/archivo/servicios.mjs';
import comun from '../../../data/archivo/texto/comun.json';
import servicios from '../../../data/archivo/texto/servicios.json';
import oferta from '../../../data/oferta-v3.json';
import paginas from '../../../data/paginas-v3.json';

const t = textoDe(servicios, comun);
const pagina = servicios.texto;
const dos = (id: string) => t(id) as { tinta: string; gris: string };

// ---- Cabecera
const migaClara = t('servicios.miga').texto.split(' · ');
igualQue(migaClara.join(' · '), 'Inicio · Servicios', 'servicios, la miga');
const entradilla = t('servicios.entradilla');
const trozosEntradilla = trozos(entradilla.texto, entradilla.enlaces);

// ---- Los cuatro momentos: los tres de oferta-v3.json (momentos) y «también» (Redes y Paid Media). Cada servicio, con
// su nombre, su destino y su precio de Clara, comparados con los JSON; y su línea, la de la home (Clara).
const lineaDe: Record<string, string> = {
  'desarrollo-web': 'servicios.m1.dw',
  'visibilidad-en-ia': 'servicios.m2.via',
  'auditoria-seo-tecnica': 'servicios.m2.aud',
  'acompanamiento-mensual': 'servicios.m3.aco',
  'redes-sociales': 'servicios.m4.redes',
  'paid-media': 'servicios.m4.paid',
};
const itemsDe = [...oferta.momentos.map((m) => m.items), oferta.tambien];
const momentos = itemsDe.map((items, i) => {
  const k = `servicios.m${i + 1}`;
  const filas = items.map((it, j) => {
    const nombre = t(`${k}.s${j + 1}.nombre`);
    const precio = t(`${k}.s${j + 1}.precio`).texto;
    const slug = it.href.split('/').filter(Boolean).pop() as string;
    igualQue(it.n, nombre.texto, `servicios, nombre del servicio ${j + 1} del momento ${i + 1}`);
    igualQue(it.href, nombre.destino, `servicios, destino de «${it.n}»`);
    comprobarPrecio(precio, slug, `servicios, precio de «${it.n}»`);
    return { slug, nombre: it.n, href: it.href, precio, linea: t(lineaDe[slug]).texto };
  });
  let nota = '';
  try { nota = t(`${k}.nota`).texto; } catch (e) { nota = ''; }
  return { id: `m${i + 1}`, numero: String(i + 1).padStart(2, '0'), situacion: t(`${k}.situacion`).texto, nota, filas };
});
// Los planes de Desarrollo web, nombrados en su línea de precio, son los de oferta-v3.json
for (const p of oferta.momentos[0].planes.slice(0, 3)) contiene(momentos[0].filas[0].precio, p.n, 'servicios, planes de Desarrollo web');
// Los seis, en el orden de servicios.mjs (el de «Siguiente» y del ItemList)
igualQue(momentos.flatMap((m) => m.filas.map((f) => f.slug)).join(' '), ORDEN.map((s) => s.slug).join(' '), 'servicios, el orden');

// ---- Lo que pones tú: queda tal cual (Clara lo cita en su nota). Los tres puntos, de oferta-v3.json; cada uno con su
// rótulo en blanco y el detalle en gris, como hoy.
const pones = t('servicios.pones').texto;
const ponesTitulo = contiene(pones, 'Lo que pones tú', 'servicios, «Lo que pones tú»') && 'Lo que pones tú';
const ponesPie = contiene(pones, 'Si no tienes quién lo produzca, te conectamos con partners.', 'servicios, el pie de «Lo que pones tú»') && 'Si no tienes quién lo produzca, te conectamos con partners.';
if (oferta.fuera.length !== 3) throw new Error('servicios: «Lo que pones tú» tiene tres puntos (Clara)');
const partir = (texto: string) => {
  const i = texto.indexOf(': ');
  return i === -1 ? { a: '', b: texto } : { a: texto.slice(0, i + 1), b: texto.slice(i + 2) };
};
const fuera = oferta.fuera.map(partir);

// ---- Empieza por el chequeo
const b1 = t('servicios.chequeo.boton');
const b2 = t('servicios.chequeo.boton2');

// ---- Señales (Simón, senales-obra.md §2.7): title y description de Clara, que son los de Simón. El grafo de hoy queda:
// BreadcrumbList (igual a la miga) + ItemList, en el orden de la página, cada servicio con su nodo Service publicado.
const title = pagina.title;
const description = pagina.description;
if (title.length > 60 || description.length < 120 || description.length > 160) {
  throw new Error(`servicios: title (${title.length}) o description (${description.length}) fuera de los largos de senales-obra.md §1.2`);
}
const pub = (paginas as Record<string, any>).servicios;
const url = `${SITIO}/servicios/`;
igualQue(pub.breadcrumb.map((b: { name: string }) => b.name).join(' · '), migaClara.join(' · '), 'servicios, BreadcrumbList y miga');
const itemList = {
  ...pub.itemList,
  '@id': `${url}#itemlist`,
  itemListElement: ORDEN.map((s, i) => {
    const li = pub.itemList.itemListElement.find((x: any) => x.item.url === `${SITIO}/servicios/${s.slug}/`);
    if (!li) throw new Error(`servicios: el ItemList publicado no trae ${s.slug}`);
    return { ...li, position: i + 1 };
  }),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: pub.breadcrumb },
    itemList,
  ],
};
const og = { src: '/assets/img/og-e12-servicios.jpg?v=1', alt: `SpindleLab: ${dos('servicios.h1').tinta} ${dos('servicios.h1').gris}` };
---
<Layout title={title} description={description} ogImage={og.src} ogImageAlt={og.alt} {...LAYOUT_A}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <PaginaA>
    {/* 1 · CABECERA (§2.4.1): miga, h1 en dos tintas, la entradilla con su enlace al chequeo y la nota de los precios */}
    <section class="reticula int-cab" aria-labelledby="h-titulo">
      <Miga items={[{ texto: migaClara[0], href: '/v3/' }, { texto: migaClara[1] }]} />
      <h1 class="t-declaracion" id="h-titulo"><span class="tinta">{dos('servicios.h1').tinta}</span> <span class="gris">{dos('servicios.h1').gris}</span></h1>
      <p class="cuerpo caja">{trozosEntradilla.map((p) => (p.href ? <a href={p.href}>{p.texto}</a> : p.texto))}</p>
      <p class="chico caja">{t('servicios.nota').texto}</p>
    </section>

    {/* 2 · UNA SECCIÓN POR MOMENTO (§2.4, fila /v3/servicios/): su número y su situación a la izquierda (pegajosos desde
         1194), sus servicios a la derecha, en c5–c16, como filas enlazadas */}
    {momentos.map((m) => (
      <section class="seccion reticula" aria-labelledby={`h-${m.id}`}>
        <div class="int-sec__cab">
          <p class="rotulo">{m.numero}</p>
          <h2 class="t-declaracion" id={`h-${m.id}`}>{m.situacion}</h2>
          {m.nota && <p class="cuerpo">{m.nota}</p>}
        </div>
        <ul class="int-sec__cuerpo int-sec__cuerpo--ancho">
          {m.filas.map((f) => (
            <li class="fila-servicio">
              <h3 class="t-titulo fila-servicio__nombre"><a class="subrayado" href={f.href}>{f.nombre}<Icono nombre="flecha" /></a></h3>
              <p class="cuerpo fila-servicio__linea">{f.linea}</p>
              <p class="cuerpo fila-servicio__precio">{f.precio}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {/* 3 · LO QUE PONES TÚ: una lista, con la línea entre filas */}
    <section class="seccion reticula" aria-labelledby="h-pones">
      <div class="int-sec__cab">
        <h2 class="t-declaracion" id="h-pones">{ponesTitulo}</h2>
      </div>
      <div class="int-sec__cuerpo">
        <ul class="int-lista">
          {fuera.map((x) => <li><p class="cuerpo">{x.a && [<span class="tinta">{x.a}</span>, ' ']}{x.b}</p></li>)}
        </ul>
        <p class="chico int-lista__pie">{ponesPie}</p>
      </div>
    </section>

    {/* 4 · EMPIEZA POR EL CHEQUEO: el cierre de la plantilla (§2.4.4) */}
    <section class="seccion reticula" aria-labelledby="h-chequeo">
      <div class="cierre">
        <h2 class="t-declaracion" id="h-chequeo">{t('servicios.chequeo.h2').texto}</h2>
        <p class="cuerpo">{t('servicios.chequeo.p').texto}</p>
        <div class="botones">
          <a class="boton boton--claro" href={b1.destino}>{b1.texto}<Icono nombre="flecha" /></a>
          <a class="boton boton--placa" href={b2.destino}>{b2.texto}</a>
        </div>
      </div>
    </section>
  </PaginaA>
</Layout>
