---
// SERVICIOS SOBRE A · ARCHIVO (obra E12, corrida 2, tanda 4. Diego, 19-oct-2026; obra E13, 26-oct-2026).
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md §2.4, fila /v3/servicios/: la cabecera; una sección
// por bloque (a la izquierda su número y su nombre, a la derecha sus servicios como filas enlazadas: el nombre a Título
// con la flecha, la línea de qué hace y el precio en blanco); «Lo que pones tú»; las preguntas; el cierre. Sin campo de
// color por servicio (lo que Ramón rechazó de driftime). La plantilla interior vive en archivo.css (INTERIOR).
//
// E13: los cuatro bloques con precio del documento de textos (§4) reemplazan a las cuatro «situaciones» del v3 anterior,
// con el mismo componente: cambian el orden y el texto. Los bloques, en ese orden, son Búsqueda y visibilidad en IA
// (Auditoría SEO técnica, Visibilidad en IA), Anuncios en Google y redes (Paid Media, Gestión de redes), Sitio web a
// medida (Desarrollo web) y Acompañamiento mensual. oferta-v3.json conserva su forma (la home lee momentos[] y
// tambien[]): aquí solo se agrupan sus filas por slug.
//
// El texto es de Clara, tal cual (src/data/archivo/texto/servicios.json, copia de e13/texto/servicios.json). Los
// nombres, los destinos y los precios se comparan, como texto, con oferta-v3.json y servicios-v3.json, y el build se cae
// si no son iguales (servicios.mjs). «Lo que pones tú» saca sus tres puntos de oferta-v3.json («fuera») y su título y
// su pie, de la nota de Clara que los cita. Las preguntas visibles son las del FAQPage del JSON-LD, del mismo texto.
// Las señales (title, description, JSON-LD, imagen al compartir) son de Simón, e12/senales-obra.md §2.7, con el title y
// la description publicados el 24-oct.
import Layout from '../../../layouts/Layout.astro';
import PaginaA from '../../../components/a/PaginaA.astro';
import Miga from '../../../components/a/Miga.astro';
import Icono from '../../../components/a/Icono.astro';
import { LAYOUT_A } from '../../../components/a/layout-a';
import { textoDe, igualQue, contiene } from '../../../data/archivo/texto.mjs';
import { ORDEN, SITIO, comprobarPrecio } from '../../../data/archivo/servicios.mjs';
import comun from '../../../data/archivo/texto/comun.json';
import servicios from '../../../data/archivo/texto/servicios.json';
import oferta from '../../../data/oferta-v3.json';
import paginas from '../../../data/paginas-v3.json';

const t = textoDe(servicios, comun);
const pagina = servicios.texto;
const dos = (id: string) => t(id) as { tinta: string; gris: string };

// ---- Cabecera
const migaClara = t('servicios.miga').texto.split(' · ');
igualQue(migaClara.join(' · '), 'Inicio · Soluciones', 'servicios, la miga');
const entradilla = t('servicios.entradilla');

// ---- Los cuatro bloques (documento de textos §4). Cada servicio, con su nombre, su destino y su precio de Clara,
// comparados con los JSON; y su línea. Los grupos se arman por slug, sobre las filas de oferta-v3.json.
const FILAS = [...oferta.momentos.flatMap((m) => m.items), ...oferta.tambien];
const BLOQUES: { k: string; servicios: { slug: string; linea: string }[] }[] = [
  { k: 'servicios.m1', servicios: [{ slug: 'auditoria-seo-tecnica', linea: 'servicios.m1.aud' }, { slug: 'visibilidad-en-ia', linea: 'servicios.m1.via' }] },
  { k: 'servicios.m2', servicios: [{ slug: 'paid-media', linea: 'servicios.m2.paid' }, { slug: 'redes-sociales', linea: 'servicios.m2.redes' }] },
  { k: 'servicios.m3', servicios: [{ slug: 'desarrollo-web', linea: 'servicios.m3.dw' }] },
  { k: 'servicios.m4', servicios: [{ slug: 'acompanamiento-mensual', linea: 'servicios.m4.aco' }] },
];
const momentos = BLOQUES.map((b, i) => {
  const filas = b.servicios.map((sv, j) => {
    const it = FILAS.find((f) => f.href.split('/').filter(Boolean).pop() === sv.slug);
    if (!it) throw new Error(`servicios: «${sv.slug}» no está en oferta-v3.json`);
    const nombre = t(`${b.k}.s${j + 1}.nombre`);
    const precio = t(`${b.k}.s${j + 1}.precio`).texto;
    igualQue(it.n, nombre.texto, `servicios, nombre del servicio ${j + 1} del bloque ${i + 1}`);
    igualQue(it.href, nombre.destino, `servicios, destino de «${it.n}»`);
    comprobarPrecio(precio, sv.slug, `servicios, precio de «${it.n}»`);
    return { slug: sv.slug, nombre: it.n, href: it.href, precio, linea: t(sv.linea).texto };
  });
  let nota = '';
  try { nota = t(`${b.k}.nota`).texto; } catch (e) { nota = ''; }
  return { id: `m${i + 1}`, numero: String(i + 1).padStart(2, '0'), situacion: t(`${b.k}.situacion`).texto, nota, filas };
});
// Los planes de Desarrollo web, nombrados en su línea de precio, son los de oferta-v3.json
for (const p of oferta.momentos[0].planes.slice(0, 3)) contiene(momentos[2].filas[0].precio, p.n, 'servicios, planes de Desarrollo web');
// Los seis, en el orden de servicios.mjs (el de «Siguiente» y del ItemList)
igualQue(momentos.flatMap((m) => m.filas.map((f) => f.slug)).join(' '), ORDEN.map((s) => s.slug).join(' '), 'servicios, el orden');

// ---- Lo que pones tú: los tres puntos, de oferta-v3.json; cada uno con su rótulo en blanco y el detalle en gris.
const pones = t('servicios.pones').texto;
const PIE_PONES = 'Si no tienes quién lo produzca, te orientamos.';
const ponesTitulo = contiene(pones, 'Lo que pones tú', 'servicios, «Lo que pones tú»') && 'Lo que pones tú';
const ponesPie = contiene(pones, PIE_PONES, 'servicios, el pie de «Lo que pones tú»') && PIE_PONES;
if (oferta.fuera.length !== 3) throw new Error('servicios: «Lo que pones tú» tiene tres puntos (Clara)');
const partir = (texto: string) => {
  const i = texto.indexOf(': ');
  return i === -1 ? { a: '', b: texto } : { a: texto.slice(0, i + 1), b: texto.slice(i + 2) };
};
const fuera = oferta.fuera.map(partir);

// ---- Preguntas: las del FAQPage del JSON-LD son estas mismas
const preguntas = [1, 2, 3].map((n) => ({ p: t(`servicios.faq.${n}.p`).texto as string, r: t(`servicios.faq.${n}.r`).texto as string }));

// ---- Cierre: la revisión es la acción; el chequeo, el enlace secundario
const b1 = t('servicios.cierre.boton');
const b2 = t('servicios.cierre.boton2');

// ---- Señales (Simón, senales-obra.md §2.7): title y description de Clara, que son los de Simón. El grafo de hoy queda:
// BreadcrumbList (igual a la miga) + ItemList, en el orden de la página, cada servicio con su nodo Service publicado.
const title = pagina.title;
const description = pagina.description;
if (title.length > 60 || description.length < 120 || description.length > 160) {
  throw new Error(`servicios: title (${title.length}) o description (${description.length}) fuera de los largos de senales-obra.md §1.2`);
}
const pub = (paginas as Record<string, any>).servicios;
const url = `${SITIO}/servicios/`;
igualQue(pub.breadcrumb.map((b: { name: string }) => b.name).join(' · '), migaClara.join(' · '), 'servicios, BreadcrumbList y miga');
const itemList = {
  ...pub.itemList,
  '@id': `${url}#itemlist`,
  itemListElement: ORDEN.map((s, i) => {
    const li = pub.itemList.itemListElement.find((x: any) => x.item.url === `${SITIO}/servicios/${s.slug}/`);
    if (!li) throw new Error(`servicios: el ItemList publicado no trae ${s.slug}`);
    return { ...li, position: i + 1 };
  }),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: pub.breadcrumb },
    itemList,
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: preguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
    },
  ],
};
const og = { src: '/assets/img/og-e12-servicios.jpg?v=2', alt: `SpindleLab: ${dos('servicios.h1').tinta} ${dos('servicios.h1').gris}` };
---
<Layout title={title} description={description} ogImage={og.src} ogImageAlt={og.alt} {...LAYOUT_A}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <PaginaA>
    {/* 1 · CABECERA (§2.4.1): miga, h1 en dos tintas, la entradilla y la nota de los precios */}
    <section class="reticula int-cab" aria-labelledby="h-titulo">
      <Miga items={[{ texto: migaClara[0], href: '/v3/' }, { texto: migaClara[1] }]} />
      <h1 class="t-declaracion" id="h-titulo"><span class="tinta">{dos('servicios.h1').tinta}</span> <span class="gris">{dos('servicios.h1').gris}</span></h1>
      <p class="cuerpo caja">{entradilla.texto}</p>
      <p class="chico caja">{t('servicios.nota').texto}</p>
    </section>

    {/* 2 · UNA SECCIÓN POR BLOQUE (§2.4, fila /v3/servicios/): su número y su nombre a la izquierda (pegajosos desde
         1194), sus servicios a la derecha, en c5 a c16, como filas enlazadas */}
    {momentos.map((m) => (
      <section class="seccion reticula" aria-labelledby={`h-${m.id}`}>
        <div class="int-sec__cab">
          <p class="rotulo">{m.numero}</p>
          <h2 class="t-declaracion" id={`h-${m.id}`}>{m.situacion}</h2>
          {m.nota && <p class="cuerpo">{m.nota}</p>}
        </div>
        <ul class="int-sec__cuerpo int-sec__cuerpo--ancho">
          {m.filas.map((f) => (
            <li class="fila-servicio">
              <h3 class="t-titulo fila-servicio__nombre"><a class="subrayado" href={f.href}>{f.nombre}<Icono nombre="flecha" /></a></h3>
              <p class="cuerpo fila-servicio__linea">{f.linea}</p>
              <p class="cuerpo fila-servicio__precio">{f.precio}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {/* 3 · LO QUE PONES TÚ: una lista, con la línea entre filas */}
    <section class="seccion reticula" aria-labelledby="h-pones">
      <div class="int-sec__cab">
        <h2 class="t-declaracion" id="h-pones">{ponesTitulo}</h2>
      </div>
      <div class="int-sec__cuerpo">
        <ul class="int-lista">
          {fuera.map((x) => <li><p class="cuerpo">{x.a && [<span class="tinta">{x.a}</span>, ' ']}{x.b}</p></li>)}
        </ul>
        <p class="chico int-lista__pie">{ponesPie}</p>
      </div>
    </section>

    {/* 4 · PREGUNTAS (c5 a c12): las del FAQPage del JSON-LD */}
    <section class="seccion reticula" aria-labelledby="h-faq">
      <div class="int-sec__cab"><h2 class="t-declaracion" id="h-faq">{t('servicios.faq.h2').texto}</h2></div>
      <div class="int-sec__cuerpo">
        {preguntas.map((q) => (
          <div class="pregunta"><h3>{q.p}</h3><p class="cuerpo">{q.r}</p></div>
        ))}
      </div>
    </section>

    {/* 5 · CIERRE (§2.4.4): pedir la revisión, y el chequeo como acción secundaria */}
    <section class="seccion reticula" aria-labelledby="h-cierre">
      <div class="cierre">
        <h2 class="t-declaracion" id="h-cierre">{t('servicios.cierre.h2').texto}</h2>
        <p class="cuerpo">{t('servicios.cierre.p').texto}</p>
        <div class="botones">
          <a class="boton boton--claro" href={b1.destino}>{b1.texto}<Icono nombre="flecha" /></a>
          <a class="boton boton--placa" href={b2.destino}>{b2.texto}</a>
        </div>
      </div>
    </section>
  </PaginaA>
</Layout>
