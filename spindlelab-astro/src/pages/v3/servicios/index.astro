---
// ÍNDICE DE SERVICIOS — sistema driftime (5-oct-2026).
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md, §4 plantilla «Índice»:
// h1 60 px + entrada → filas editoriales, cada servicio con su campo de color y su precio.
// Implementación de referencia: src/pages/v3/servicios/desarrollo-web.astro (cabecera, entrada,
// secciones pegajosas) y src/pages/v3/index.astro (campos y línea de precio).
//
// LO QUE ORDENA LA PÁGINA: el MOMENTO del cliente, igual que la home. Cada momento es una
// banda del color de su campo (brasa = Desarrollo, navy = Visibilidad, petróleo = Continuidad,
// ciruela = Alcance) y adentro van sus servicios como filas con filete, nunca tarjetas. En
// escritorio las bandas se pegan arriba y se apilan, como los campos de la home y de driftime.
// En celular no se pegan: una banda más alta que la pantalla escondería su final bajo la
// siguiente.
//
// SIN DISPLAY: una interna tiene cero usos de Manrope 800 en mayúsculas. La palabra del campo,
// que en la home es display, acá va como rótulo chico en caja normal.
//
// CONTRASTE EN LAS BANDAS: brasa con blanco da 4,70:1 y petróleo con su crema 5,06:1. Pasan
// AA, pero sin margen: cualquier opacidad en el texto los deja abajo. Por eso todo el texto de
// una banda va al 100 % (incluido el «Desde» y el «+ IVA» del precio) y la jerarquía se hace
// con tamaño y peso.
//
// La banda es un componente propio de esta página, declarado en la spec (§3 «banda del
// índice» y §7): alto variable, filete en el color del texto al 32 %, pegajosa solo desde
// 768 px de ancho y 680 px de alto.
//
// LOS PRECIOS Y EL ORDEN VIVEN EN src/data/oferta-v3.json, compartido con la home: un precio
// escrito a mano en dos lados termina distinto en uno. Se muestran con la misma forma que en
// la home: «Desde | … | + IVA».
//
// De «dentro / fuera» queda solo «fuera» (QA 5-oct, A10): «dentro» repetía los servicios que
// las cuatro bandas acaban de mostrar, y en el orden contrario. El FAQ no se duplica acá; vive
// en cada página de servicio.
import Layout from '../../../layouts/Layout.astro';
import { CONTACTO_V3 as CONTACTO } from '../../../consts-v3';
import NavV3 from '../../../components/v3/NavV3.astro';
import FooterV3 from '../../../components/v3/FooterV3.astro';
import '../../../styles/driftime.css';
import oferta from '../../../data/oferta-v3.json';
import paginas from '../../../data/paginas-v3.json';

const url = 'https://spindlelab.cl/servicios/';
const pub = (paginas as Record<string, any>).servicios;

// El grafo es el de producción (public/servicios/index.html), que paginas-v3.json guarda
// extraído: mismos dos nodos y mismos @id. Cada ítem apunta al nodo Service con el mismo @id
// que Layout.astro declara en makesOffer; sin eso el índice queda desconectado de los
// servicios (QA 5-oct, C8). La organización y la persona ya las emite Layout.astro.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: pub.breadcrumb,
    },
    {
      ...pub.itemList,
      '@id': `${url}#itemlist`,
    },
  ],
};

// Notas de banda propias de esta página. En oferta-v3.json la de Desarrollo traía dos
// antítesis seguidas y jerga («primer commit», «AEO»), y la de Visibilidad repetía «no lo vas
// a rehacer», que ya dice su h2 (QA 5-oct, A4/A10/B8). El JSON es compartido y no se toca
// desde acá: el cambio va propuesto. Cuando el JSON lo traiga, este mapa se borra.
const notaPagina: Record<string, string> = {
  brasa: 'La legibilidad para Google y para la IA viene incluida desde el primer día de construcción; no se cobra después.',
  navy: 'No hace falta reconstruir para que una IA pueda citarte.',
};

// «$490.000 · $690.000 con Visibilidad IA» → una alternativa por trozo. Cada trozo no se
// parte: la línea solo corta entre alternativas, nunca dentro de «$690.000 con Visibilidad
// IA» (QA 5-oct). El punto va pegado con espacio duro a la alternativa anterior, así ninguna
// línea empieza con «·».
const alternativas = (p: string) => p.split(' · ');

// Las cuatro bandas, en el orden de la home: Desarrollo abre, Alcance cierra.
const bandas = [
  ...oferta.momentos.map((m: any) => ({ palabra: m.palabra, campo: m.campo, momento: m.momento, nota: m.nota, items: m.items })),
  { palabra: oferta.tambienPanel.palabra, campo: oferta.tambienPanel.campo, momento: oferta.tambienPanel.momento, nota: oferta.tambienPanel.nota, items: oferta.tambien },
].map((b) => ({ ...b, nota: notaPagina[b.campo] ?? b.nota, id: `m-${b.palabra.toLowerCase()}` }));

// «Creación de contenido: redacción y guiones…» → el rótulo en papel, el detalle en gris.
const partir = (t: string) => {
  const i = t.indexOf(': ');
  return i === -1 ? { a: '', b: t } : { a: t.slice(0, i + 1), b: t.slice(i + 2) };
};
---
<Layout
  title="Soluciones: SEO técnico, visibilidad en IA y desarrollo web · SpindleLab"
  description="SEO técnico, visibilidad en motores de IA y desarrollo web a medida, con precios publicados. Chequeo gratis antes de contratar nada."
  bodyClass="d-body"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <NavV3 />

  <main>
    <header class="d-cab">
      <nav class="d-miga" aria-label="Migas"><a href="/v3/">Inicio</a> · Soluciones</nav>
      <h1 class="d-h1">Qué hacemos</h1>
    </header>

    <div class="d-entrada">
      <p class="d-nota-card"><b>Valores en pesos, + IVA.</b> Los publicamos a propósito: la mayoría del rubro no lo hace.</p>
      {/* Los dos destinos que anuncia van enlazados (QA 5-oct): el chequeo, que la description
           promete, quedaba a ~3.500 px. Sin repetir la fila de Desarrollo Web, que se comparte
           con la home, ni el «no lo vas a rehacer» del h2 de Visibilidad. */}
      <p class="d-guia">El centro es tu sitio: lo construimos para que los motores de IA puedan leerlo. Si ya tienes uno y funciona, <a class="d-enlace-sidx" href="#m-visibilidad">hay una puerta para eso</a>. Y antes de contratar nada, <a class="d-enlace-sidx" href="/v3/diagnostico/">mira gratis cómo te leen hoy</a>.</p>
    </div>

    {/* Las bandas de los cuatro momentos. Cada fila es un enlace entero al servicio. */}
    <div class="d-bandas-sidx">
      {bandas.map((b) => (
        <section class:list={['d-banda-sidx', `d-banda-sidx--${b.campo}`]} aria-labelledby={b.id}>
          <div class="d-banda-sidx__cab">
            <p class="d-banda-sidx__pal">{b.palabra}</p>
            <h2 class="d-h2" id={b.id}>{b.momento}</h2>
            {b.nota && <p class="d-banda-sidx__nota">{b.nota}</p>}
          </div>
          <ul class="d-banda-sidx__filas">
            {b.items.map((it: any) => (
              <li>
                <a class="d-fila-sidx" href={it.href}>
                  <h3 class="d-h3">{it.n}</h3>
                  <span class="d-fila-sidx__flecha" aria-hidden="true">→</span>
                  <p class="d-fila-sidx__d">{it.d}</p>
                  {/* Espacios reales entre las piezas: sin ellos el texto sin CSS (lector de
                       pantalla, copiar, rastreador) era «Desde$390.000 … $1.190.000+ IVA». */}
                  <p class="d-precio">
                    {alternativas(it.p).map((a, i, todas) => [
                      i > 0 ? ' ' : '',
                      <span class="d-pre-alt-sidx">{i === 0 && [<span class="d-pre-rot">Desde</span>, <span class="d-pre-sep" aria-hidden="true"></span>, ' ']}<b>{a}{i < todas.length - 1 ? ' ·' : ''}</b>{i === todas.length - 1 && [' ', <span class="d-pre-rot">+ IVA</span>]}</span>,
                    ])}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    {/* EL LÍMITE, verbatim. Decir qué NO se hace evita el malentendido de alcance. Solo la
         mitad «fuera»: la mitad «dentro» repetía las bandas (QA 5-oct, A10/B7). Sección corta:
         la etiqueta no se pega (spec §7). */}
    <section class="d-sec d-sec--quieta" aria-labelledby="s-limite">
      <div class="d-eti"><h2 class="d-h2" id="s-limite">Lo que no hacemos</h2></div>
      <div>
        <ul class="d-filas d-lista-sidx">
          {oferta.fuera.map((t: string) => { const p = partir(t); return <li>{p.a && <span>{p.a} </span>}<span class="d-gris">{p.b}</span></li>; })}
        </ul>
        <p class="d-chico d-gris d-limite-sidx__pie">Si no lo tienes, te conectamos con partners.</p>
      </div>
    </section>

    {/* El texto describe lo que hace el botón (QA 5-oct, bloqueante): el chequeo es el
         automático de /v3/diagnostico/, sobre tu sitio; no mira la competencia, eso es el
         diagnóstico completo. Mismo destino que «Chequeo gratis» del pie y del menú.
         Fuente del copy: /v3/diagnostico/ (línea, nota del instrumento y «Dos caminos»). */}
    <section class="d-sec d-sec--quieta" aria-labelledby="s-chequeo">
      <div class="d-eti"><h2 class="d-h2" id="s-chequeo">Empieza por el chequeo</h2></div>
      <div>
        <p class="d-guia">Pon tu dominio y ves en segundos si ChatGPT, Gemini y Perplexity pueden leer tu sitio. Gratis y sin dejar tu correo.</p>
        <div class="d-btns d-chequeo-sidx"><a class="d-btn" href="/v3/diagnostico/">Correr el chequeo</a><a class="d-btn d-btn--alt" href={CONTACTO}>Conversemos tu proyecto</a></div>
      </div>
    </section>
  </main>

  <FooterV3 />
</Layout>

<style>
  /* ------------------------------------------------------------ bandas de los momentos */
  .d-bandas-sidx { margin-top: 120px; }
  .d-banda-sidx { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--d-g); padding: 96px var(--d-m) 80px; }
  .d-banda-sidx--brasa { background: var(--d-brasa); color: var(--d-brasa-t); }
  .d-banda-sidx--navy { background: var(--d-navy); color: var(--d-navy-t); }
  .d-banda-sidx--petroleo { background: var(--d-petroleo); color: var(--d-petroleo-t); }
  .d-banda-sidx--ciruela { background: var(--d-ciruela); color: var(--d-ciruela-t); }
  /* Escritorio: se pegan arriba y la siguiente tapa a la anterior. El padding de arriba deja
     libre el módulo de navegación, que está fijo encima. Solo si la banda cabe en la pantalla:
     medidas de 768 a 1920 px de ancho, la más alta mide ~590 px; con menos de 680 px de alto
     de ventana (un portátil chico) se apilan sin pegarse, para que ninguna esconda su final. */
  @media (min-width: 768px) and (min-height: 680px) {
    .d-banda-sidx { position: sticky; top: 0; }
    .d-banda-sidx:nth-child(1) { z-index: 1; }
    .d-banda-sidx:nth-child(2) { z-index: 2; }
    .d-banda-sidx:nth-child(3) { z-index: 3; }
    .d-banda-sidx:nth-child(4) { z-index: 4; }
  }
  /* El ancla de la entrada («hay una puerta para eso») cae acá. En celular la banda no se pega
     y el h2 quedaba bajo el módulo de navegación (medido: h2 en y=0, módulo hasta y=86). */
  .d-banda-sidx .d-h2 { scroll-margin-top: 140px; }
  /* Escritorio: 96 de padding + rótulo + 12 de hueco = 127; la banda queda justo arriba, sin
     la franja de la anterior (con 140 asomaban 12 px de brasa). */
  @media (min-width: 768px) { .d-banda-sidx .d-h2 { scroll-margin-top: 127px; } }
  .d-banda-sidx__cab { display: flex; flex-direction: column; gap: 12px; align-self: start; padding-right: clamp(0px, 3vw, 48px); }
  .d-banda-sidx__pal { font-size: 0.8125rem; font-weight: 500; margin: 0; }
  .d-banda-sidx__nota { font-size: 0.875rem; line-height: 1.5; max-width: 340px; margin: 6px 0 0; }
  .d-banda-sidx__filas { list-style: none; margin: 0; padding: 0; }

  /* La fila: nombre y flecha arriba, la línea y el precio debajo. Filete en el color del texto
     de la banda; es un separador, no texto, así que su opacidad no afecta el contraste. */
  .d-fila-sidx { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px 24px; padding: 24px 0 28px; border-top: 1px solid color-mix(in srgb, currentColor 32%, transparent); text-decoration: none; }
  .d-banda-sidx__filas li:last-child .d-fila-sidx { border-bottom: 1px solid color-mix(in srgb, currentColor 32%, transparent); }
  .d-fila-sidx .d-h3 { grid-column: 1; grid-row: 1; }
  .d-fila-sidx__flecha { grid-column: 2; grid-row: 1; font-size: 1.5rem; line-height: 1.4; }
  .d-fila-sidx__d { grid-column: 1 / -1; font-size: clamp(1.0625rem, 1.25vw, 1.125rem); line-height: 1.6; margin: 0; max-width: 620px; }
  /* El precio fluye como texto, no como flex: en celular el flex dejaba el separador solo al
     final de una línea y el «+ IVA» huérfano en la siguiente. En línea, solo corta entre las
     palabras de la cifra; «Desde» queda pegado a la primera y «+ IVA» a la última. */
  .d-fila-sidx .d-precio { grid-column: 1 / -1; margin-top: 6px; display: block; line-height: 1.6; }
  /* Cada alternativa con su plan no se parte: «$690.000 con Visibilidad IA + IVA» va junto.
     Entre las piezas hay espacios reales (~4 px); los márgenes de abajo suman lo que falta
     para los 12 px de antes. */
  .d-fila-sidx .d-pre-alt-sidx { white-space: nowrap; }
  .d-fila-sidx .d-pre-sep { display: inline-block; width: 1px; height: 14px; vertical-align: -2px; margin: 0 8px 0 12px; }   /* un solo espacio real, después: el texto lee «Desde $390.000» */
  .d-fila-sidx .d-pre-rot { opacity: 1; }
  .d-fila-sidx .d-pre-rot:last-child { margin-left: 8px; white-space: nowrap; }
  .d-fila-sidx:hover .d-h3 { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .d-fila-sidx:focus-visible { outline-color: currentColor; outline-offset: 4px; }

  @media (max-width: 767px) {
    .d-bandas-sidx { margin-top: 80px; }
    .d-banda-sidx { grid-template-columns: 1fr; gap: 28px; padding: 56px var(--d-m) 48px; }
    .d-banda-sidx__cab { padding-right: 0; }
  }

  /* ------------------------------------------------------------ entrada */
  .d-enlace-sidx { text-decoration: underline; text-underline-offset: 0.16em; text-decoration-thickness: 1px; }
  .d-enlace-sidx:hover { text-decoration-thickness: 2px; }

  /* ------------------------------------------------------------ lo que no hacemos */
  .d-lista-sidx { list-style: none; padding: 0; margin: 0; }
  .d-lista-sidx li { font-size: clamp(1.0625rem, 1.25vw, 1.125rem); line-height: 1.6; }
  .d-limite-sidx__pie { margin: 14px 0 0; }

  .d-chequeo-sidx { margin-top: 28px; }
</style>
