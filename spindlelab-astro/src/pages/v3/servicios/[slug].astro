---
// LAS CINCO PÁGINAS DE SERVICIO en el lenguaje de driftime (5-oct-2026).
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md (§4, plantilla «Servicio»).
// Molde: ./desarrollo-web.astro. Misma estructura, alimentada por src/data/servicios-v3.json:
//   miga · h1 .d-h1 · línea · 2 botones → imagen a sangre → nota + entrada →
//   secciones pegajosas (incluye · galería · planes · bloques · preguntas · cierre) →
//   siguiente servicio → pie.
// Las secciones se buscan por su FORMA (lista, planes, bloques), no por su posición, y una
// sección que el servicio no trae no se pinta: nada de títulos sobre un hueco.
//
// LO QUE SE CONSERVA de la versión anterior: URL, title, description, noindex y el JSON-LD
// (Service + BreadcrumbList + FAQPage, mismos @id). Layout ya emite organización, sitio y
// persona; repetirlos duplicaría @id.
// El BreadcrumbList dice lo mismo que la miga visible (spec §7, filas del índice y del
// artículo; antislop C8): posición 2 «Servicios» (el JSON publicado dice «Soluciones», y el
// mismo ítem quedaba con dos nombres en el grafo del sitio) y posición 3 el nombre en caja de
// oración. Se sobrescribe al serializar, el mismo patrón de servicios/index.astro. QA2, 6-oct.
//
// LO QUE NO VIENE DEL JSON y de dónde sale (todo tiene fuente en el repo):
// · La línea bajo el h1: la meta description del JSON + la «note» del hero de la página
//   publicada (public/servicios/<slug>/index.html), con el «+ IVA» que exige la spec §7.
// · La nota de precios: la «pack-note» de esa misma página publicada.
// · Las marcas de los bloques: las «num» publicadas (Sí/No en visibilidad, A–D en los
//   entregables de la auditoría, S1–S4 en el mes tipo). Redes y Paid Media numeran 01–04
//   como las fases de Desarrollo Web: son procesos en orden.
// · El titular del cierre de Paid Media: el publicado era «¿Listo para acelerar el motor?»,
//   tell A5 del detector. Se rearma con su propio párrafo.
// · Lo que corrigió la QA independiente del 5-oct sin tocar el JSON compartido: CORRIGE
//   (precio con una notación, «equipo dedicado»), CAJA (caja de oración) y, en PROPIO,
//   leadSin/lead, incluyeH2, cierreP y el encuadre de domino.jpg. Cada uno dice por qué.
// · Lo de la 2.ª ronda (QA2, 6-oct): BreadcrumbList igual a la miga; líneas de Redes y
//   Acompañamiento con el precio del plan que de verdad trae lo que nombran; ENLACES en el
//   texto corrido; «Correr el chequeo» en tres cierres; cierre --quieta; galerías de Redes y
//   Paid Media de una imagen; repeticiones y jerga («motor») fuera, en CORRIGE.
// · Todo lo escrito en la página está registrado en la spec §7 (filas del 6-oct, Servicios).
//
// LO QUE SE DEJA AFUERA A PROPÓSITO:
// · El tinte de color del campo en la sección de bloques (la versión anterior lo tenía).
//   La página de referencia, Desarrollo Web, no usa su brasa en ninguna parte: los casos de
//   driftime son negro e imagen. Se sigue la referencia. El manual §04 dice que ninguna
//   página queda sin campo: el conflicto es del contrato y está escalado a Lucía/Ramón
//   (spec §7, 6-oct). No lo decide el constructor.
// · Piezas de obra (sitios de clientes): ninguno de estos cinco servicios las produjo, y
//   mostrarlas acá sería prueba social inventada. Solo el pool honesto de fotografía.
import Layout from '../../../layouts/Layout.astro';
import { CONTACTO_V3 as CONTACTO, SERVICIOS_V3 } from '../../../consts-v3';
import NavV3 from '../../../components/v3/NavV3.astro';
import FooterV3 from '../../../components/v3/FooterV3.astro';
import Pieza from '../../../components/v3/Pieza.astro';
import '../../../styles/driftime.css';
import servicios from '../../../data/servicios-v3.json';

export function getStaticPaths() {
  return Object.keys(servicios).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;

// ------------------------------------------------------------------ correcciones al dato
// El JSON es compartido y no se edita desde una página: estas correcciones se aplican al
// dato ANTES de pintarlo, en todo el objeto, así lo visible y el JSON-LD dicen lo mismo
// (la FAQ visible y la FAQPage, el plan y su Offer). Quedan propuestas para el JSON.
// · Precio con UNA notación en toda la página (spec §3 .precio): «$590.000/mes + IVA». El
//   JSON trae «$590.000 /mes» en los planes y «590.000 CLP/mes» en la FAQ, contra la línea
//   bajo el h1. El JSON-LD sigue declarando priceCurrency CLP.
// · «Equipo dedicado»: SpindleLab es una consultoría unipersonal (contexto-agente-spindlelab.md,
//   línea 4). Es un plural de tamaño sin respaldo (antislop A9, innegociable), y además iba
//   dentro de la Offer que leen los motores de IA. QA independiente, 5-oct.
type Par = [RegExp | string, string | ((m: string, ...g: string[]) => string)];
const CORRIGE_TODOS: Par[] = [
  [/(\d{1,3}(?:\.\d{3})+) CLP/g, (_m, n) => `$${n}`],
  [/(\$\d{1,3}(?:\.\d{3})+) \/mes/g, '$1/mes'],
  // «Sin compromiso»: frase de folleto (spec §7, fila de Contacto); el cierre ya dice gratuito.
  // QA2, 6-oct. Estaba en los cierres de Auditoría y de Redes.
  [/ Sin compromiso\./g, ''],
];
// Segunda ronda (QA2, 6-oct). Un texto que queda vacío ('') es un punto de plan que se saca:
// se filtra al pintar.
const CORRIGE: Record<string, Par[]> = {
  'acompanamiento-mensual': [
    // «Prioridad y tiempos acordados» ya es la última píldora del mismo plan: la bajada no la repite.
    ['Equipo dedicado y varios frentes a la vez.', 'Varios frentes a la vez.'],
    ['Equipo dedicado y multi-servicio: todo lo del Pro', 'Multi-servicio: todo lo del Pro'],
  ],
  'auditoria-seo-tecnica': [
    // En esta página «chequeo» nombraba al mini-diagnóstico, y el pie llama «Chequeo gratis»
    // al automático de /v3/diagnostico/ (spec §7, fila de Nosotros; manual §08).
    ['Del chequeo gratis a la auditoría', 'Del mini-diagnóstico gratis a la auditoría'],
    // La nota de planes repetía, palabra por palabra, el cierre de la entrada (A10).
    [' Nada de un volcado de 200 hallazgos sin jerarquía.', ''],
    ['en móvil y escritorio', 'en celular y computador'],   // A7
    // El precio de la fila ya dice «Gratis»; «sin compromiso» es de folleto.
    ['Sin costo ni compromiso', ''],
  ],
  'redes-sociales': [
    // El «Sí.» viajaba al FAQPage sin decir desde qué plan: el Orgánico ($390.000) no trae
    // pauta (brief §3, manual §08).
    ['Sí. La gestión de la pauta social (social ads) es parte del servicio', 'Desde el plan Orgánico + Pauta. La gestión de la pauta social (social ads) es parte del servicio'],
    // «Motor» es jerga interna (B8): la página ya se la había sacado a la entrada.
    ['Más plataformas y volumen, integrado al resto del motor.', 'Más plataformas y más volumen.'],
    ['integrado con el resto del motor de adquisición', 'integrado con SEO, IA y Paid Media'],
    // «El creativo lo pones tú» iba cuatro veces (A10): sale de la nota de planes; queda en la
    // línea, en lo que incluye y en la FAQ.
    [', y en todos el creativo lo pones tú (o te conectamos con un partner).', '.'],
  ],
  'paid-media': [
    // Siete veces que el presupuesto es tuyo (A10): queda en la línea, la nota y la FAQ.
    ['El precio es el fee de gestión: estrategia, manejo de la cuenta, optimización con IA y reportes. La inversión en pauta la pones tú y la respetamos al peso, nunca la subimos sin tu confirmación. Mínimo 3 meses.',
      'El fee cubre la estrategia, el manejo de la cuenta, la optimización con IA y los reportes. Mínimo 3 meses.'],
    ['Inversión publicitaria aparte, bajo tu control', 'Inversión publicitaria aparte'],
    // Un solo «no a todo el mundo» (queda en lo que incluye).
    [', no hacia todo el mundo', ''],
    // «Motor» (B8), también en la Offer que leen los motores de IA.
    ['Integración con el resto del motor: ', 'Integración con tu SEO, redes y sitio: '],
    ['integrada al motor.', 'integrada a tu SEO y tu sitio.'],
    ['integración con el resto del motor.', 'integración con SEO, redes y sitio.'],
    ['La pauta acelera un motor que ya gira con el orgánico: ', 'La pauta acelera lo que el orgánico ya mueve: '],
    // Caja de oración, como el h1 de esa página (A6). Es el texto de un enlace (ENLACES).
    ['Gestión de Redes Sociales', 'Gestión de redes sociales'],
  ],
};
const pares: Par[] = [...CORRIGE_TODOS, ...(CORRIGE[slug!] ?? [])];
const corrige = (v: any): any =>
  typeof v === 'string' ? pares.reduce((a, [r, x]) => a.replace(r as any, x as any), v)
  : Array.isArray(v) ? v.map(corrige)
  : v && typeof v === 'object' ? Object.fromEntries(Object.entries(v).map(([k, x]) => [k, corrige(x)]))
  : v;
const s = corrige((servicios as Record<string, any>)[slug!]);

// ------------------------------------------------------------------ secciones por forma
const secs: any[] = s.secciones ?? [];
const secIncluye = secs.find((x) => Array.isArray(x.lista) && x.lista.length);
const secPlanes = secs.find((x) => Array.isArray(x.planes) && x.planes.length);
const secBloques = secs.find((x) => Array.isArray(x.bloques) && x.bloques.length);
// Las dos de párrafos: la primera titula las preguntas, la última es el cierre.
const conParrafos = secs.filter((x) => Array.isArray(x.parrafos));
const hFaq: string = conParrafos.length > 1 ? conParrafos[0].h2 : 'Preguntas frecuentes';
const secCierre = conParrafos.length ? conParrafos[conParrafos.length - 1] : null;
const faq: { p: string; r: string }[] = s.faq ?? [];

// ------------------------------------------------------------------ texto
const comillas = (t: string) => t.replace(/"([^"]+)"/g, '«$1»');
const mayus = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const sinPunto = (t: string) => t.replace(/\.\s*$/, '');
// Restos de la extracción a JSON: el texto de un enlace quedó repetido en la frase. Está
// igual en la página publicada; se corrige acá y se propone corregir el JSON.
const LIMPIEZA: [RegExp, string][] = [
  [/con nuestro protocolo público, protocolo público\./, 'con nuestro protocolo público.'],
  [/con el protocolo público de medición, nuestro protocolo público y reproducible/, 'con nuestro protocolo público y reproducible'],
];
const limpia = (t: string) => LIMPIEZA.reduce((a, [r, x]) => a.replace(r, x), comillas(t));
// «Rastreo e indexación: qué puede ver Google…» → título + cuerpo, como en la publicada
// (allá el título iba en <b>).
const partir = (t: string) => {
  const i = t.indexOf(': ');
  return i > 0 && i <= 90 ? { t: t.slice(0, i), d: mayus(limpia(t.slice(i + 2))) } : { t: '', d: limpia(t) };
};

// ------------------------------------------------------------------ enlaces en el texto corrido
// Una página que el texto nombra va enlazada (web-qa-critico paso 3), y «protocolo público»
// es una afirmación que la página tiene que dejar comprobar (manual §08): en la publicada
// enlazaba a /diagnostico/#medicion-mensual; en la v3 ese texto vive en /v3/diagnostico/,
// sección «Lo que este chequeo no mide.» (#s-nom). QA2, 6-oct.
// Solo en lo visible: el FAQPage sigue en texto plano. Cada frase se enlaza una vez por página
// (la primera), y nunca hacia la misma página. El texto se escapa ANTES de insertar el <a>, así
// que set:html es seguro aunque el dato venga del JSON.
const ENLACES: [string, string][] = [
  ['protocolo público', '/v3/diagnostico/#s-nom'],
  ['servicio de acompañamiento mensual', '/v3/servicios/acompanamiento-mensual/'],
  ['Gestión de redes sociales', '/v3/servicios/redes-sociales/'],
  ['Paid Media (Google)', '/v3/servicios/paid-media/'],
];
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const enlazadas = new Set<string>();
const enlaza = (t: string) =>
  ENLACES.reduce((a, [frase, href]) => {
    if (enlazadas.has(frase) || href === `/v3/servicios/${slug}/` || !a.includes(frase)) return a;
    enlazadas.add(frase);
    return a.replace(frase, `<a class="d-enl-svc" href="${href}">${frase}</a>`);
  }, esc(t));

// ------------------------------------------------------------------ lo propio de cada servicio
type Img = { src: string; alt: string; w: number; h: number; pos?: string; etq?: string };
const IMG: Record<string, Img> = {
