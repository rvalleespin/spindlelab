---
// PLANTILLA DE PÁGINA INTERNA — Desarrollo Web, en el lenguaje V3.
//
// Es la primera interna y sirve de molde para las otras 18. Se eligió esta porque es el
// pilar del negocio y la que recibe al prospecto que viene a comprar un sitio.
//
// LO QUE HAY QUE SABER ANTES DE REPLICAR:
// Las internas de producción NO son Astro: son HTML estático en public/ con su propio
// assets/css/style.css escrito a mano. Esta página las reconstruye sobre el Layout + Tailwind
// del sistema V3. El contenido es el REAL de la página publicada, no inventado.
//
// LA CAPA SEO SE CONSERVA. El grafo de producción trae 5 nodos (ProfessionalService, Person,
// Service, BreadcrumbList, FAQPage). Acá se inyectan solo los 3 específicos de la página:
// la organización y la persona ya las emite Layout.astro, y repetirlas duplicaría @id.
// Las URLs del grafo apuntan a producción a propósito: es lo que iría al publicar.
//
// ⚠️ DEFECTO DE COPY ENCONTRADO EN PRODUCCIÓN: la respuesta a «¿Cuánto cuesta?» empieza con
// «Sí.», que es un resto de una pregunta de sí/no anterior. Acá va sin ese «Sí»; hay que
// corregirlo también en la página publicada.
import Layout from '../../../layouts/Layout.astro';
import { caja } from '../../../utils/caja';
import { CONTACTO_V3 as CONTACTO } from '../../../consts-v3';
import NavV3 from '../../../components/v3/NavV3.astro';
import FooterV3 from '../../../components/v3/FooterV3.astro';
import Pieza from '../../../components/v3/Pieza.astro';
import '../../../styles/driftime.css';
import obra from '../../../data/obra-v3.json';


const incluye = [
  'Legible para motores de IA desde el primer commit: datos estructurados, contenido citable e indexación.',
  'El mismo chequeo que corres gratis en la portada, pasado sobre tu sitio antes de entregarlo.',
  'Un panel para editar textos e imágenes tú mismo, sin depender de nadie.',
  'Código propio y diseño a medida, con control total del rendimiento.',
  'Construcción con IA, revisión humana en cada fase antes de avanzar.',
  'Dominio, SSL, analítica y 30 días de garantía post-lanzamiento.',
];

// Precios EXACTOS a los publicados. Todos + IVA.
const planes = [
  {
    nombre: 'Página de Campaña',
    precio: 'desde $390.000',
    linea: 'Una página hecha para convertir la pauta que ya estás pagando.',
    puntos: ['Una página, para una campaña y una oferta', 'Diseño a medida, sin plantilla', 'SEO técnico y medición desde el primer día', 'Entrega en ~1 semana'],
  },
  {
    nombre: 'Sitio Esencial',
    precio: 'desde $690.000',
    linea: 'Un sitio a medida, listo para funcionar.',
    puntos: ['Home y hasta 5 páginas', 'SEO técnico base: schema, velocidad, indexación', 'Un idioma', 'Entrega en ~3 semanas'],
  },
  {
    nombre: 'Sitio Completo',
    precio: 'desde $1.190.000',
    linea: 'Más páginas y puesto a punto para que la IA te lea.',
    puntos: ['Home y hasta 12 páginas', 'Blog o CMS que administras tú', 'SEO técnico y puesta a punto AEO/GEO', 'Uno o dos idiomas', 'Entrega en ~4 a 6 semanas'],
  },
  {
    nombre: 'Plataforma a Medida',
    precio: 'Se cotiza',
    linea: 'Para proyectos con integraciones o lógica propia.',
    puntos: ['Todo lo del Sitio Completo, y más', 'Páginas sin tope', 'Integraciones: CRM, reservas, pagos', 'Arquitectura propia', 'Multi-idioma'],
  },
];

const fases = [
  { n: '01', t: 'Descubrimiento', d: 'Conversamos sobre tu negocio, tu marca y qué necesita comunicar el sitio. Definimos la dirección de diseño con referentes concretos de tu rubro.' },
  { n: '02', t: 'Diseño', d: 'Proponemos las páginas clave (home y una página tipo) antes de escribir una sola línea de código. Ajustamos hasta que el diseño te representa.' },
  { n: '03', t: 'Desarrollo con IA', d: 'Construimos el sitio con el agente de desarrollo de SpindleLab, con supervisión técnica humana en cada avance. Sigues el progreso en una URL de prueba.' },
  { n: '04', t: 'QA y contenido', d: 'Cargamos tu contenido final, probamos en distintos dispositivos, afinamos rendimiento y SEO, y hacemos las rondas de revisión incluidas en tu plan.' },
  { n: '05', t: 'Lanzamiento', d: 'Configuramos dominio, SSL y analítica, y publicamos en producción. Quedas con 30 días de garantía para corregir errores de funcionamiento.' },
];

const faq = [
  {
    p: '¿Usan plantillas o WordPress?',
    r: 'No. Cada sitio se construye con código propio, a medida. Sin temas genéricos ni page builders: control total sobre rendimiento, diseño y SEO técnico.',
  },
  {
    p: '¿Cuánto cuesta?',
    r: 'Cada pack tiene un precio de partida («desde»): Página de Campaña desde $390.000 + IVA, Sitio Esencial desde $690.000 + IVA y Sitio Completo desde $1.190.000 + IVA; la Plataforma a Medida se cotiza tras una reunión. El valor final se cierra tras el diagnóstico gratuito, según las páginas y funcionalidades que necesites. Sin sorpresas.',
  },
  {
    p: '¿Cómo afecta el desarrollo con IA a la calidad?',
    r: 'La ejecución asistida por IA reduce tiempos, no supervisión: cada fase pasa por revisión humana antes de avanzar a la siguiente. La velocidad se traduce en plazos más cortos, no en menos control de calidad.',
  },
  {
    p: '¿El sitio incluye SEO?',
    r: 'Sí, de base: rendimiento, datos estructurados y arquitectura pensados desde el diseño. Si además necesitas visibilidad en motores de IA, ese trabajo se profundiza con el servicio de Visibilidad en IA.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://spindlelab.cl/servicios/desarrollo-web/#service',
      name: 'Desarrollo Web',
      serviceType: 'Desarrollo web a medida',
      provider: { '@id': 'https://spindlelab.cl/#org' },
      areaServed: { '@type': 'Country', name: 'Chile' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Planes de Desarrollo Web',
        itemListElement: [
          { '@type': 'Offer', name: 'Página de Campaña', description: 'Una página a medida pensada para una campaña y una oferta, con SEO técnico y medición desde el primer día. Entrega en ~1 semana.', priceSpecification: { '@type': 'PriceSpecification', minPrice: 390000, priceCurrency: 'CLP', valueAddedTaxIncluded: false } },
          { '@type': 'Offer', name: 'Sitio Esencial', description: 'Home y hasta 5 páginas, SEO técnico base, un idioma. Entrega en ~3 semanas.', priceSpecification: { '@type': 'PriceSpecification', minPrice: 690000, priceCurrency: 'CLP', valueAddedTaxIncluded: false } },
          { '@type': 'Offer', name: 'Sitio Completo', description: 'Home y hasta 12 páginas, blog/CMS, SEO técnico y puesta a punto AEO/GEO. Entrega en ~4 a 6 semanas.', priceSpecification: { '@type': 'PriceSpecification', minPrice: 1190000, priceCurrency: 'CLP', valueAddedTaxIncluded: false } },
          { '@type': 'Offer', name: 'Plataforma a Medida', description: 'Todo lo del Sitio Completo y más: páginas sin tope, integraciones a medida, arquitectura propia, multi-idioma. Se cotiza tras una reunión.' },
        ],
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://spindlelab.cl/servicios/desarrollo-web/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://spindlelab.cl/' },
        { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://spindlelab.cl/servicios/' },
        { '@type': 'ListItem', position: 3, name: 'Desarrollo Web' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://spindlelab.cl/servicios/desarrollo-web/#faq',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.p,
        acceptedAnswer: { '@type': 'Answer', text: f.r },
      })),
    },
  ],
};

// La galería sale del mismo dato que /v3/trabajo/ y la fila del hero de la home.
const rotuloTipo: Record<string, string> = { cliente: 'Cliente', propio: 'Producto propio', concepto: '' };
// La primera va a sangre como pantalla plana; las otras, en dispositivo (los mockups
// calzan con la forma: alta = teléfono, media = notebook + teléfono en 4:3).
const enDispositivo = (c: any, i: number) => (i === 1 ? { src: c.mockAlto, alt: c.altMock } : i > 1 ? { src: c.mock, alt: c.altMock } : { src: c.img, alt: c.alt });
const piezas = obra.casos.map((c: any, i: number) => ({
  ...enDispositivo(c, i), concepto: c.tipo === 'concepto',
  etiquetas: [c.tipo === 'concepto' ? `${c.n} · ${c.rubro}` : `${c.n} · ${rotuloTipo[c.tipo] ?? c.rubro}`],
}));
// Grilla asimétrica: ancha, alta + media, media + alta (como los casos de driftime).
const forma = ['d-g-ancha', 'd-g-alta', 'd-g-media', 'd-g-media'];
---
<Layout
  title="Desarrollo web que los motores de IA pueden leer · SpindleLab"
  description="Sitios construidos para que los motores de IA puedan leerlos y citarlos, con el SEO técnico desde el primer commit. Lo compruebas con el chequeo gratis."
  bodyClass="d-body"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <NavV3 />

  {/* Plantilla «servicio» = el caso de driftime (spec §4). Sin display: las internas
       tienen cero usos de Manrope 800 en mayúsculas. Tablero: tableros/driftime-desarrollo */}
  <main>
    <header class="d-cab">
      <p class="d-miga"><a href="/v3/">Inicio</a> · <a href="/v3/servicios/">Servicios</a> · Desarrollo Web</p>
      <h1 class="d-h1">Desarrollo web que los motores de IA pueden leer</h1>
      <p class="d-linea">Sitios a medida con el SEO técnico puesto desde el primer commit. Tres planes, desde $390.000 + IVA.</p>
      <div class="d-btns"><a class="d-btn" href="#planes">Ver planes</a><a class="d-btn d-btn--alt" href={CONTACTO}>Escríbenos</a></div>
    </header>

    <figure class="d-sangre"><img src="/assets/img/d/escritorio.jpg" alt="Escritorio de madera junto a la ventana, con un laptop, un cuaderno abierto y una taza" width="1600" height="670" loading="eager" fetchpriority="high" /></figure>

    <div class="d-entrada">
      <p class="d-nota-card"><b>Valores en pesos, + IVA.</b> El valor final se cierra tras el diagnóstico gratuito.</p>
      <p class="d-guia">A veces el problema no es lo que se audita: es lo que hay que reconstruir. Construimos el sitio para que las máquinas que hoy recomiendan tu negocio puedan leerlo, y te lo demostramos con el mismo chequeo sobre tu dominio.</p>
    </div>

    <section class="d-sec" aria-labelledby="s-inc">
      <div class="d-eti"><h2 class="d-h2" id="s-inc">Todo parte con esto</h2></div>
      <div class="d-filas">{incluye.map((t) => <p class="d-guia">{t}</p>)}</div>
    </section>

    <section class="d-galeria" aria-labelledby="s-obra">
      <div class="d-galeria__cab"><h2 class="d-h2" id="s-obra">Sitios que ya construimos</h2><a class="d-btn d-btn--alt" href="/v3/trabajo/">Ver el trabajo</a></div>
      {piezas.map((pz, i) => <Pieza src={pz.src} alt={pz.alt} concepto={pz.concepto} etiquetas={pz.etiquetas} clase={forma[i] ?? 'd-g-mitad'} posicion="50% 25%" />)}
      {/* Cierra la grilla: media (Raigal) + alta. Sin esto queda un hueco a la derecha. */}
      <Pieza src="/assets/img/d/ventana.jpg" alt="Mesa de trabajo junto a una ventana con cortinas, con un cuaderno abierto y un laptop" clase="d-g-alta" posicion="70% 50%" />
    </section>

    <section class="d-sec" id="planes" aria-labelledby="s-pla">
      <div class="d-eti"><h2 class="d-h2" id="s-pla">Elige por dónde partir</h2><p class="d-chico">Valores en pesos, + IVA. El valor final se cierra tras el diagnóstico gratuito.</p></div>
      <div class="d-filas">
        {planes.map((p) => (
          <div class="d-plan">
            <h3 class="d-h3">{p.nombre}</h3><span class="d-plan__precio">{p.precio}</span>
            <p class="d-cuerpo">{p.linea}</p>
            <ul>{p.puntos.map((x) => <li>{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <section class="d-sec" aria-labelledby="s-fas">
      <div class="d-eti"><h2 class="d-h2" id="s-fas">Cinco fases, apruebas cada una</h2></div>
      <div class="d-filas">
        {fases.map((f) => (
          <div class="d-fase"><span class="d-fase__n">{f.n}</span><h3 class="d-h3">{f.t}</h3><p class="d-cuerpo">{f.d}</p></div>
        ))}
      </div>
    </section>

    <section class="d-sec d-faq" aria-labelledby="s-faq">
      <div class="d-eti"><h2 class="d-h2" id="s-faq">Sobre el desarrollo</h2></div>
      <div class="d-filas">
        {faq.map((f) => (<div><h3 class="d-h3">{f.p}</h3><p class="d-cuerpo">{f.r}</p></div>))}
      </div>
    </section>

    <a class="d-siguiente" href="/v3/servicios/visibilidad-en-ia/"><span class="d-chico d-gris">Siguiente</span><span class="d-h1">Visibilidad en IA →</span></a>
  </main>

  <FooterV3 />
</Layout>
