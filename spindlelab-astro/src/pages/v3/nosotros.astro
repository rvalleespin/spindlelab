---
// NOSOTROS en el lenguaje v3.
//
// El brief (Bloque 6) la marca como ventaja competitiva no obvia: las dos agencias
// revisadas son «agencias» sin rostro. Una persona con nombre y trayectoria verificable es
// justo lo que vende la marca, así que esta página no se toca en contenido, se traduce.
//
// EL TEXTO VA VERBATIM. Es la biografía real de Ramón, con empleadores y estudios
// concretos: no es copy que se reescriba por gusto. Solo cambia el envase.
//
// REGISTRO: la página entera va en PRIMERA PERSONA SINGULAR, que es lo correcto según el
// manual §07 (singular para lo observacional y lo personal). Ojo con esto al editarla.
//
// ⚠️ HALLAZGO DE VOZ, no corregido a propósito: el texto publicado mezcla los dos
// registros. El cuerpo va en singular («Soy Ramón», «Antes pasé», «Reviso tu sitio») pero
// dos frases saltan a plural: «Conectamos las piezas» y «Te lo mostramos». El manual dice
// que nunca se mezclan en la misma pieza. No lo reescribo solo: es la biografía de Ramón
// y la decisión es suya.
import Layout from '../../layouts/Layout.astro';
import { CONTACTO_V3 as CONTACTO } from '../../consts-v3';
import NavV3 from '../../components/v3/NavV3.astro';
import FooterV3 from '../../components/v3/FooterV3.astro';
import '../../styles/campos-v3.css'; // tintes de color, filete, rotulo


const url = 'https://spindlelab.cl/nosotros/';

const bio = [
  'Soy Ramón Vallejos. SpindleLab soy yo al frente, orquestando el motor, con agentes de IA a mi lado y partners para lo que no hacemos en casa.',
  'Antes pasé más de cinco años en agencias. Empecé en Universal McCann, coordinando la producción de piezas para ocho marcas nacionales. En Graphene IPG trabajé la cuenta de LATAM Airlines, con campañas en Chile, Perú, Ecuador y Colombia. Después vino la pauta de retail y B2B en Incrementa, y el contenido y el SEO de una cartera B2B en Maggiore. Estudié Comunicación Publicitaria en la Universidad Andrés Bello y un máster en Marketing Digital y E-commerce en la Universidad de Barcelona.',
  'En las empresas que reviso pasa casi siempre lo mismo. Uno hizo el sitio, otro lleva las redes, otro la pauta, y ninguno mira si la IA te nombra.',
  'Te lo cuento porque con esa experiencia puedo hacerme cargo del eje de tu operación y poner el motor a funcionar entero, no por partes. Conectamos las piezas en un solo sistema y las medimos juntas, con el orgánico como eje, porque es lo que no se apaga cuando cortas el presupuesto.',
  'El objetivo no es solo que vendas. Es que cuando alguien pregunte por tu rubro, tu nombre ya esté ahí.',
  'Lo primero es un chequeo. Reviso tu sitio, tu contenido y si la IA te nombra, y te entrego en una página qué te frena y qué mueve la aguja. Gratis, en 24 horas. Con eso decides con información, no a ciegas.',
];

const puntos = [
  { t: 'Diagnóstico antes que contrato', d: 'Antes de cobrarte nada, reviso tu sitio y tu presencia en IA y te muestro los hallazgos en una página. Gratis, en 24 horas.' },
  { t: 'Arreglo lo técnico y lo legible', d: 'SEO técnico, datos estructurados y contenido que la IA pueda citar. No hay que rehacer tu sitio. Hay que hacerlo legible.' },
  { t: 'Mido si te recomiendan', d: 'Registro si ChatGPT, Gemini y Perplexity te nombran ante las preguntas de tus clientes. Con fecha, no de memoria. Nada de métricas de vanidad.' },
  { t: 'Sin humo', d: 'No prometo primeros lugares. Nadie puede garantizarlos. Te digo qué se puede mover y qué no, y me hago cargo de lo que sí.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${url}#aboutpage`,
      url,
      name: 'Nosotros · SpindleLab',
      mainEntity: { '@id': 'https://spindlelab.cl/#autor-ramon' },
      about: { '@id': 'https://spindlelab.cl/#autor-ramon' },
      isPartOf: { '@id': 'https://spindlelab.cl/#website' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://spindlelab.cl/' },
        { '@type': 'ListItem', position: 2, name: 'Nosotros' },
      ],
    },
  ],
};
---

<Layout
  title="Ramón Vallejos, consultor de SEO técnico e IA · SpindleLab"
  description="Detrás de SpindleLab está Ramón Vallejos: SEO técnico y visibilidad en motores de IA, con evidencia antes que promesas. Chequeo gratis en 24 horas."
  bodyClass="bg-noche font-texto"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <NavV3 />

  <main class="text-papel">
    <section class="px-6 md:px-medianil pt-32 sm:pt-40 md:pt-44 pb-16 md:pb-24">
      <nav aria-label="Migas" class="text-humo text-xs font-bold uppercase mb-8" style="letter-spacing:0.16em">
        <a href="/v3/" class="hover:text-papel transition-colors">Inicio</a>
        <span aria-hidden="true" class="mx-2">·</span>
        <span class="text-humo">Nosotros</span>
      </nav>
      <h1
        class="font-extrabold uppercase m-0 max-w-[14ch]"
        style="font-size:clamp(1.875rem, 5.6vw, 5.5rem); line-height:0.9; letter-spacing:0"
      >
        No te prometo. Te muestro.
      </h1>

      <div class="mt-12 flex items-center gap-5">
        <img
          src="/assets/img/ramon-vallejos.jpg"
          alt="Ramón Vallejos, consultor de SpindleLab"
          width="896"
          height="1200"
          loading="eager"
          decoding="async"
          class="shrink-0 w-20 h-24 rounded-lg border filete object-cover object-top"
        />
        <div>
          <p class="text-base font-bold text-papel m-0">Ramón Vallejos</p>
          <p class="text-sm text-humo m-0 mt-1">
            Consultor de SEO técnico y visibilidad en IA · Chile
          </p>
        </div>
      </div>
    </section>

    <!-- LA BIOGRAFÍA, en papel. Texto verbatim del publicado. -->
    <section class="bg-papel text-noche px-6 md:px-medianil py-32 md:py-seccion">
      <div class="max-w-prosa space-y-6">
        {
          bio.map((p, i) => (
            <p class={i === 0 ? 'text-xl md:text-2xl leading-relaxed m-0' : 'text-lg leading-relaxed text-noche/70 m-0'}>
              {p}
            </p>
          ))
        }
      </div>
    </section>

    <!-- CÓMO TRABAJO, en campo navy. Los cuatro puntos van en singular. -->
    <section class="tinte--navy px-6 md:px-medianil py-32 md:py-seccion">
      <h2
        class="font-extrabold uppercase m-0 mb-12 md:mb-16"
        style="font-size:clamp(1.5rem, 4.4vw, 4rem); line-height:0.94; letter-spacing:0"
      >
        Cómo trabajo
      </h2>
      <div class="grid gap-x-8 lg:gap-x-12 gap-y-10 md:grid-cols-2">
        {
          puntos.map((p) => (
            <article class="border-t filete pt-6">
              <h3
                class="font-extrabold uppercase m-0"
                style="font-size:clamp(1.125rem,1.8vw,1.625rem); line-height:1.1; letter-spacing:-0.03em"
              >
                {p.t}
              </h3>
              <p class="mt-4 text-humo text-base leading-relaxed">{p.d}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="px-6 md:px-medianil py-32 md:py-seccion">
      <h2
        class="font-extrabold uppercase m-0 max-w-[15ch]"
        style="font-size:clamp(1.75rem, 5.2vw, 5rem); line-height:0.92; letter-spacing:0; text-wrap:balance"
      >
        ¿Apareces cuando preguntan?
      </h2>
      <p class="mt-8 text-humo text-xl leading-relaxed max-w-prosa">
        Te lo muestro. Chequeo real, gratis, en 24 horas. Antes de que pagues nada.
      </p>
      <div class="mt-12 flex items-center gap-4 flex-wrap">
        <a
          href="/v3/#chequeo"
          class="rounded-v3 bg-papel hover:bg-white text-noche text-sm font-bold px-8 py-4 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-papel"
        >
          Correr el chequeo
        </a>
        <a
          href={CONTACTO}
          class="rounded-v3 border filete hover:border-papel text-papel text-sm font-bold px-8 py-4 transition-colors"
        >
          Escríbeme
        </a>
      </div>
    </section>
  </main>

  <FooterV3 />
</Layout>
