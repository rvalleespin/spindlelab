---
// EL ÍNDICE DEL BLOG SOBRE A · ARCHIVO (obra E12, corrida 2, tanda 5). Diego, 19-oct-2026.
//
// Contrato: spindlelab-v3/spec-visual.md §2.5: el /latest de Koto sin sus imágenes. Desde 1194, la barra lateral de
// 320 px (miga, h1 en dos tintas, «(7)» y la línea de Clara); a la derecha, los siete como filas, del más reciente al
// más antiguo, con borde superior: la fecha y el tema en dato mono en la mitad izquierda, el título a Título, enlazado y
// con la flecha, en la derecha. Al final, el cierre del blog. Bajo 1194, una columna. Sin imágenes (§3.4: interiores).
//
// Los datos los arma indiceBlog() en blog.mjs (títulos y fechas de data/blog-v3/_indice.json, el tema del byline de
// cada artículo, el texto de Clara). Señales de Simón, senales-obra.md §2.9: el grafo de hoy queda.
import Layout from '../../../layouts/Layout.astro';
import PaginaA from '../../../components/a/PaginaA.astro';
import Miga from '../../../components/a/Miga.astro';
import Icono from '../../../components/a/Icono.astro';
import { LAYOUT_A } from '../../../components/a/layout-a';
import { indiceBlog } from '../../../data/archivo/blog.mjs';

const m = indiceBlog();
---
<Layout title={m.title} description={m.description} ogImage={m.og.src} ogImageAlt={m.og.alt} {...LAYOUT_A}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(m.jsonLd)} />
  <PaginaA>
    <div class="indice indice--blog">
      <div class="indice__lateral">
        <Miga items={[{ texto: m.miga[0], href: '/v3/' }, { texto: m.miga[1] }]} />
        <h1 class="t-titulo"><span class="tinta">{m.h1.tinta}</span> <span class="gris">{m.h1.gris}</span></h1>
        <p class="rotulo">{m.conteo}</p>
        <p class="chico">{m.linea}</p>
      </div>
      <div class="blog__columna">
        <ol class="filas-blog" aria-label="Artículos, del más reciente al más antiguo">
          {m.filas.map((f) => (
            <li class="fila-blog">
              <p class="dato"><time datetime={f.iso}>{f.fecha}</time> · {f.tema}</p>
              <h2 class="t-titulo"><a class="subrayado" href={f.href}>{f.titulo}<Icono nombre="flecha" /></a></h2>
            </li>
          ))}
        </ol>
        <section class="blog-cierre" aria-labelledby="h-cierre">
          <h2 class="t-declaracion" id="h-cierre">{m.cierre.h2}</h2>
          <p class="cuerpo caja">{m.cierre.guia}</p>
          <p class="cuerpo caja">{m.cierre.cuerpo}</p>
          <div class="botones">
            <a class="boton boton--claro" href={m.cierre.botones[0].href}>{m.cierre.botones[0].texto}<Icono nombre="flecha" /></a>
            <a class="boton boton--placa" href={m.cierre.botones[1].href}>{m.cierre.botones[1].texto}</a>
          </div>
        </section>
      </div>
    </div>
  </PaginaA>
</Layout>
