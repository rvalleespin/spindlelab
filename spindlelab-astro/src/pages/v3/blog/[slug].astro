---
// LOS 7 POSTS DEL BLOG — sistema driftime (5-oct-2026).
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md, §4 plantilla
// «Artículo»: miga · h1 60 px · tema · fecha · lectura · autor → imagen editorial → etiqueta
// pegajosa con el índice del artículo + cuerpo verbatim a la derecha → cierre (chequeo +
// Escríbenos) → siguiente artículo → pie. El autor y el cierre entraron a la spec el 5-oct
// (QA): estaban construidos sin declarar, o faltaban.
// Implementación de referencia: v3/servicios/desarrollo-web.astro (d-cab, d-sangre, d-sec,
// d-siguiente). Sin display: las internas tienen cero Manrope 800 en mayúsculas.
//
// EL CUERPO VA VERBATIM. Cada data/blog-v3/<slug>.html es el HTML publicado tal cual. Se
// parte en dos, sin retipear nada:
//   · la CABEZA (miga, h1, línea de autor) se lee del archivo y se vuelve a montar en la
//     cabecera d-cab, con las mismas palabras. Tiene que salir de ahí porque la plantilla
//     pone el h1 ARRIBA de la imagen, y dejarlo además dentro del cuerpo daría dos h1.
//     La miga es la excepción declarada (spec §7): «Inicio · Blog · <nombre corto>»; del
//     archivo sale solo el nombre corto («Chequeo gratis» no es padre del post y «El
//     Taller» se llama «Blog» en todo el v3).
//   · el bloque .prose (todo lo que se lee) se inyecta entero en la columna derecha. Lo
//     único que se le toca son atributos, nunca texto: los href internos pasan a /v3/,
//     los h2 que no traen id reciben uno, para el índice, y un índice en prosa («En esta
//     guía: …») lleva `hidden` cuando ya está el pegajoso.
// Si un post nuevo no trae esa estructura, el build se cae con el nombre del archivo: es
// preferible a publicar una página con dos h1 o sin cuerpo.
//
// EL SCHEMA NO SE REINVENTA: el grafo de cada post (Article + BreadcrumbList + FAQPage) sale
// del publicado. Layout.astro emite SIEMPRE #org y #autor-ramon, en su versión completa; el
// post traía una copia más corta de los dos (sin makesOffer, knowsAbout, alumniOf ni url) y
// salían dos veces en el HTML. Se filtran ACÁ, al serializar, como hace la referencia
// (servicios/desarrollo-web.astro): Layout no se toca. Comparados campo por campo en los
// siete posts, los nodos del post son un subconjunto exacto de los del Layout: no se pierde
// nada. author y publisher del Article siguen apuntando por @id a los nodos del Layout.
// La miga del grafo dice «Blog» (no «El Taller»): la misma palabra de la miga visible, del
// menú y del BreadcrumbList de /v3/blog/ (QA 5-oct, antislop C8).
import Layout from '../../../layouts/Layout.astro';
import NavV3 from '../../../components/v3/NavV3.astro';
import FooterV3 from '../../../components/v3/FooterV3.astro';
import Miga from '../../../components/v3/Miga.astro';
import { CONTACTO_V3 as CONTACTO, OG_V3 } from '../../../consts-v3';
import '../../../styles/driftime.css';
import indice from '../../../data/blog-v3/_indice.json';

const cuerpos = import.meta.glob('../../../data/blog-v3/*.html', { query: '?raw', import: 'default', eager: true });
const datos = import.meta.glob('../../../data/blog-v3/*.json', { eager: true });

function slugDe(ruta: string) {
  return ruta.split('/').pop()!.replace(/\.(html|json)$/, '');
}

export function getStaticPaths() {
  const d = import.meta.glob('../../../data/blog-v3/*.json', { eager: true });
  return Object.keys(d)
    .map((r) => r.split('/').pop()!.replace('.json', ''))
    .filter((s) => s !== '_indice')
    .map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const crudo = Object.entries(cuerpos).find(([r]) => slugDe(r) === slug)?.[1] as string;
const entrada = Object.entries(datos).find(([r]) => slugDe(r) === slug)?.[1] as any;
const info = entrada?.default ?? entrada;
const meta = info.meta;

// ---------------------------------------------------------------- la cabeza del post
const MARCA_PROSA = '<div class="prose">';
const iProsa = crudo.indexOf(MARCA_PROSA);
if (iProsa < 0) throw new Error(`blog-v3/${slug}.html: no trae el bloque <div class="prose">`);
const cabeza = crudo.slice(0, iProsa);

const h1 = cabeza.match(/<h1[^>]*>([\s\S]*?)<\/h1>/)?.[1].trim();
if (!h1) throw new Error(`blog-v3/${slug}.html: no trae <h1>`);
// El último eslabón de la miga publicada es el nombre corto del post.
const migaCorta = [...(cabeza.match(/<nav class="crumbs"[\s\S]*?<\/nav>/)?.[0] ?? '').matchAll(/<li>([\s\S]*?)<\/li>/g)].pop()?.[1].trim();
const migaTexto = (migaCorta ?? '').replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').trim();
const byline = cabeza.match(/<p class="byline">([\s\S]*?)<\/p>/)?.[1] ?? '';
// Tema en caja de oración (antislop A6): el byline publicado de fintechs dice «SEO Técnico».
// Se corrige al leer, sin tocar el HTML publicado que guarda data/blog-v3/. Revisión cruzada, 6-oct.
const TEMA_CAJA: Record<string, string> = { 'SEO Técnico': 'SEO técnico' };
const temaPublicado = byline.match(/<b>([\s\S]*?)<\/b>/)?.[1].trim();
const tema = temaPublicado ? TEMA_CAJA[temaPublicado] ?? temaPublicado : temaPublicado;
const [fechaPublicada, lectura] = [...byline.matchAll(/<span>([\s\S]*?)<\/span>/g)].map((m) => m[1].trim());
// La fecha visible sale de meta.datePublished y no del byline, que trae la coma del inglés
// antes del año («7 de julio, 2026»): «7 de julio de 2026» (antislop A7). Revisión cruzada, 6-oct.
const fechaVisible = meta.datePublished
  ? new Date(String(meta.datePublished).slice(0, 10) + 'T12:00:00').toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' })
  : fechaPublicada;

// El grafo del post, sin los nodos que ya emite el Layout y con la miga que se ve: posición 2
// «Blog» y posición 3 el nombre corto de la miga visible, de la misma fuente (revisión
// cruzada, 6-oct: en fintechs el grafo decía «… fintechs chilenas» y la miga «… fintechs»;
// las otras seis coincidían por casualidad). Spec §7, regla del artículo.
const DEL_LAYOUT = new Set(['https://spindlelab.cl/#org', 'https://spindlelab.cl/#autor-ramon']);
const ld = {
  ...info.jsonLd,
  '@graph': info.jsonLd['@graph']
    .filter((n: any) => !DEL_LAYOUT.has(n['@id']))
    // La imagen del Article es la de compartir: la de la v3, no la de la marca anterior.
    .map((n: any) => (n.image === 'https://spindlelab.cl/assets/img/og-marca.jpg?v=4' ? { ...n, image: new URL(OG_V3.imagen, 'https://spindlelab.cl').href } : n))
    .map((n: any) =>
      n['@type'] === 'BreadcrumbList'
        ? { ...n, itemListElement: n.itemListElement.map((it: any) => (it.position === 2 ? { ...it, name: 'Blog' } : it.position === 3 && migaTexto ? { ...it, name: migaTexto } : it)) }
        : n,
    ),
};

const autorBloque = cabeza.match(/<div class="author">([\s\S]*?)<\/div>\s*<\/div>/)?.[1] ?? '';
// AVATAR (QA final, técnica #8): el post publicado pinta el retrato entero (896 × 1200, 193 KB)
// en 44 px. Va la miniatura de 132 × 132 (44 × 3, el mismo encuadre cuadrado y centrado que
// object-fit: cover sacaba del retrato) y alt vacío: el nombre está escrito al lado, y con el
// alt del post el lector de pantalla decía «Ramón Vallejos» dos veces.
const AVATAR: Record<string, string> = { '/assets/img/ramon-vallejos.jpg': '/assets/img/ramon-vallejos-avatar.jpg' };
const srcAutor = autorBloque.match(/<img[^>]*\bsrc="([^"]+)"/)?.[1];
const autor = {
  src: srcAutor ? AVATAR[srcAutor] ?? srcAutor : undefined,
  alt: '',
  nombre: autorBloque.match(/<p class="author-name">([\s\S]*?)<\/p>/)?.[1].trim(),
  rol: autorBloque.match(/<p class="author-role">([\s\S]*?)<\/p>/)?.[1].trim(),
};

// ---------------------------------------------------------------- el cuerpo, verbatim
// Del <div class="prose"> hasta su cierre: el archivo termina en «</div> </div>» (prose y
// el contenedor .wrap), y lo que queda después del segundo cierre tiene que ser vacío.
const iCierreWrap = crudo.lastIndexOf('</div>');
const iCierreProsa = crudo.lastIndexOf('</div>', iCierreWrap - 1);
if (crudo.slice(iCierreWrap + 6).trim() || crudo.slice(iCierreProsa + 6, iCierreWrap).trim()) {
  throw new Error(`blog-v3/${slug}.html: el bloque .prose no cierra donde se espera`);
}
const prosa = crudo.slice(iProsa + MARCA_PROSA.length, iCierreProsa);

// LOS ENLACES INTERNOS APUNTAN AL SITIO VIVO (/blog/, /diagnostico/, /servicios/...). Dentro
// de la maqueta te sacarían del v3. Se reescriben SOLO los prefijos que existen en v3; lo
// que no está en la lista se deja como estaba, para no inventar destinos.
const RUTAS = ['blog', 'servicios', 'diagnostico', 'contacto', 'metodo', 'nosotros'];
const cuerpo = prosa
  .replace(new RegExp(`href="/(${RUTAS.join('|')})/`, 'g'), 'href="/v3/$1/')
  .replace(/href="\/"/g, 'href="/v3/"');

// ÍNDICE DEL ARTÍCULO. De los siete posts, solo uno trae id en sus h2: el id se genera en el
// build a partir del texto y se RESPETA el que ya venga (un enlace guardado no se rompe).
// En el build y no en el navegador: el índice sale en el HTML y funciona sin JS.
function idDe(texto: string) {
  return texto
    .normalize('NFD')
    .replace(/[̀-ͯ]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 60);
}
const secciones: { id: string; texto: string }[] = [];
const usados = new Set<string>();
const cuerpoConIds = cuerpo.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (todo: string, attrs: string, dentro: string) => {
  const texto = dentro.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
  if (!texto) return todo;
  const yaTiene = attrs.match(/\bid="([^"]+)"/);
  let id = yaTiene ? yaTiene[1] : idDe(texto);
  if (!id) return todo;
  const base = id;
  let n = 2;
  while (usados.has(id)) id = `${base}-${n++}`;   // dos h2 iguales no pueden mandar al mismo
  usados.add(id);
  secciones.push({ id, texto });
  return yaTiene ? todo : `<h2${attrs} id="${id}">${dentro}</h2>`;
});
// Con menos de tres secciones un índice no orienta: dice lo que se ve bajando dos pantallas.
const hayIndice = secciones.length >= 3;
// ÍNDICE REPETIDO. Un post puede traer su propio índice en prosa («En esta guía: … · … ·»,
// hoy el de los 21 chequeos). Junto al índice pegajoso eran dos índices en la misma
// pantalla (QA 5-oct, antislop A10). Cuando hay índice pegajoso, ese párrafo lleva
// `hidden`: se toca un atributo, no el texto, y sin índice pegajoso vuelve a verse.
const cuerpoFinal = hayIndice
  ? cuerpoConIds.replace(/<p>(\s*<strong>En esta guía:<\/strong>)/, '<p hidden>$1')
  : cuerpoConIds;

// ---------------------------------------------------------------- imagen y siguiente
// IMAGEN EDITORIAL: decisión de página, no dato del post (los posts no traen imagen). Solo
// el pool honesto de §5, y ninguna afirma nada del artículo. El mapa es FIJO por slug y está
// repartido sobre el orden de lectura (el del índice, del más nuevo al más antiguo, que es
// el que sigue «Siguiente artículo»): dos seguidos nunca repiten imagen ni familia
// (dominó · hilo · mesa), contando la vuelta del último al primero. El de los 21 chequeos
// lleva la misma fila curva de fichas que su fila destacada en /v3/blog/.
// hilo.jpg NO va en ningún post (revisión cruzada, 6-oct): es la cabecera a sangre de
// /v3/diagnostico/, a donde lleva el cierre de cada artículo («Correr el chequeo»), y se veía
// dos veces seguidas. Va hilos.jpg, de la misma familia, así que el reparto no se mueve:
// queda en los posts 2, 5 y 7 del ciclo de 7, nunca seguidos.
const IMAGEN: Record<string, { src: string; alt: string; w: number; h: number; pos?: string }> = {
  '21-chequeos-visibilidad-ia': { src: '/assets/img/d/domino-curva.jpg', alt: 'Fichas de dominó de madera de pie en una fila curva, con luz cálida de costado', w: 1600, h: 1600, pos: '50% 62%' },
  'como-elegir-verificar-agencia-aeo-geo-chile': { src: '/assets/img/d/hilos.jpg', alt: 'Cantos de hojas apiladas en azul oscuro, en diagonal', w: 1600, h: 960 },
  'que-es-un-mini-diagnostico-seo': { src: '/assets/img/d/escritorio.jpg', alt: 'Escritorio de madera junto a la ventana, con un laptop, un cuaderno abierto y una taza', w: 1600, h: 670 },
  'cuanto-cuesta-seo-tecnico-chile': { src: '/assets/img/d/domino.jpg', alt: 'Fichas de dominó negras cayendo en fila sobre un fondo oscuro', w: 1600, h: 1600, pos: '50% 58%' },
  'seo-tecnico-fintechs-chile': { src: '/assets/img/d/hilos.jpg', alt: 'Cantos de hojas apiladas en azul oscuro, en diagonal', w: 1600, h: 960 },
  'que-es-aeo-geo': { src: '/assets/img/d/ventana.jpg', alt: 'Mesa de trabajo junto a una ventana con cortinas, con un cuaderno abierto, un laptop y una taza', w: 1600, h: 670, pos: '62% 50%' },
  // hilos.jpg es el RECORTE del 5-oct (spec §5): sin la línea dorada, 1600 × 960. El alt es
  // el de la home (index.astro), mirando la imagen; describir la línea era describir la foto
  // de antes.
  'como-aparecer-en-chatgpt': { src: '/assets/img/d/hilos.jpg', alt: 'Cantos de hojas apiladas en azul oscuro, en diagonal', w: 1600, h: 960 },
};
const img = IMAGEN[slug!] ?? IMAGEN['21-chequeos-visibilidad-ia'];
// PESO (QA final, técnica #8): versión de 800 px de cada foto. `sizes` es el ancho al que se
// pinta: la caja de .d-sangre mide 100vw − 80 en 2,39 (escritorio) y 100vw − 40 en 4:3
// (celular); una foto más ancha que la caja se pinta a «alto de la caja × su proporción».
// Una división por línea: el compilador de Astro lee «a / b … c / d» como expresión regular.
// hilos.jpg va con ?v=2, la misma URL que la home y los servicios (re-exportado con más
// contraste en la QA final, mirada #6).
const VERSION: Record<string, number> = { '/assets/img/d/hilos.jpg': 2 };
const imgUrl = img.src + (VERSION[img.src] ? `?v=${VERSION[img.src]}` : '');
const imgSrcset = `${img.src.replace(/\.jpg$/, '-800.jpg')} 800w, ${imgUrl} ${img.w}w`;
const R_CEL = 4 / 3;
const R_ESC = 2.39;
const nImg = img.w / img.h;
const fCel = Math.max(1, nImg / R_CEL);
const fEsc = Math.max(1, nImg / R_ESC);
const imgSizes = `(max-width: 767px) calc((100vw - 40px) * ${fCel.toFixed(3)}), calc((100vw - 80px) * ${fEsc.toFixed(3)})`;

// FAQPage = FAQ VISIBLE (QA final, técnica #10). La directriz de Google pide que lo marcado se
// vea, y un sitio que vende datos estructurados no puede marcar lo que no muestra. Cada
// pregunta del FAQPage tiene que estar entre las del FAQ visible del cuerpo, y su respuesta
// dentro de la respuesta visible (puede ser un tramo: en el de costos, la marcada es la primera
// frase de la visible). Si un post no lo cumple, el build se cae con el nombre del archivo.
const plano = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&nbsp;|\u00a0/g, ' ').replace(/\s+/g, ' ').trim();
const faqVisible = [...prosa.matchAll(/<summary>([\s\S]*?)<\/summary>\s*<p class="faq-a">([\s\S]*?)<\/p>/g)].map((m) => ({ p: plano(m[1]), r: plano(m[2]) }));
for (const n of info.jsonLd['@graph'].filter((x: any) => x['@type'] === 'FAQPage')) {
  for (const q of n.mainEntity ?? []) {
    const v = faqVisible.find((x) => x.p === plano(q.name));
    if (!v || !v.r.includes(plano(q.acceptedAnswer?.text ?? ''))) {
      throw new Error(`blog-v3/${slug}.json: la pregunta «${q.name}» del FAQPage no está visible en el post (o su respuesta dice otra cosa)`);
    }
  }
}

// Mismo orden que /v3/blog/ (misma expresión, para que los empates del 7-jul caigan igual).
const orden = [...indice].sort((a, b) => (a.datePublished < b.datePublished ? 1 : -1));
const iAqui = orden.findIndex((p) => p.slug === slug);
const siguiente = orden[(iAqui + 1) % orden.length];
---

<Layout ogImage={OG_V3.imagen} ogImageAlt={OG_V3.alt} ogType="article" title={meta.title} description={meta.description} bodyClass="d-body">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
  </Fragment>

  <NavV3 />

  <main>
    <header class="d-cab d-cab--art">
      <Miga items={[{ label: 'Inicio', href: '/v3/' }, ...(migaCorta ? [{ label: 'Blog', href: '/v3/blog/' }, { label: migaCorta, html: true }] : [{ label: 'Blog' }])]} />
      <h1 class="d-h1" set:html={h1} />
      <p class="d-linea">
        {tema && <><span set:html={tema} /> · </>}
        {fechaVisible && <time datetime={meta.datePublished} set:html={fechaVisible} />}
        {lectura && <> · <span set:html={lectura} /></>}
      </p>
      {autor.nombre && (
        <div class="d-autor-art">
          {/* lazy, como en el post publicado: no compite con la imagen principal. La miniatura
               de 132 × 132 (técnica #8) declara su tamaño real; el CSS la pinta en 44. */}
          {autor.src && <img src={autor.src} alt={autor.alt} width="132" height="132" loading="lazy" decoding="async" />}
          <p><span class="d-autor-art__nombre" set:html={autor.nombre} />{autor.rol && <span class="d-gris" set:html={autor.rol} />}</p>
        </div>
      )}
    </header>

    <figure class="d-sangre">
      <img src={imgUrl} srcset={imgSrcset} sizes={imgSizes} alt={img.alt} width={img.w} height={img.h} loading="eager" fetchpriority="high" style={img.pos ? `object-position:${img.pos}` : undefined} />
    </figure>

    {/* ÍNDICE PEGAJOSO + CUERPO. Es la sección con etiqueta de driftime (.d-sec): lo que se
         queda quieto a la izquierda no es un h2 sino el índice, que dice en qué parte vas.
         En celular la etiqueta deja de pegarse (.d-sec ya lo hace) y el índice va arriba,
         plegado.
         El <details> sale ABIERTO en el HTML y el JS lo pliega solo en celular: al revés no
         funciona, porque Chrome esconde el contenido de un <details> cerrado por el slot y
         ningún display:block lo revela. Sin JS, lo peor es un índice desplegado de más en
         celular, no un índice invisible en escritorio. */}
    <div class="d-sec d-art">
      {hayIndice ? (
        <nav class="d-eti d-indice-art" aria-label="Contenido del artículo">
          <details open>
            <summary>En este artículo</summary>
            <ol>
              {secciones.map((sec, i) => (
                <li>
                  <a href={`#${sec.id}`}><span class="d-indice-art__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span>{sec.texto}</span></a>
                </li>
              ))}
            </ol>
          </details>
        </nav>
      ) : <div />}
      <article class="d-prosa-art" set:html={cuerpoFinal} />
    </div>

    {/* CIERRE: el paso siguiente después de leer (QA 5-oct; spec §4 Artículo). Los posts
         publicados cierran con un llamado; sin él, lo más grande al final era «Siguiente
         artículo», que invita a seguir leyendo y no a convertir. Es el cierre de /v3/blog/,
         con las mismas palabras (fuentes en el frontmatter de blog/index.astro) y el mismo
         componente: .d-sec--quieta, la etiqueta no se pega.
         «Correr el chequeo» va a /v3/diagnostico/ y no a /v3/#chequeo: regla del §7 de la
         spec (al llegar a /v3/#chequeo el módulo de navegación tapaba el campo del dominio).
         El segundo botón es «Escríbenos»: en un artículo, el otro camino es hablar, no
         seguir leyendo sobre el método. */}
    <section class="d-sec d-sec--quieta d-cierre-art" aria-labelledby="s-medir">
      <div class="d-eti"><h2 class="d-h2" id="s-medir">Leer ayuda; medir, más.</h2></div>
      <div class="d-cierre-art__txt">
        <p class="d-guia">Pon tu dominio y ves en segundos si una IA te puede leer, si te entiende y si te puede citar.</p>
        <p class="d-cuerpo">Es el mismo chequeo con el que partimos cada proyecto.</p>
        <div class="d-btns"><a class="d-btn" href="/v3/diagnostico/">Correr el chequeo</a><a class="d-btn d-btn--alt" href={CONTACTO}>Escríbenos</a></div>
      </div>
    </section>

    {siguiente && siguiente.slug !== slug && (
      <a class="d-siguiente d-siguiente--art" href={`/v3/blog/${siguiente.slug}/`}>
        <span class="d-chico d-gris">Siguiente artículo</span>
        <span class="d-h1">{siguiente.headline} <span aria-hidden="true">→</span></span>
      </a>
    )}
  </main>

  <FooterV3 />
</Layout>

<script>
  // EN QUÉ SECCIÓN VAS, y el plegado en celular. Los enlaces del índice funcionan sin esto:
  // si el script no corre se pierde la marca, no el contenido.
  (() => {
    const indice = document.querySelector('.d-indice-art');
    if (!indice) return;

    const caja = indice.querySelector('details');
    const resumen = indice.querySelector('summary');
    const chico = window.matchMedia('(max-width: 767px)');
    const ajustar = () => {
      if (caja) caja.open = !chico.matches;
      // En escritorio el resumen es solo un rótulo: no se enfoca ni pliega nada.
      if (resumen) resumen.tabIndex = chico.matches ? 0 : -1;
    };
    ajustar();
    chico.addEventListener('change', ajustar);
    resumen?.addEventListener('click', (e) => { if (!chico.matches) e.preventDefault(); });

    const enlaces = [...indice.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const titulos = enlaces
      .map((a) => document.getElementById(decodeURIComponent(a.getAttribute('href')!.slice(1))))
      .filter((t): t is HTMLElement => !!t);
    if (titulos.length !== enlaces.length) return;

    // No IntersectionObserver: dice si un encabezado está a la vista, no en qué sección
    // estás. Entre dos encabezados no hay ninguno visible y la marca se apagaría leyendo.
    let pendiente = false;
    const marcar = () => {
      pendiente = false;
      const linea = 140;
      let actual = 0;
      for (let i = 0; i < titulos.length; i++) if (titulos[i].getBoundingClientRect().top <= linea) actual = i;
      const antes = titulos[0].getBoundingClientRect().top > linea;
      enlaces.forEach((a, i) => {
        if (!antes && i === actual) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };
    const pedir = () => { if (pendiente) return; pendiente = true; requestAnimationFrame(marcar); };
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
    marcar();
  })();
</script>

