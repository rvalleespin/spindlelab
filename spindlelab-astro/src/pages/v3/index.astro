---
// HOME — sistema driftime (5-oct-2026).
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md
// Tablero de referencia: …/tableros/driftime-home/ (aprobado por Ramón el 5-oct)
// Lo que había antes en este archivo, con su historia completa (los cuatro intentos de la
// bajada, por qué el h1 dejó de ser una pregunta, la medición de «motor»), está en el git:
//   git log --follow -p -- spindlelab-astro/src/pages/v3/index.astro
// No se repite acá; se lee allá antes de tocar el hero.
//
// LAS REGLAS QUE SOSTIENEN ESTA PÁGINA:
// · Dirección A (Ramón, 2-oct): el instrumento va PRIMERO en el orden de lectura. Ocupa el
//   aire negro que en driftime queda sobre el titular.
// · El display (.d-display, Manrope 800 mayúsculas) aparece aquí en CINCO lugares: el h1 y
//   las cuatro palabras de campo. En todo el sitio, en ninguno más.
// · La obra va arriba del pliegue (driftime la pone ahí; la v3 la había bajado).
// · Precios: los de oferta-v3.json, siempre «desde … + IVA».
// · Cero imagen de banco y cero gente inventada (spec §5).
// · El chequeo es la herramienta real: ids chq-* y /api/chequeo, como antes. Su resultado
//   lleva a contacto de la v3 (data-contacto del formulario, que lee v3-chequeo.js).
// · Title y description de producción, como las otras 20 rutas (revisión cruzada, 6-oct; antes
//   eran de maqueta interna y nombraban a la referencia): el title de spindlelab-site/index.html
//   con «·» en vez de raya, y la description por defecto de Layout.astro (la de la home Astro
//   publicada; dice 24 horas, como el resto de la v3, y no las 48 de spindlelab-site). El
//   noindex se mantiene.
// · QA final (6-oct), paquete A: el title baja a 53 caracteres (el chequeo de la casa pide de 15
//   a 65 y el anterior medía 67; mismo texto sin «para empresas») y la página suma un nodo
//   WebPage con fechas en su JSON-LD (Layout no se toca). Fila del hero en proporciones
//   mixtas, rótulo único por obra (`rotulo` en obra-v3.json), pestañas de los campos con la
//   implementación de MovimientoV3, foco de la pila con FocoPila, srcset en las piezas y
//   la línea de precio con el marcado del índice de servicios.
import Layout from '../../layouts/Layout.astro';
import NavV3 from '../../components/v3/NavV3.astro';
import FooterV3 from '../../components/v3/FooterV3.astro';
import Pieza from '../../components/v3/Pieza.astro';
import FocoPila from '../../components/v3/FocoPila.astro';
import { CONTACTO_V3 as CONTACTO } from '../../consts-v3';
import '../../styles/chequeo-v3.css'; // el resultado del chequeo se pinta con estas clases
import '../../styles/driftime.css';
import oferta from '../../data/oferta-v3.json';
import obra from '../../data/obra-v3.json';
import indice from '../../data/blog-v3/_indice.json';

// TABLETA VERTICAL = CELULAR (QA final, mirada #1): el mismo corte que driftime.css. En una
// tableta parada la fila del hero va en carrusel y los campos en la grilla de dos celdas, así
// que la imagen de celular (`srcCel`) también manda ahí.
const TAB = '(max-width: 1024px) and (orientation: portrait)';
const CEL = `(max-width: 767px), ${TAB}`;
// Cada foto del pool y cada mockup tiene su versión de 800 px (`<foto>-800.jpg`, la misma
// imagen reescalada): el navegador la elige cuando la pieza se ve chica (QA final, técnica #8).
const v800 = (src: string) => src.replace(/\.jpg$/, '-800.jpg');
const candidatas = (src: string, w: number, v?: number) => `${v800(src)} 800w, ${src}${v ? `?v=${v}` : ''} ${w}w`;

// La fila del hero sale del MISMO dato que /v3/trabajo/. Rótulo único por obra: `rotulo` de
// obra-v3.json («Combeau, fotografía · Cliente»), el mismo en el hero y en el campo
// Desarrollo (QA final, mirada #10). Una pieza de concepto lleva además su rótulo en papel.
// PROPORCIONES MIXTAS CON ALTO COMÚN (QA final, mirada #5): cuatro teléfonos iguales se leían
// como cuatro tarjetas (antislop B1). Las piezas 2 y 4 van en el mockup ancho (notebook +
// teléfono, 4:3) y la 1 y la 3 en el alto (teléfono, 10:11). Cada una en su proporción, sin
// recorte: `--r` por pieza y `--suma` en la fila, el mecanismo de los campos. El alt de cada
// imagen describe ese mockup: `altMock` el par, `altMockAlto` solo el teléfono.
const MOCK = { alto: { w: 1000, h: 1100 }, ancho: { w: 1600, h: 1200 } } as const;
const SIZES_TIRA = {
  alto: `(max-width: 767px) 60vw, ${TAB} 35vw, 19vw`,
  ancho: `(max-width: 767px) 88vw, ${TAB} 51vw, 28vw`,
};
const tira = obra.casos.map((c: any, i: number) => {
  const forma: 'alto' | 'ancho' = i % 2 === 1 ? 'ancho' : 'alto';
  const src: string = forma === 'ancho' ? c.mock : c.mockAlto;
  const { w, h } = MOCK[forma];
  return {
    src, w, h, srcset: candidatas(src, w), sizes: SIZES_TIRA[forma],
    alt: forma === 'ancho' ? c.altMock : c.altMockAlto ?? c.altMock,
    concepto: c.tipo === 'concepto',
    etiquetas: [c.rotulo],
  };
});
const sumaTira = tira.reduce((t: number, p: any) => t + p.w / p.h, 0);

// Los cuatro campos, en el orden que fija el giro del 29-sep: Desarrollo abre.
// Las imágenes salen solo del pool honesto (spec §5). w y h son los del archivo (QA final,
// técnica #9). `v`: versión del archivo cuando cambió de contenido con el mismo nombre (caché
// de 7 días en /assets/*): hilos.jpg ganó contraste (QA final, mirada #6).
// Desarrollo lee la obra de obra-v3.json: la captura de Combeau termina al final de la banda
// verde (`combeau-fotografia-ancho-2.jpg`, 1440 × 616; la anterior cortaba la fila de retratos
// a la altura de la frente, QA final, mirada #4).
type Img = { src: string; w: number; h: number; alt: string; v?: number; etq?: string; cel?: string; pos?: string };
const caso = (slug: string) => obra.casos.find((c: any) => c.slug === slug) as any;
const combeau = caso('combeau-fotografia');
const vyc = caso('verifica-y-cumple');
const imgs: Record<string, Img[]> = {
  Desarrollo: [
    { src: combeau.img, w: combeau.w, h: combeau.h, cel: combeau.mockAlto, alt: 'Portada del sitio de fotografía de Bernardo Combeau, un retrato iluminado en verde', etq: combeau.rotulo },
    { src: vyc.img, w: vyc.w, h: vyc.h, cel: vyc.mockAlto, alt: 'Portada de Verifica y Cumple con el titular «¿Estás seguro?» sobre azul', etq: vyc.rotulo },
  ],
  Visibilidad: [
    { src: '/assets/img/d/hilos.jpg', v: 2, w: 1600, h: 960, alt: 'Cantos de hojas apiladas en azul oscuro, en diagonal' },
    { src: '/assets/img/d/ventana.jpg', w: 1600, h: 670, pos: '72% 50%', alt: 'Mesa de trabajo junto a una ventana con cortinas, con un cuaderno abierto y un laptop' },
  ],
  Continuidad: [
    { src: '/assets/img/d/domino-curva.jpg', w: 1600, h: 1600, alt: 'Fichas de dominó de madera en fila curva sobre piedra oscura, con luz cálida' },
    { src: '/assets/img/d/escritorio.jpg', w: 1600, h: 670, pos: '34% 50%', alt: 'Escritorio de madera con un laptop, un cuaderno y una taza junto a la ventana' },
  ],
  Alcance: [
    { src: '/assets/img/d/hilo.jpg', w: 1400, h: 787, pos: '55% 50%', alt: 'Un hilo luminoso cruza en diagonal un fondo verde oscuro' },
    { src: '/assets/img/d/domino.jpg', w: 1600, h: 1600, alt: 'Fichas de dominó cayendo en fila sobre fondo negro' },
  ],
};
const campos = [
  ...oferta.momentos.map((m: any) => ({ palabra: m.palabra, campo: m.campo, momento: m.momento, items: m.items })),
  { palabra: oferta.tambienPanel.palabra, campo: oferta.tambienPanel.campo, momento: oferta.tambienPanel.momento, items: oferta.tambien },
].map((c) => {
  const lista = imgs[c.palabra] ?? [];
  const suma = lista.reduce((t, im) => t + im.w / im.h, 0);
  return {
    ...c, id: c.palabra.toLowerCase(), suma,
    // En escritorio cada pieza ocupa su parte del ancho (r / suma); en celular y tableta
    // vertical, media fila.
    imgs: lista.map((im) => ({ ...im, url: im.src + (im.v ? `?v=${im.v}` : ''), srcset: candidatas(im.src, im.w, im.v), sizes: `${CEL} 48vw, ${Math.ceil((im.w / im.h / suma) * 100)}vw` })),
  };
});

// «$490.000 · $690.000 con Visibilidad IA» → una alternativa por trozo, y cada trozo no se
// parte (QA final, conversión #4; el marcado del índice de servicios, spec §7 del 5-oct).
const alternativas = (p: string) => p.split(' · ');

const posts = [...indice].sort((a: any, b: any) => (a.datePublished < b.datePublished ? 1 : -1)).slice(0, 4);
const fecha = (iso: string) =>
  new Date(iso + 'T12:00:00').toLocaleDateString('es-CL', { day: 'numeric', month: 'short', year: 'numeric' }).replace('.', '');

// EL NODO DE LA PÁGINA (QA final, conversión #2). La home reprobaba su propio chequeo por «sin
// fechas en tu schema». Layout emite #org, #website y #autor-ramon y no se toca; la página suma
// solo su WebPage, con el @id de la portada publicada (patrón de Método: …/#webpage).
// · datePublished 2026-07-08: la portada estaba en línea ese día (plan-operativo-90-dias.md,
//   semana 1: Search Console verificado y sitemap enviado, «Correcto», 11 páginas).
// · dateModified: la fecha de esta versión. AL PUBLICAR LA V3 se cambia por el día en que
//   sale (si no, el grafo diría que la portada no cambió desde hoy).
const TITLE = 'SEO técnico y visibilidad en IA en Chile · SpindleLab';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://spindlelab.cl/#webpage',
      url: 'https://spindlelab.cl/',
      name: TITLE,
      inLanguage: 'es-CL',
      isPartOf: { '@id': 'https://spindlelab.cl/#website' },
      about: { '@id': 'https://spindlelab.cl/#org' },
      datePublished: '2026-07-08',
      dateModified: '2026-10-06',
    },
  ],
};
---

<Layout
  title={TITLE}
  description="Auditamos tu sitio y tu presencia en IA para que ChatGPT, Gemini y Perplexity te recomienden antes que tu competencia. Diagnóstico gratis en 24 horas."
  bodyClass="d-body d-home"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <NavV3 />

  <main>
    {/* ============================================================== 1 · HERO */}
    <section class="d-hero" aria-labelledby="h1">
      <div class="d-instr" id="chequeo">
        <p class="d-rot">Chequeo de visibilidad en IA</p>
        <form class="d-dom chq-form" id="chq-form" novalidate aria-describedby="chq-nota" data-contacto={CONTACTO}>
          <label for="chq-dominio" class="d-sr">Tu dominio</label>
          <input id="chq-dominio" name="dominio" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="tuempresa.cl" required />
          <button id="chq-btn" type="submit">Ver cómo lo lee</button>
        </form>
        <p class="d-nota" id="chq-nota"><b>21 señales, con la metodología publicada.</b> Es el mismo chequeo con el que partimos cada proyecto.</p>
        <div class="chq-error" id="chq-error" role="alert" style="margin-top:10px"></div>
        <div id="chq-out" aria-live="polite" style="margin-top:24px"></div>
      </div>

      <div class="d-titular">
        <p class="d-ojillo">Estás pagando para que lleguen a tu sitio.</p>
        <h1 class="d-display" id="h1">Ahí se corta<br />el circuito</h1>
      </div>

      {/* role="region": un div no anuncia su aria-label, y a 390 el carrusel recibe foco
           (QA final, técnica #12). */}
      <div class="d-fila d-fila--hero" role="region" aria-label="Trabajo entregado" style={`--suma:${sumaTira.toFixed(4)}`}>
        {tira.map((t: any, i: number) => (
          <Pieza src={t.src} srcset={t.srcset} sizes={t.sizes} alt={t.alt} concepto={t.concepto} etiquetas={t.etiquetas} ancho={t.w} alto={t.h} proporcion={t.w / t.h} eager={i < 2} />
        ))}
      </div>
    </section>

    {/* ============================================================== 2 · PRESENTACIÓN */}
    {/* Del post publicado del 1-sep-2026 (corpus de voz). El referente va entero: «es la
         máquina que responde…». Su falta fue el bloqueante de las dos direcciones del 2-oct. */}
    <section class="d-pres" aria-label="Qué hacemos">
      <p class="d-guia">Tu sitio está escrito para personas. Pero cada vez más, el primero en llegar no es una persona: es la máquina que responde cuando alguien pregunta por tu rubro. Si esa máquina no puede leerte, entenderte ni citarte, la consulta que pagaste termina en otra parte.</p>
      <div class="d-btns"><a class="d-btn" href="/v3/metodo/">Ver el método</a></div>
    </section>

    {/* ============================================================== 3 · CAMPOS */}
    {campos.map((c) => (
      <section class:list={['d-campo', `d-campo--${c.campo}`]} aria-labelledby={`t-${c.id}`}>
        <div class="d-campo__cab">
          <h2 class="d-display" id={`t-${c.id}`}>{c.palabra}</h2>
          {/* Dos servicios: pestañas (MovimientoV3: flechas, Inicio/Fin, tabindex itinerante).
               Uno solo: la píldora es un rótulo, no un control (QA final, técnica #7). */}
          {c.items.length > 1 ? (
            <div class="d-pills" role="tablist" aria-labelledby={`t-${c.id}`} data-pestanas>
              {c.items.map((it: any, i: number) => (
                <button class="d-pill" role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} aria-controls={`p-${c.id}-${i}`} id={`tab-${c.id}-${i}`}>{it.n}</button>
              ))}
            </div>
          ) : (
            <div class="d-pills"><span class="d-pill d-pill--rotulo">{c.items[0].n}</span></div>
          )}
          {c.items.map((it: any, i: number) => (
            <div class="d-panel" id={`p-${c.id}-${i}`} role={c.items.length > 1 ? 'tabpanel' : undefined} aria-labelledby={c.items.length > 1 ? `tab-${c.id}-${i}` : undefined} hidden={i !== 0}>
              <p class="d-desc"><b>{c.momento}.</b> {it.d}</p>
              {/* Espacios reales entre las piezas y separador aria-hidden: sin CSS se leía
                   «Desde$390.000…+ IVA». Cada alternativa con su plan no se parte. */}
              <p class="d-precio" style="margin-top:18px">
                {alternativas(it.p).map((a, k, todas) => [
                  k > 0 ? ' ' : '',
                  <span class="d-pre-alt">{k === 0 && [<span class="d-pre-rot">Desde</span>, <span class="d-pre-sep" aria-hidden="true"></span>, ' ']}<b>{a}{k < todas.length - 1 ? '\u00a0·' : ''}</b>{k === todas.length - 1 && [' ', <span class="d-pre-rot">+ IVA</span>]}</span>,
                ])}
              </p>
              <div class="d-btns" style="margin-top:18px">
                <a class="d-btn" href={it.href}>Ver {it.n}</a>
                <a class="d-btn" href={CONTACTO}>Escríbenos</a>
              </div>
            </div>
          ))}
        </div>
        <div class="d-fila d-fila--2" style={`--suma:${c.suma.toFixed(4)}`}>
          {c.imgs.map((im) => <Pieza src={im.url} srcset={im.srcset} sizes={im.sizes} alt={im.alt} etiquetas={im.etq ? [im.etq] : []} ancho={im.w} alto={im.h} proporcion={im.w / im.h} srcCel={im.cel} srcsetCel={im.cel ? candidatas(im.cel, MOCK.alto.w) : undefined} sizesCel={im.cel ? '48vw' : undefined} anchoCel={im.cel ? MOCK.alto.w : undefined} altoCel={im.cel ? MOCK.alto.h : undefined} mediaCel={CEL} posicion={im.pos} />)}
        </div>
      </section>
    ))}

    {/* ============================================================== 4 · QUIÉN */}
    {/* Donde driftime pone su muro de 12 logos. Acá no: cero prueba social inventada, y hay
         un solo cliente con permiso. Lo verificable es la persona. */}
    <section class="d-quien d-tapa" aria-labelledby="t-quien">
      <Pieza src="/assets/img/ramon-vallejos.jpg" alt="Ramón Vallejos, consultor de SpindleLab" ancho={896} alto={1200} />
      <div class="d-quien__txt">
        <h2 class="d-h2" id="t-quien">No te prometo. Te muestro.</h2>
        <p class="d-guia d-gris">Detrás de SpindleLab está una persona, no una agencia de veinte. Cada proyecto parte con el mismo chequeo que puedes correr arriba, sobre tu dominio, y termina con el mismo chequeo corrido otra vez.</p>
        <div style="display:flex;flex-direction:column;gap:2px"><span>Ramón Vallejos</span><span class="d-chico d-gris">Consultor de SEO técnico y visibilidad en IA · Chile</span></div>
        <div class="d-btns"><a class="d-btn" href="/v3/nosotros/">Quién está detrás</a></div>
      </div>
    </section>

    {/* ============================================================== 5 · EL TALLER */}
    <section class="d-indice d-tapa" aria-labelledby="t-taller">
      <div class="d-indice__cab">
        <h2 class="d-h2" id="t-taller">Lo que escribimos sobre búsqueda e IA</h2>
        <a class="d-btn d-btn--alt" href="/v3/blog/">Ver todo</a>
      </div>
      <ol>
        {posts.map((p: any) => (
          <li><a href={`/v3/blog/${p.slug}/`}><time datetime={p.datePublished}>{fecha(p.datePublished)}</time><span class="d-h3">{p.headline}</span><span class="d-flecha" aria-hidden="true">→</span></a></li>
        ))}
      </ol>
    </section>
  </main>

  {/* Foco no oculto en la pila de campos (spec §3; QA final, técnica #1). */}
  <FocoPila bandas=".d-campo" />
  <FooterV3 />

  <script src="/assets/js/v3-chequeo.js" is:inline defer></script>
</Layout>
