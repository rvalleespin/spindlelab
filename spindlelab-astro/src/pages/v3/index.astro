---
// HOME DE A · ARCHIVO (obra E12, corrida 2, tanda 2). Diego, 19-oct-2026.
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md §2.1 (las siete secciones y sus columnas), §3.1
// (la portada con el hilo de oro y su velo), §3.2 (la cinta), §3.3 (medios) y §4. Implementación de referencia: el
// prototipo tableros/e12-direcciones/proto/a/index.html y el estudio de la portada e12/spec/portada/; donde difieren,
// manda la spec. Lo que la spec no cubría está en spindlelab-v3/desvios.md, tanda 2.
//
// El texto es de Clara, tal cual: se lee de src/data/archivo/texto/ (copias de e12/texto/texto-obra.json, ver
// texto.mjs). Los precios y los nombres de servicio salen de oferta-v3.json y servicios-v3.json, y el build se cae si
// no son iguales, como texto, a los de Clara. Las señales (title, description, JSON-LD, imagen al compartir) son de
// Simón, e12/senales-obra.md §2.1.
//
// Las clases de la portada (.portada-v, .portada-v__medio, .portada-v__pie) son las que miden
// e12/spec/herramientas/portada.mjs y contraste-portada.py: no se cambian sin cambiar esas dos.
import Layout from '../../layouts/Layout.astro';
import PaginaA from '../../components/a/PaginaA.astro';
import Video from '../../components/a/Video.astro';
import Chequeo from '../../components/a/Chequeo.astro';
import Pieza from '../../components/a/Pieza.astro';
import Imagen from '../../components/a/Imagen.astro';
import Icono from '../../components/a/Icono.astro';
import { LAYOUT_A } from '../../components/a/layout-a';
import { textoDe, igualQue, contiene, medioDe } from '../../data/archivo/texto.mjs';
import comun from '../../data/archivo/texto/comun.json';
import home from '../../data/archivo/texto/home.json';
import trabajo from '../../data/archivo/texto/trabajo.json';
import casoPraxi from '../../data/archivo/texto/caso-praxi.json';
import medios from '../../data/archivo/medios.json';
import cinta from '../../data/archivo/cinta.json';
import oferta from '../../data/oferta-v3.json';
import servicios from '../../data/servicios-v3.json';

const t = textoDe(home, comun);
const pagina = home.texto;
const m = medios.medios;
const entradas = trabajo.texto.entradas;
const entrada = (id: string) => {
  const e = entradas.find((x: { id: string }) => x.id === id);
  if (!e) throw new Error(`La entrada «${id}» no está en trabajo.entradas`);
  return e;
};
const dos = (id: string) => t(id) as { tinta: string; gris: string };
const externo = t('comun.externo').texto;

// ---- La cinta (§3.2): los tiempos de cada tramo son los del video (cinta.json, tanda 1); la ficha, la de Clara
// (home.cinta.tramos), que reemplaza la del prototipo. Mismos ocho tramos, en el mismo orden, o el build se cae.
const tramosClara = t('home.cinta.tramos').tramos as { nombre: string; linea: string; bajada: string; destino: string; nota?: string }[];
if (tramosClara.length !== cinta.length) throw new Error('La cinta tiene otro número de tramos que la ficha de Clara');
const tramos = cinta.map((c, i) => {
  const k = tramosClara[i];
  igualQue(c.nombre, k.nombre, `cinta, tramo ${i + 1}`);
  return { desde: c.desde, hasta: c.hasta, nombre: k.nombre, linea: k.linea, bajada: k.bajada, destino: k.destino, nota: k.nota || '', fuera: /^https?:/.test(k.destino) };
});
const primero = tramos[0];

// ---- El índice corto (§2.1, fila 3): Combeau fotografía 16:9, el par 4:5 | 4:5 (Praxi, Verifica y Cumple) y Sesenta
// 16:9, con el nombre, la bajada y la línea de /trabajo/ (solo tipo · año).
const corto = [
  { id: 'combeau-fotografia', medio: m['combeau-fotografia-169'], forma: 'p-169' },
  { id: 'praxi', medio: m['praxi-45'], forma: 'p-45' },
  { id: 'verifica-y-cumple', medio: m['verifica-y-cumple-45'], forma: 'p-45', pie: t('home.obra.pie-verifica').texto },
  { id: 'sesenta', medio: m['sesenta-home-169'], forma: 'p-169' },
].map((p) => ({ ...p, e: entrada(p.id) }));
// «[ Todo el trabajo ] (10)»: el 10 es el conteo verdadero del índice (Clara).
const todo = t('home.obra.todo').texto;
igualQue(todo, `[ Todo el trabajo ] (${entradas.length})`, 'home, el corchete del índice corto');

// ---- Cada pieza, con un dato medido (§2.1, fila 4). Los medios, los de §3.3: la galería de Combeau, los números de
// Praxi (con el pie de datos de ejemplo que Clara le escribió a esa captura en el caso) y las 12 cosas de Verifica y
// Cumple, sin su puntaje (defecto 20).
const numeros = medioDe(casoPraxi, 'praxi-numeros-169.webp');
igualQue(m['praxi-numeros-169'].alt, numeros.alt, 'prueba, alt de los números de Praxi');
const pruebas = [
  { id: 'combeau', medio: m['combeau-galeria-169'] },
  { id: 'praxi', medio: m['praxi-numeros-169'], pie: numeros.pie as string },
  { id: 'vyc', medio: m['verifica-y-cumple-12-169'] },
].map((p) => ({
  ...p,
  pieza: t(`home.prueba.${p.id}.pieza`).texto,
  dato: t(`home.prueba.${p.id}.dato`).texto,
  ficha: t(`home.prueba.${p.id}.ficha`).campos as { rotulo: string; valor: string }[],
}));

// ---- Servicios (§2.1, fila 5): nombres y precios de los JSON, iguales como texto a los de Clara.
const [mDesarrollo, mExiste, mSostener] = oferta.momentos;
const sv = servicios as Record<string, { secciones: { planes?: { precio: string }[] }[] }>;
const precioDe = (slug: string, i: number) => sv[slug].secciones[1].planes![i].precio;
const filas = [
  { k: 'dw', nombre: mDesarrollo.items[0].n, precio: mDesarrollo.planes[0].p, href: mDesarrollo.items[0].href, puerta: true },
  { k: 'via', nombre: mExiste.items[0].n, precio: precioDe('visibilidad-en-ia', 0), href: mExiste.items[0].href },
  { k: 'aud', nombre: mExiste.items[1].n, precio: precioDe('auditoria-seo-tecnica', 1), href: mExiste.items[1].href },
  { k: 'aco', nombre: mSostener.items[0].n, precio: precioDe('acompanamiento-mensual', 0), href: mSostener.items[0].href },
].map((f) => {
  igualQue(f.nombre, t(`home.servicios.${f.k}.nombre`).texto, `servicios, nombre de ${f.k}`);
  igualQue(f.precio, t(`home.servicios.${f.k}.precio`).texto, `servicios, precio de ${f.k}`);
  const boton = t(`home.servicios.${f.k}.boton`);
  igualQue(f.href, boton.destino, `servicios, destino de ${f.k}`);
  return {
    ...f,
    situacion: t(`home.servicios.${f.k}.situacion`).texto,
    texto: t(`home.servicios.${f.k}.texto`).texto,
    escena: f.k === 'via' ? t('home.servicios.via.escena').texto : '',
    boton: boton.texto,
  };
});
// «También»: Paid Media y Gestión de redes en una línea de cuerpo, con sus enlaces y sus precios (Clara). Los nombres
// son los de oferta-v3.json (tambien) y los precios, los de servicios-v3.json, dentro de la frase tal cual.
const tambien = t('home.servicios.tambien');
const [tRedes, tPaid] = oferta.tambien;
contiene(tambien.texto, precioDe('paid-media', 0).replace(/^Desde /, 'desde '), 'servicios, también (Paid Media)');
contiene(tambien.texto, precioDe('redes-sociales', 0).replace(/^Desde /, 'desde '), 'servicios, también (redes)');
const enlacesTambien = Object.entries(tambien.enlaces as Record<string, string>);
igualQue(enlacesTambien[0][0], tPaid.n, 'servicios, también: nombre de Paid Media');
igualQue(enlacesTambien[0][1], tPaid.href, 'servicios, también: destino de Paid Media');
igualQue(enlacesTambien[1][0], tRedes.n, 'servicios, también: nombre de redes');
igualQue(enlacesTambien[1][1], tRedes.href, 'servicios, también: destino de redes');
// La frase partida en sus dos enlaces, sin cambiar una letra.
const trozos: { texto: string; href?: string }[] = [];
{
  let resto = tambien.texto as string;
  for (const [texto, href] of enlacesTambien) {
    const i = resto.indexOf(texto);
    if (i < 0) throw new Error(`servicios, también: falta «${texto}» en la frase`);
    trozos.push({ texto: resto.slice(0, i) }, { texto, href });
    resto = resto.slice(i + texto.length);
  }
  trozos.push({ texto: resto });
}

// ---- Señales (Simón, senales-obra.md §2.1): title y description de Clara, que son los de Simón.
const title = pagina.title;
const description = pagina.description;
if (title.length > 60 || description.length < 120 || description.length > 160) {
  throw new Error(`home: title (${title.length}) o description (${description.length}) fuera de los largos de senales-obra.md §1.2`);
}
// Las fechas del WebPage (acta de la obra, vuelta 1, defecto 1; senales-obra.md §1.2). datePublished es el de la portada
// publicada (2026-07-08: estaba en línea ese día, plan-operativo-90-dias.md, semana 1; el mismo que llevaba la v3 del
// 16-oct). dateModified lo escribe el build, nunca a mano: el día en que se construye, en la hora de Chile, así que al
// publicar la v3 dice el día en que sale. Sin fecha, el chequeo de la casa (functions/api/chequeo.js, «fecha») le quita
// 4 puntos a la home: 79 contra 83 del 16-oct (criterio 12 del brief).
const PUBLICADA = '2026-07-08';
const construida = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Santiago', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
if (!/^\d{4}-\d{2}-\d{2}$/.test(construida) || construida < PUBLICADA) {
  throw new Error(`home: dateModified «${construida}» no es una fecha ISO posterior a datePublished (${PUBLICADA})`);
}
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://spindlelab.cl/#webpage',
      url: 'https://spindlelab.cl/',
      name: title,
      description,
      inLanguage: 'es-CL',
      isPartOf: { '@id': 'https://spindlelab.cl/#website' },
      about: { '@id': 'https://spindlelab.cl/#org' },
      datePublished: PUBLICADA,
      dateModified: construida,
    },
  ],
};
---
<Layout title={title} description={description} ogImage="/assets/img/og-e12-marca.jpg?v=1" ogImageAlt="SpindleLab, estudio de diseño y tecnología: diseñamos y programamos sitios a medida." {...LAYOUT_A}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <link slot="head" rel="preload" as="image" href="/v3/portada/hilo-1920-poster.webp" fetchpriority="high" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <PaginaA>
    {/* 1 · PORTADA (§2.1, fila 1; §3.1). El hilo de oro a sangre; la pausa, primer control. Sobre el velo (desde 834) o
         debajo, sobre el lienzo (bajo 834): el rótulo, el h1 en dos tintas, la entradilla y el chequeo. */}
    <section class="portada-v" aria-labelledby="portada-titulo">
      <Video
        clase="portada-v__medio"
        sangre
        pausaArriba
        primeraPantalla
        poster="/v3/portada/hilo-1920-poster.webp"
        ancho={1920}
        alto={1080}
        fuentes={[
          { desde: 834, webm: '/v3/portada/hilo-1920.webm', mp4: '/v3/portada/hilo-1920.mp4' },
          { webm: '/v3/portada/hilo-960.webm', mp4: '/v3/portada/hilo-960.mp4' },
        ]}
      />
      <div class="portada-v__pie">
        <div class="portada-v__decl">
          <p class="rotulo">{t('home.portada.rotulo').texto}</p>
          <h1 class="t-portada" id="portada-titulo"><span class="tinta">{dos('home.portada.h1').tinta}</span> <span class="gris">{dos('home.portada.h1').gris}</span></h1>
          <p class="cuerpo entradilla">{t('home.portada.entradilla').texto}</p>
        </div>
        <div class="portada-v__chequeo">
          <Chequeo
            apilado
            rotulo={t('home.chequeo.rotulo').texto}
            intro={t('home.chequeo.intro').texto}
            etiqueta={t('home.chequeo.label').texto}
            ejemplo={t('home.chequeo.placeholder').texto}
            boton={t('home.chequeo.boton').texto}
            ayuda={t('home.chequeo.ayuda').texto}
          />
        </div>
      </div>
    </section>

    {/* 2 · LA CINTA (§2.1, fila 2; §3.2): 16:9 exacta, sin titular a la vista; la ficha del tramo que pasa al lado desde
         1194 y, bajo 1194, como rótulo de placa sobre la cinta. cinta.mjs la cambia con el tramo. */}
    <section class="seccion reticula cinta-s" aria-label={t('home.cinta.nombre').texto} data-cinta>
      <div class="cinta-s__marco" data-entrada>
        <Video clase="p-169" poster="/v3/cinta/cinta-poster.webp" ancho={1280} alto={720} webm="/v3/cinta/cinta.webm" mp4="/v3/cinta/cinta.mp4" />
        <p class="marca-medio rotulo" data-cinta-rotulo><span class="tinta">{primero.nombre}</span> <span class="gris">· {primero.linea}</span></p>
        <p class="marca-medio marca-medio--abajo chico" data-cinta-nota hidden={!primero.nota}>{primero.nota}</p>
      </div>
      <div class="cinta-s__ficha" data-cinta-ficha>
        <p class="rotulo" data-ficha-linea>{primero.linea}</p>
        <p class="t-titulo t-display"><a class="subrayado" href={primero.destino} data-ficha-nombre><span data-ficha-texto>{primero.nombre}</span><span data-ficha-fuera hidden={!primero.fuera}><Icono nombre="fuera" /><span class="solo-lector">{externo}</span></span></a></p>
        <p class="chico" data-ficha-bajada>{primero.bajada}</p>
        <p class="chico tinta" data-ficha-nota hidden={!primero.nota}>{primero.nota}</p>
      </div>
      <script type="application/json" id="cinta-tramos" is:inline set:html={JSON.stringify(tramos)} />
    </section>

    {/* 3 · ÍNDICE CORTO (§2.1, fila 3): el h2 pegajoso a la izquierda desde 1194; las cuatro piezas a la derecha. */}
    <section class="seccion reticula destacados" aria-labelledby="h-obra">
      <div class="destacados__cab">
        <h2 class="t-declaracion" id="h-obra"><span class="tinta">{dos('home.obra.h2').tinta}</span> <span class="gris">{dos('home.obra.h2').gris}</span></h2>
      </div>
      <div class="destacados__lista">
        <Pieza id={`d-${corto[0].id}`} nombre={corto[0].e.nombre} bajada={corto[0].e.bajada} linea={corto[0].e.linea} destino={corto[0].e.destino} cursor={corto[0].e.cursor} medio={corto[0].medio} forma={corto[0].forma} externo={externo} entrada />
        <div class="fila-par">
          {corto.slice(1, 3).map((p) => (
            <Pieza id={`d-${p.id}`} nombre={p.e.nombre} bajada={p.e.bajada} linea={p.e.linea} destino={p.e.destino} cursor={p.e.cursor} medio={p.medio} forma={p.forma} pie={p.pie} externo={externo} />
          ))}
        </div>
        <Pieza id={`d-${corto[3].id}`} nombre={corto[3].e.nombre} bajada={corto[3].e.bajada} linea={corto[3].e.linea} destino={corto[3].e.destino} cursor={corto[3].e.cursor} medio={corto[3].medio} forma={corto[3].forma} externo={externo} />
      </div>
      <div class="destacados__pie">
        <p class="chico caja">{t('home.obra.concepto').texto}</p>
        <a class="corchete" href={t('home.obra.todo').destino}>{todo}</a>
      </div>
    </section>

    {/* 4 · CADA PIEZA, CON UN DATO MEDIDO (§2.1, fila 4): tres filas con su borde de arriba, sin caja. */}
    <section class="seccion reticula prueba" aria-labelledby="h-prueba">
      <div class="prueba__cab">
        <h2 class="t-declaracion" id="h-prueba"><span class="tinta">{dos('home.prueba.h2').tinta}</span> <span class="gris">{dos('home.prueba.h2').gris}</span></h2>
        <p class="cuerpo caja">{t('home.prueba.aviso').texto}</p>
      </div>
      {pruebas.map((p, i) => (
        <div class="prueba__fila">
          <div class="prueba__medio" data-entrada={i === 0 ? '' : undefined}>
            <Imagen src={p.medio.src} alt={p.medio.alt} ancho={p.medio.ancho} alto={p.medio.alto} clase="p-169" />
            {p.pie && <p class="pie">{p.pie}</p>}
          </div>
          <div class="prueba__dato">
            <h3 class="t-titulo">{p.pieza}</h3>
            <p class="cuerpo caja">{p.dato}</p>
            {p.ficha.map((f) => <p class="ficha-linea"><span class="rotulo">{f.rotulo}</span> <span class="dato tinta">{f.valor}</span></p>)}
          </div>
        </div>
      ))}
    </section>

    {/* 5 · SERVICIOS (§2.1, fila 5): Desarrollo web primero y a la escala de la declaración; los otros tres a título;
         Paid Media y redes en una línea. Precios en blanco, iguales a los JSON. */}
    <section class="seccion reticula servicios" aria-labelledby="h-serv">
      <div class="servicios__cab">
        <h2 class="t-declaracion" id="h-serv"><span class="tinta">{dos('home.servicios.h2').tinta}</span> <span class="gris">{dos('home.servicios.h2').gris}</span></h2>
        <p class="cuerpo caja">{t('home.servicios.guia').texto}</p>
      </div>
      {filas.map((f) => (
        <div class:list={['servicio', 'borde', { 'servicio--puerta': f.puerta }]}>
          <p class="servicio__sit cuerpo">{f.situacion}</p>
          <div class="servicio__cuerpo">
            <h3 class={f.puerta ? 't-declaracion' : 't-titulo'}>{f.nombre}</h3>
            <p class="cuerpo caja">{f.texto}</p>
            {f.escena && <p class="chico caja">{f.escena}</p>}
          </div>
          <div class="servicio__precio">
            <p class="cuerpo valor">{f.precio}</p>
            <a class:list={['boton', f.puerta ? 'boton--claro' : 'boton--placa']} href={f.href}>{f.boton}<Icono nombre="flecha" /></a>
          </div>
        </div>
      ))}
      <p class="servicios__tambien cuerpo">{trozos.map((p) => (p.href ? <a href={p.href}>{p.texto}</a> : p.texto))}</p>
    </section>

    {/* 6 · QUIÉN ESTÁ DETRÁS (§2.1, fila 6): el retrato 3:4 entero y grande; el texto apoyado abajo. */}
    <section class="seccion reticula quien" aria-labelledby="h-quien">
      <div class="quien__retrato" data-entrada>
        <Imagen src={m['ramon-vallejos-34'].src} alt={t('home.quien.retrato').texto} ancho={m['ramon-vallejos-34'].ancho} alto={m['ramon-vallejos-34'].alto} clase="p-34" />
      </div>
      <div class="quien__txt">
        <h2 class="t-declaracion" id="h-quien"><span class="tinta">{dos('home.quien.h2').tinta}</span> <span class="gris">{dos('home.quien.h2').gris}</span></h2>
        <p class="cuerpo caja">{t('home.quien.cv').texto}</p>
        <p class="cuerpo caja">{t('home.quien.publicado').texto}</p>
        <a class="boton boton--placa" href={t('home.quien.boton').destino}>{t('home.quien.boton').texto}<Icono nombre="flecha" /></a>
      </div>
    </section>

    {/* 7 · CONTACTO (§2.1, fila 7). */}
    <section class="seccion reticula contacto" aria-labelledby="h-contacto">
      <div class="contacto__txt">
        <h2 class="t-declaracion" id="h-contacto"><span class="tinta">{dos('home.contacto.h2').tinta}</span> <span class="gris">{dos('home.contacto.h2').gris}</span></h2>
        <p class="cuerpo caja">{t('home.contacto.que-es').texto}</p>
        <p class="cuerpo caja">{t('home.contacto.de-cero').texto}</p>
        <a class="boton boton--claro" href={t('home.contacto.boton').destino}>{t('home.contacto.boton').texto}<Icono nombre="flecha" /></a>
        <p class="chico"><a href="mailto:hola@spindlelab.cl">{t('home.contacto.correo').texto}</a></p>
      </div>
    </section>
  </PaginaA>
</Layout>

<script>
  import '../../scripts/archivo/cinta.mjs';
</script>
