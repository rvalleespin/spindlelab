---
// DIAGNÓSTICO — plantilla «herramienta» del sistema driftime (5-oct-2026).
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md, §4 fila Herramienta:
// h1 60 px + una línea → el instrumento como protagonista → secciones pegajosas de apoyo.
// Implementación de referencia: v3/index.astro (el instrumento .d-instr) y
// v3/servicios/desarrollo-web.astro (cabecera, sangre, d-entrada, d-sec, d-filas).
// Lo que había antes en este archivo (ritmo tinta → papel → brasa) está en el git.
//
// ESTA ES LA PÁGINA DELICADA. El chequeo es una herramienta que funciona de verdad:
//   · El formulario necesita los id exactos chq-form, chq-dominio y chq-btn.
//   · El script escribe resultados dentro de #chq-out y errores en #chq-error.
//   · Llama a /api/chequeo e inyecta clases chq-* por innerHTML.
// El marcado del formulario es el mismo de la home (.d-instr / .d-dom). El script va tal
// cual (/assets/js/v3-chequeo.js) y sus estilos también (styles/chequeo-v3.css).
//
// EL RESULTADO DEL CHEQUEO tiene un solo dueño: chequeo-v3.css, bloque «EN EL SISTEMA
// DRIFTIME (5-oct)» (variables mapeadas a los tokens d-*, botones del remate a 36 px, texto
// negro en .chq-r1). Spec §7. Esta página NO repite esas reglas: solo ubica el resultado
// bajo el instrumento (márgenes). Medido con una respuesta simulada de /api/chequeo.
//
// EL COPY. Sale de paginas-v3.json salvo:
//   · los tres bloques con su peso y las dos notas de «no mide» y «lo que muestran las
//     corridas», que el JSON perdió y están en la página publicada
//     (public/diagnostico/index.html), de donde se copian tal cual;
//   · cuatro textos que el QA del 5-oct devolvió y que en el JSON siguen como antes (la
//     corrección va propuesta a Clara/Simón; cuando el JSON cambie, se vuelve a leer de ahí):
//     la línea bajo el h1 (nombraba a Gemini, que functions/api/chequeo.js no prueba en
//     vivo, y omitía a Claude, que sí), la guía de la entrada (sin «Cada vez más…»), el
//     rótulo de «Los 21 chequeos» (sin la comparación con «ninguna herramienta del rubro»,
//     más amplia que su respaldo) y el rótulo del cierre (sin pregunta ni «sin compromiso»);
//   · dos más que el QA del 6-oct devolvió: la meta description (también nombraba a
//     Gemini) y la nota «Y cómo medimos si la IA te nombra.» (sus cifras, 5 preguntas × 3
//     motores, no son las de los planes en servicios-v3.json, y repetía la guía).
// Las cinco preguntas van juntas en «Lo que solemos responder», como el FAQPage.
// Los desvíos de la plantilla Herramienta (spec §4) están declarados en spec §7.
import Layout from '../../layouts/Layout.astro';
import { CONTACTO_V3 as CONTACTO } from '../../consts-v3';
import NavV3 from '../../components/v3/NavV3.astro';
import FooterV3 from '../../components/v3/FooterV3.astro';
import Pieza from '../../components/v3/Pieza.astro';
import Miga from '../../components/v3/Miga.astro';
import paginas from '../../data/paginas-v3.json';
import obra from '../../data/obra-v3.json';
import '../../styles/chequeo-v3.css'; // el resultado del chequeo se pinta con estas clases
import '../../styles/driftime.css';

const s = (paginas as Record<string, any>).diagnostico;
// La quinta sección del JSON (el cierre) no se lee: su rótulo va reescrito abajo (ver cabecera).
const [chequeos, caminos, ley, responde] = s.secciones;

// Los h2 de sección van sin punto final, como en las otras 19 rutas («Lo que incluye», «Qué
// pasa después»). El JSON los trae con punto; se quita al pintar (el mismo sinPunto de
// servicios/[slug].astro). Revisión cruzada, 6-oct.
const sinPunto = (t: string) => t.replace(/\.\s*$/, '');

// Verifica y Cumple aparece donde se habla de Verifica y Cumple: es la herramienta misma,
// producto propio, no un resultado del chequeo.
const vyc = obra.casos.find((c: any) => c.slug === 'verifica-y-cumple') as any;

// La meta description (y og:description, que el Layout saca de la misma prop) va escrita
// aquí y no leída de s.description (QA 6-oct, spec §7): el JSON nombra a Gemini, que
// functions/api/chequeo.js no prueba en vivo, y omite a Claude, que sí. Es la misma
// corrección de la línea bajo el h1; sin esto, Google y la tarjeta al compartir decían
// otra cosa que la página (antislop C8). Cuando el JSON cambie, se vuelve a leer de ahí.
const descripcion = 'Pon tu dominio y revisamos al instante si ChatGPT, Claude y Perplexity pueden leerte, entenderte y citarte. Gratis, con los 21 chequeos y su puntaje publicados.';

// UN NOMBRE PARA ESTA PÁGINA: «Chequeo gratis», el del menú y el pie (revisión cruzada,
// 6-oct; spec §7, miga = menú). El JSON publicado la llama «Chequeo de visibilidad en IA» en
// la miga; se sobrescribe la posición 2 al serializar, el patrón de servicios/index.astro.
// El <title> conserva el nombre largo («Chequeo gratis de visibilidad en IA…»).
const MIGA = 'Chequeo gratis';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${s.canonical}#breadcrumb`,
      itemListElement: (s.breadcrumb ?? [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://spindlelab.cl/' },
        { '@type': 'ListItem', position: 2, name: MIGA },
      ]).map((li: any) => (li.position === 2 ? { ...li, name: MIGA } : li)),
    },
    ...(s.faq?.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${s.canonical}#faq`,
          mainEntity: s.faq.map((f: any) => ({
            '@type': 'Question',
            name: f.p,
            acceptedAnswer: { '@type': 'Answer', text: f.r },
          })),
        }]
      : []),
  ],
};
---

<Layout title={s.title} description={descripcion} bodyClass="d-body">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <NavV3 />

  {/* Plantilla «herramienta» (spec §4). Sin display: las internas tienen cero usos de
       Manrope 800 en mayúsculas. */}
  <main>
    <header class="d-cab d-cab-diag">
      <Miga items={[{ label: 'Inicio', href: '/v3/' }, { label: MIGA }]} />
      <h1 class="d-h1">{s.h1}</h1>
      {/* Los motores que nombra son los que el chequeo prueba en vivo (functions/api/chequeo.js:
           OAI-SearchBot/ChatGPT-User, Claude-SearchBot/Claude-User, PerplexityBot/Perplexity-User).
           Gemini no: Google-Extended cuenta como robot de entrenamiento. */}
      <p class="d-linea">Pon tu dominio y revisamos al instante si los robots de ChatGPT, Claude y Perplexity pueden entrar a tu sitio, y si la IA puede entender qué haces y citarte.</p>

      {/* EL INSTRUMENTO. Los id son contrato con el script: no tocar. */}
      <div class="d-instr d-instr-diag" id="chequeo">
        <form class="d-dom chq-form" id="chq-form" novalidate aria-describedby="chq-nota" data-contacto={CONTACTO}>
          <label for="chq-dominio" class="d-sr">Tu dominio</label>
          <input id="chq-dominio" name="dominio" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="tuempresa.cl" required />
          <button id="chq-btn" type="submit">Revisar mi sitio</button>
        </form>
        <p class="d-nota" id="chq-nota"><b>Gratis y sin dejar tu correo.</b> Leemos solo páginas públicas, las mismas que lee cualquier buscador.</p>
        <div class="chq-error" id="chq-error" role="alert"></div>
        <div class="d-res-diag">
          {/* Sin este h2 el resultado salta de h1 a h3. Se muestra solo cuando hay resultado. */}
          <h2 class="d-sr">Resultado del chequeo</h2>
          <div id="chq-out" aria-live="polite"></div>
        </div>
      </div>
    </header>

    <figure class="d-sangre"><img src="/assets/img/d/hilo.jpg" alt="Un hilo luminoso cruza en diagonal un fondo verde oscuro" width="1400" height="787" loading="eager" fetchpriority="high" decoding="async" style="object-position:50% 55%" /></figure>

    {/* El primer «Pedirlo» de la página (brief §3: lo que tiene que pasar en /diagnostico/).
         Secundario y de 36 px: el protagonista sigue siendo el instrumento. */}
    <div class="d-entrada">
      <p class="d-nota-card"><b>21 chequeos, 100 puntos.</b> Tres bloques, con su peso a la vista: leerte 30, entenderte 40, citarte 30.</p>
      <div class="d-entrada-diag">
        {/* «mini-diagnóstico», no «diagnóstico completo» (QA final, conversión 8): el paso gratis
             tenía dos nombres en el mismo recorrido, y al lado Auditoría vende la «Auditoría
             Completa». Es el nombre con que contacto lo ofrece; el botón dice la forma corta. */}
        <p class="d-guia">El chequeo de esta página lee tu sitio; el mini-diagnóstico le pregunta a los motores. Los dos son gratis.</p>
        <div class="d-btns"><a class="d-btn d-btn--alt" href={CONTACTO}>Pedir el diagnóstico</a></div>
      </div>
    </div>

    {/* QUÉ REVISA */}
    <section class="d-sec" id="metodologia" aria-labelledby="s-che">
      <div class="d-eti"><h2 class="d-h2" id="s-che">{sinPunto(chequeos.h2)}</h2><p class="d-chico">La metodología completa, con el peso de cada bloque, para que puedas repetir el chequeo a mano si quieres.</p></div>
      <div class="d-filas">
        <div class="d-plan">
          <h3 class="d-h3">¿Te pueden leer?</h3><span class="d-plan__precio">30 puntos</span>
          <p class="d-cuerpo">No todos los robots de IA hacen lo mismo: unos <b>buscan en vivo</b> cuando alguien pregunta (OAI-SearchBot, ChatGPT-User, Claude-SearchBot, Claude-User, PerplexityBot, Perplexity-User) y otros <b>recogen texto para entrenar modelos futuros</b> (GPTBot, ClaudeBot, Google-Extended, CCBot). Bloquear a los primeros te borra de las respuestas de hoy; bloquear a los segundos no te quita ni una cita y es una decisión legítima. Verificamos ambos por separado, probamos si tu servidor expulsa a los robots por su nombre, y que el sitio responda 200 por HTTPS. Si los bots en vivo no entran, nada de lo demás importa.</p>
        </div>
        <div class="d-plan">
          <h3 class="d-h3">¿Te entienden?</h3><span class="d-plan__precio">40 puntos</span>
          <p class="d-cuerpo">Revisamos tus datos estructurados: si declaras tu negocio como entidad, si esa entidad tiene dirección y contacto, si te conectas con al menos tres perfiles externos, y si hay una persona con credenciales detrás del contenido. Más el título, la meta description y el H1.</p>
        </div>
        <div class="d-plan">
          <h3 class="d-h3">¿Te pueden citar?</h3><span class="d-plan__precio">30 puntos</span>
          <p class="d-cuerpo">Comprobamos llms.txt, preguntas frecuentes marcadas con FAQPage, sitemap.xml, URL canónica, idioma declarado, títulos escritos como pregunta, fechas en el schema y cantidad de texto visible en tu portada.</p>
        </div>
      </div>
    </section>

    {/* QUÉ NO REVISA */}
    {/* Sin guía (QA 5-oct, regla del 30 %). Quedan las dos notas de la página publicada.
         La primera va escrita aquí y no leída de chequeos.bloques[0].d (QA 6-oct, spec §7):
         el JSON decía «cinco preguntas fijas por tres motores (ChatGPT, Gemini y
         Perplexity)», que es el Índice de Citabilidad propio (marketing/metricas/
         test-menciones-ia.md), no lo que traen los planes (servicios-v3.json: ~10 consultas
         en 3 motores en Esencial, ~20 en 4 en Pro). Sin cifras, con la nota de
         servicios-v3.json: «mismas consultas, mismos motores, misma cadencia». Y abre
         diciendo qué no mide, que es lo que promete el h2 (antes repetía la guía de la
         entrada: «El chequeo de arriba lee tu sitio. Esto le pregunta a los motores.»). */}
    <section class="d-sec" aria-labelledby="s-nom">
      <div class="d-eti"><h2 class="d-h2" id="s-nom">Lo que este chequeo no mide</h2></div>
      <div class="d-filas d-filas-diag">
        <div><h3 class="d-h3">Y cómo medimos si la IA te nombra</h3><p class="d-cuerpo">No mide si hoy te citan: para eso hay que preguntarle a los motores. En los planes con acompañamiento lo hacemos cada mes con las mismas preguntas y en los mismos motores, con fecha y con la fuente de cada respuesta registrada. Cambiar las preguntas rompería la comparación entre meses.</p></div>
        <div><h3 class="d-h3">Lo que muestran las corridas</h3><p class="d-cuerpo">Quienes aparecen recomendados casi nunca lo consiguen desde su propio sitio: los motores los citan desde rankings, directorios y artículos de terceros. Sin saber de dónde sale la recomendación, no hay nada que trabajar.</p></div>
      </div>
    </section>

    {/* QUÉ PASA DESPUÉS */}
    <section class="d-sec" aria-labelledby="s-cam">
      <div class="d-eti"><h2 class="d-h2" id="s-cam">{sinPunto(caminos.h2)}</h2></div>
      <div>
        <div class="d-filas">
          {caminos.bloques.map((b: any, i: number) => (
            <div class="d-fase"><span class="d-fase__n">{String(i + 1).padStart(2, '0')}</span><h3 class="d-h3">{b.t}</h3><p class="d-cuerpo">{b.d}</p></div>
          ))}
        </div>
        <div class="d-btns d-btns-diag"><a class="d-btn" href={CONTACTO}>Pedir el diagnóstico</a><a class="d-btn d-btn--alt" href="#chequeo">Volver al chequeo</a></div>
      </div>
    </section>

    {/* ADEMÁS: la otra herramienta propia */}
    <section class="d-sec" aria-labelledby="s-ley">
      <div class="d-eti"><h2 class="d-h2" id="s-ley">{sinPunto(ley.h2)}</h2></div>
      <div>
        <p class="d-guia">{ley.parrafos[0]}</p>
        {/* Secundario (QA 6-oct): bajo el instrumento, el único botón papel es «Pedir el
             diagnóstico»; este lleva a otro producto. */}
        <div class="d-btns d-btns-diag"><a class="d-btn d-btn--alt" href="https://verifica.spindlelab.cl/" rel="noopener">Revisar mi sitio para la Ley 21.719</a></div>
        {vyc && <Pieza src={vyc.mock} alt={vyc.altMock} etiquetas={[`${vyc.n} · Producto propio`]} clase="d-vyc-diag" ancho={1600} alto={1200} />}
      </div>
    </section>

    {/* PREGUNTAS */}
    <section class="d-sec d-faq" aria-labelledby="s-faq">
      <div class="d-eti"><h2 class="d-h2" id="s-faq">{sinPunto(responde.h2)}</h2></div>
      <div class="d-filas">
        {s.faq.map((f: any) => (<div><h3 class="d-h3">{f.p}</h3><p class="d-cuerpo">{f.r}</p></div>))}
      </div>
    </section>

    {/* El CTA dice qué pasa al hacer clic (antislop A5). Los botones dicen «el diagnóstico»,
         sin «completo»: contacto lo ofrece como «mini-diagnóstico» y los dos adjetivos se
         contradecían justo en el clic (QA 5-oct; el nombre único queda para Clara). */}
    <a class="d-siguiente d-siguiente-diag" href={CONTACTO}><span class="d-chico d-gris">Una página, gratis, en 24 horas.</span><span class="d-h1">Pedir el diagnóstico →</span></a>
  </main>

  <FooterV3 />

  {/* ?v=2: el archivo cambió en la QA final (enlaces con ?sitio= y botón junto al puntaje) y
       /assets/* se cachea 7 días. */}
  <script src="/assets/js/v3-chequeo.js?v=2" is:inline defer></script>
</Layout>

<style>
  /* El instrumento: mismo marcado y clases que la home; aquí va debajo del h1. */
  /* Los colores, bordes y botones del resultado son de chequeo-v3.css (ver cabecera);
     aquí solo su lugar bajo el instrumento. */
  .d-instr-diag { margin-top: 4px; scroll-margin-top: 120px; }
  .d-instr-diag .chq-error { margin-top: 12px; }
  .d-instr-diag #chq-out { margin-top: 28px; }
  .d-res-diag:not(:has(#chq-out[style*='block'])) h2 { display: none; }

  .d-entrada-diag .d-btns { margin-top: 22px; }
  .d-cuerpo b { color: var(--d-papel); font-weight: 600; }
  .d-filas-diag .d-h3 { margin-bottom: 8px; }
  .d-btns-diag { margin-top: 28px; }
  :global(.d-vyc-diag) { aspect-ratio: 4 / 3; margin-top: 36px; }
  .d-siguiente-diag .d-chico { max-width: 340px; }

  @media (max-width: 767px) {
    /* El instrumento tiene que quedar arriba del pliegue y pulsable con el aviso de
       cookies abierto, también en un teléfono de 667 px de alto. 100 px y no 124 (QA
       6-oct): con el campo a su alto de 52 px (arreglo propuesto para driftime.css; hoy
       el flex: 1 lo encoge a 24) la nota terminaba en y=537, justo donde empieza el
       aviso. Medido a 375 × 667 con el campo a 52: botón 381–429, nota hasta 513, aviso
       en 537. El módulo de nav fijo termina en 86: la miga queda 14 px bajo él. */
    .d-cab-diag { padding-top: 100px; }
    /* La guía va antes de la nota, como en desarrollo-web (driftime.css lo hace con la
       .d-guia suelta; aquí va envuelta con su botón). */
    .d-entrada-diag { order: -1; }
    .d-siguiente-diag { flex-direction: column; align-items: flex-start; gap: 12px; }
  }
</style>
