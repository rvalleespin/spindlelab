---
// CONTACTO, en el lenguaje driftime (5-oct-2026). Plantilla «herramienta» (spec §4):
// h1 60 px + una línea → el FORMULARIO como protagonista → secciones pegajosas de apoyo.
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md
//
// EL FORMULARIO VA VERBATIM en lo que importa: mismo action de web3forms, mismos hidden
// (access_key, subject, from_name), el honeypot (botcheck), los mismos name e id de cada
// campo, los tres UTM ocultos y la casilla de consentimiento. Solo cambia la presentación.
// Reimplementar esto es como se rompe la captación de leads sin que nadie se entere hasta
// que dejan de llegar correos.
//
// El script tampoco se toca: /assets/js/v3-contacto.js, sacado tal cual de la página
// publicada. Necesita .contact-form, #f-utm-source/medium/campaign, .form-status,
// .form-success y un button[type=submit] dentro del form. Esos nombres NO se tocan.
//
// DOS COSAS QUE ESTE ARCHIVO CUIDA Y QUE NO SE VEN EN LA CAPTURA:
// · .form-success FALTABA en la versión anterior de esta maqueta. El script hace
//   `success.hidden = false` sin comprobar que exista: un envío que SÍ llegaba lanzaba un
//   TypeError, caía en el catch y le mostraba «Algo falló al enviar» a quien acababa de
//   escribir. Vuelve con el texto de producción.
// · El script reemplaza className de .form-status (`'form-status show err'`): cualquier
//   clase extra puesta ahí se pierde al enviar. Por eso se estila desde el padre.
// · El form y .form-success se muestran/ocultan con el atributo hidden. Si una regla les
//   pone display, el hidden deja de funcionar: de ahí los [hidden] { display: none }.
//
// En producción el botón es `btn gold`. Acá no: el único oro de la vista es el punto del
// wordmark del módulo (spec §1 y §6).
//
// La foto que usaba la versión anterior (hero-contacto.jpg) está en la lista negra de la
// spec (§5: hero-*.jpg). Sale. Y la que la reemplazó (ventana.jpg a sangre entre el
// formulario y los pasos) también salió en el QA del 5-oct: la plantilla Herramienta no
// lleva imagen, esa foto ya está en cuatro páginas y aquí separaba el formulario de su
// respaldo con casi una pantalla de atmósfera.
import Layout from '../../layouts/Layout.astro';
import NavV3 from '../../components/v3/NavV3.astro';
import FooterV3 from '../../components/v3/FooterV3.astro';
import Miga from '../../components/v3/Miga.astro';
import { EMAIL } from '../../consts';
import paginas from '../../data/paginas-v3.json';
import '../../styles/driftime.css';

const s = (paginas as Record<string, any>).contacto;
const [proyecto, pasos, antes] = s.secciones;
// «Tu URL.» y «24 horas.» no se parten: a 390 px el h1 dejaba «horas.» sola en la línea.
const h1 = s.h1.replace('Tu URL', 'Tu\u00a0URL').replace('24 horas', '24\u00a0horas');
const listo = proyecto.bloques?.[0] ?? { t: 'Listo.', d: 'Te escribimos dentro de 24 horas con tu mini-diagnóstico.' };

// RÓTULOS (QA 5-oct). Los h2 del JSON eran plantilla: «Cuéntanos de tu proyecto» (el titular
// por defecto de cualquier formulario, y aquí no se pide un proyecto sino la URL de un sitio
// que ya existe) y «Tres pasos, cero fricción» (jerga de producto, manual §01). Se nombra lo
// que pasa. Mientras el JSON no cambie, el rótulo se fija aquí; está propuesto el cambio
// en src/data/paginas-v3.json para que no dependa de esta página.
const h2Form = 'Pide tu mini-diagnóstico';
const h2Pasos = 'Qué pasa después';

// El botón dice qué recibe la persona, no «Enviar» (antislop A5). v3-contacto.js le vuelve
// a poner 'Enviar →' cuando el envío falla; el script de abajo lo devuelve a este texto.
const etiquetaEnvio = 'Pedir mi mini-diagnóstico →';

// FAQ (QA 5-oct, BLOQUEANTE). faq[2].r en el JSON dice «estamos acostumbrados a trabajar
// bajo NDA»: afirma experiencia repetida con clientes financieros que nada en el repo
// respalda (ventas/ registra un cliente entregado, no financiero, y ningún NDA). La versión
// honesta es la que ya está a la vista en la página publicada (public/contacto/index.html,
// FAQ visible) y la que el mismo JSON guarda en secciones[2].parrafos[2]. Se usa esa, y como
// el texto visible y el FAQPage salen de este mismo arreglo, los dos quedan corregidos.
// Cuando el JSON se arregle (propuesto), este reemplazo deja de hacer nada.
const NDA_P = '¿Firman acuerdos de confidencialidad?';
const NDA_R = 'Sí, sin problema. En sectores financieros es práctica habitual y trabajamos bajo NDA cuando el cliente lo requiere.';
const faq = (s.faq ?? []).map((f: any) => (f.p === NDA_P ? { ...f, r: NDA_R } : f));

// El mismo mailto de la página publicada: asunto y arranque del cuerpo ya escritos.
const mailto = `mailto:${EMAIL}?subject=Diagn%C3%B3stico%20gratis&body=Hola%2C%20mi%20sitio%20es%3A%20`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${s.canonical}#breadcrumb`,
      itemListElement: s.breadcrumb ?? [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://spindlelab.cl/' },
        { '@type': 'ListItem', position: 2, name: 'Contacto' },
      ],
    },
    ...(faq.length
      ? [{
          '@type': 'FAQPage',
          '@id': `${s.canonical}#faq`,
          mainEntity: faq.map((f: any) => ({
            '@type': 'Question',
            name: f.p,
            acceptedAnswer: { '@type': 'Answer', text: f.r },
          })),
        }]
      : []),
  ],
};
---

<Layout title={s.title} description={s.description} bodyClass="d-body">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <NavV3 />

  {/* Sin display: las internas tienen cero usos de Manrope 800 en mayúsculas. */}
  <main>
    <header class="d-cab d-cab--ct">
      <Miga items={[{ label: 'Inicio', href: '/v3/' }, { label: 'Contacto' }]} />
      <h1 class="d-h1">{h1}</h1>
      {/* Escrita en la página (el lead del JSON es otro texto, más largo): sexto texto de la
           fila de contacto de spec §7, propuesto como campo `linea` en paginas-v3.json. Sin
           «sin compromiso»: es frase de folleto y la pregunta 1 ya lo responde (QA2 6-oct).
           «mini-diagnóstico, gratis.» no se parte: a 1440 dejaba «gratis.» sola en la segunda
           línea, y un espacio duro solo movía el corte al guion («mini-/diagnóstico»). */}
      <p class="d-linea">Escríbenos con la dirección de tu sitio y recibes el <span class="d-ct-junto">mini-diagnóstico, gratis.</span></p>
    </header>

    {/* El formulario ocupa el lugar que en un caso de driftime tiene la imagen a sangre: es
         lo primero que se ve después del título, entero sobre el pliegue a 1440×900. */}
    <section class="d-ct" id="contacto-form" aria-labelledby="s-form">
      {/* Solo el h2: el párrafo que iba aquí repetía plazo y formato (h1, línea, paso 02 y
           pregunta 1 ya los dicen) y a 390 dejaba «Sitio web» bajo el aviso de cookies. */}
      <div class="d-ct-eti">
        <h2 class="d-h2" id="s-form">{h2Form}</h2>
      </div>

      <div class="d-ct-zona">
        <form class="contact-form d-ct-form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="f3a309f5-cbe6-4cf1-b77f-cfd0ee92685f" />
          <input type="hidden" name="subject" value="Nuevo contacto desde spindlelab.cl" />
          <input type="hidden" name="from_name" value="Formulario spindlelab.cl" />
          {/* Honeypot: invisible para personas, tentador para bots. No quitar. */}
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

          <div class="d-ct-par">
            <div class="d-ct-campo">
              <label for="f-nombre">Nombre</label>
              <input type="text" id="f-nombre" name="Nombre" autocomplete="name" required />
            </div>
            <div class="d-ct-campo">
              <label for="f-email">Email</label>
              <input type="email" id="f-email" name="Email" autocomplete="email" required />
            </div>
          </div>

          {/* Ayuda para quien todavía no tiene sitio (QA final, conversión 9). Cada
               «Escríbenos» de Desarrollo web llega aquí, y «Sitio web» es obligatorio: quien va a
               construir su primer sitio no sabía qué poner. Sin renombrar nada ni quitar el
               required (spec §6; quitarlo lo decide Ramón). El texto sale de la página publicada
               de Desarrollo web («Si partes de cero, conversemos tu proyecto directamente.») y
               del arreglo de la QA («no tengo»). El campo la anuncia con aria-describedby. */}
          <div class="d-ct-campo">
            <label for="f-sitio">Sitio web</label>
            <input type="text" id="f-sitio" name="Sitio web" placeholder="tuempresa.cl" autocomplete="url" aria-describedby="f-sitio-ayuda" required />
            <p class="d-ct-ayuda" id="f-sitio-ayuda">Si partes de cero, escribe «no tengo» y cuéntanos tu proyecto abajo.</p>
          </div>

          <div class="d-ct-campo">
            <label for="f-mensaje">Cuéntanos brevemente <span>(opcional)</span></label>
            <textarea id="f-mensaje" name="Mensaje" rows="3" placeholder="Qué hace tu empresa, qué te preocupa de tu sitio…"></textarea>
          </div>

          {/* Los rellena el script con los UTM de la visita. */}
          <input type="hidden" name="UTM Source" id="f-utm-source" />
          <input type="hidden" name="UTM Medium" id="f-utm-medium" />
          <input type="hidden" name="UTM Campaign" id="f-utm-campaign" />

          <label class="d-ct-consiento">
            <input type="checkbox" id="f-consiento" name="Consiento" required />
            <span>Acepto que estos datos se usen para responder mi solicitud, según la <a href="/privacidad/" target="_blank" rel="noopener">política de privacidad</a>.</span>
          </label>

          <div class="d-ct-envio">
            <button type="submit" class="d-btn">{etiquetaEnvio}</button>
            <p class="form-status" role="status" aria-live="polite"></p>
          </div>
        </form>

        <div class="form-success d-ct-listo" role="status" aria-live="polite" hidden>
          <h3 class="d-h3">{listo.t}</h3>
          <p class="d-cuerpo">{listo.d}</p>
        </div>
      </div>

      <div class="d-ct-directo">
        <p class="d-chico d-gris">O escríbenos directo a</p>
        <a class="d-ct-correo" href={mailto}>{EMAIL}</a>
      </div>
    </section>

    {/* Los pasos van pegados al formulario: son su respaldo (qué pasa al enviarlo). */}
    <section class="d-sec d-pasos-ct" aria-labelledby="s-pasos">
      <div class="d-eti">
        <h2 class="d-h2" id="s-pasos">{h2Pasos}</h2>
      </div>
      <div class="d-filas">
        {(pasos.bloques ?? []).map((b: any, i: number) => (
          <div class="d-fase"><span class="d-fase__n">{String(i + 1).padStart(2, '0')}</span><h3 class="d-h3">{b.t}</h3><p class="d-cuerpo">{b.d}</p></div>
        ))}
      </div>
    </section>

    {/* Las preguntas visibles salen del MISMO arreglo que el FAQPage del JSON-LD (faq, con
         la respuesta del NDA corregida arriba): lo que se marca como respuesta tiene que
         estar a la vista, y decir lo mismo. */}
    <section class="d-sec d-faq" aria-labelledby="s-antes">
      <div class="d-eti"><h2 class="d-h2" id="s-antes">{antes.h2}</h2></div>
      <div class="d-filas">
        {faq.map((f: any) => (<div><h3 class="d-h3">{f.p}</h3><p class="d-cuerpo">{f.r}</p></div>))}
      </div>
    </section>
  </main>

  <FooterV3 />

  <script src="/assets/js/v3-contacto.js" is:inline defer></script>
  {/* Arreglos de esta página que no tocan archivos compartidos (el cuarto y el quinto se
       explican en su lugar, más abajo):
       1. En contacto, «Escríbenos» del módulo, del menú y del pie apuntaba a esta misma URL:
          recargaba, volvía arriba y podía borrar lo escrito. Aquí lleva al formulario
          (propuesto en NavV3 y FooterV3 comparando Astro.url.pathname; cuando entre, esto
          deja de hacer nada).
       2. v3-contacto.js devuelve el botón a 'Enviar →' cuando el envío falla. Si el botón
          queda habilitado con otro texto, se le devuelve el suyo.
       3. UTM: el puente por document.referrer que vivía aquí (QA 5-oct, spec §7) se retiró
          en la QA final: la captura está ahora en NavV3, en las 21 rutas, con las mismas
          claves de sessionStorage que lee v3-contacto.js, y cubre cualquier número de saltos.
          v3-contacto.js (defer) sigue siendo quien vuelca sessionStorage en #f-utm-*. */}
  <script is:inline>
    /* 5. El dominio que viene del chequeo (QA final, conversión 6). v3-chequeo.js manda
          ?sitio=<dominio> en los enlaces del resultado y del aviso de error; si «Sitio web»
          está vacío, se rellena con él. No pisa lo que el navegador o la persona ya pusieron,
          no renombra nada y no toca los UTM (solo lee el parámetro sitio). */
    (function () {
      try {
        var v = (new URLSearchParams(location.search).get('sitio') || '').trim().slice(0, 200);
        var campo = document.getElementById('f-sitio');
        if (v && campo && !campo.value) campo.value = v;
      } catch (e) {}
    })();
    (function () {
      document.querySelectorAll('a[href="/v3/contacto/"]').forEach(function (a) { a.setAttribute('href', '#contacto-form'); });
      var b = document.querySelector('.contact-form button[type="submit"]');
      if (!b || !('MutationObserver' in window)) return;
      var t = b.textContent;
      new MutationObserver(function () { if (!b.disabled && b.textContent !== t) b.textContent = t; })
        .observe(b, { childList: true, characterData: true, subtree: true, attributes: true, attributeFilter: ['disabled'] });
    })();
    /* 4. Envío correcto (QA2 6-oct, bloqueante). v3-contacto.js oculta el formulario y la
          página se acorta ~560 px: la caja «Listo.» quedaba sobre el borde superior, bajo el
          módulo, y el foco caía a BODY (el botón enfocado se ocultó). Al volverse visible, la
          caja toma el foco (eso además la anuncia: un role=status que pasa de hidden a
          visible no se lee de forma fiable) y, si no está entera entre el módulo y el borde
          inferior o el aviso de cookies, se centra. Sin animación con movimiento reducido. */
    (function () {
      var listo = document.querySelector('.form-success');
      if (!listo || !('MutationObserver' in window)) return;
      var mo = new MutationObserver(function () {
        if (listo.hidden) return;
        mo.disconnect();
        listo.tabIndex = -1;
        listo.focus({ preventScroll: true });
        var nav = document.querySelector('header.fixed');
        var arriba = nav ? nav.getBoundingClientRect().bottom : 0;
        var abajo = window.innerHeight;
        var aviso = document.getElementById('cookie-banner');
        if (aviso && aviso.getClientRects().length) {
          var ra = aviso.getBoundingClientRect();
          if (ra.height && ra.top < abajo) abajo = ra.top;
        }
        var r = listo.getBoundingClientRect();
        if (r.top < arriba + 8 || r.bottom > abajo - 8) {
          var quieto = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
          listo.scrollIntoView({ block: 'center', behavior: quieto ? 'auto' : 'smooth' });
        }
      });
      mo.observe(listo, { attributes: true, attributeFilter: ['hidden'] });
    })();
  </script>
</Layout>

<style>
  /* Solo lo que driftime.css no trae. Todo con sufijo -ct para no chocar. */

  /* Cabecera: la de un caso (.d-cab) pone el título a min(34vh, 300px). En una herramienta
     eso empuja el formulario bajo el pliegue; se acerca a lo que hace el hero de la home
     con el instrumento (112 px), dejando aire bajo el módulo de navegación. Medido a
     1440×900: botón en y 748–784, aviso de cookies en 823. Desvío declarado en la spec
     (§7, 5-oct, contacto). */
  .d-cab--ct { padding-top: 140px; padding-bottom: 0; }
  .d-cab--ct .d-linea { margin-bottom: 0; }
  .d-ct-junto { white-space: nowrap; }

  /* Formulario + su contexto: 5/12 a la izquierda (la etiqueta y el correo directo, este
     último apoyado abajo, a la altura del botón), 7/12 el formulario. La misma partición
     que .d-entrada y .d-sec. */
  .d-ct {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: auto 1fr;
    grid-template-areas: 'eti zona' 'directo zona';
    gap: 0 var(--d-g);
    padding: 48px var(--d-m) 0;
  }
  .d-ct-eti { grid-area: eti; display: flex; flex-direction: column; gap: 14px; padding-right: clamp(0px, 4vw, 64px); }
  .d-ct-zona { grid-area: zona; }
  .d-ct-directo { grid-area: directo; align-self: end; display: flex; flex-direction: column; gap: 4px; padding-top: 32px; }
  .d-ct-correo { font-size: clamp(1.25rem, 1.67vw, 1.5rem); line-height: 1.4; font-weight: 400; text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; align-self: flex-start; }
  .d-ct-correo:hover { text-decoration-thickness: 2px; }

  /* Los campos: módulo #161616, radio 6, etiqueta visible arriba. El borde va en papel al
     32 % y no al 12 % del filete: el límite de un control necesita 3:1 contra el lienzo
     (WCAG 1.4.11) y el filete da ~1,3:1. Medido (compuesto sobre el relleno del campo): al
     30 % daba 2,99:1, un pelo bajo el mínimo; al 32 % da 3,24:1. Componente declarado en la
     spec (§7, 5-oct, contacto). */
  .d-ct-form { display: flex; flex-direction: column; gap: 20px; color-scheme: dark; }
  .d-ct-form[hidden], .d-ct-listo[hidden] { display: none; }
  .d-ct-par { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px var(--d-g); }
  .d-ct-campo { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .d-ct-campo label { font-size: 0.9375rem; font-weight: 500; line-height: 1.4; color: var(--d-papel); }
  .d-ct-campo label span { color: var(--d-gris); font-weight: 400; }
  /* Ayuda bajo un campo: 14 px gris, pegada al campo que explica. */
  .d-ct-ayuda { margin: 0; font-size: 0.875rem; line-height: 1.5; color: var(--d-gris); }
  .d-ct-campo input,
  .d-ct-campo textarea {
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    background: var(--d-modulo);
    color: var(--d-papel);
    border: 1px solid rgba(247, 245, 240, 0.32);
    border-radius: var(--d-r);
    font: 400 1rem/1.5 'Manrope', system-ui, sans-serif;   /* 16 px: iOS no hace zoom al enfocar */
  }
  .d-ct-campo input { height: 48px; padding: 0 14px; }
  .d-ct-campo textarea { padding: 11px 14px; resize: vertical; min-height: 96px; display: block; }
  .d-ct-campo input::placeholder,
  .d-ct-campo textarea::placeholder { color: var(--d-gris); opacity: 1; }
  .d-ct-campo input:hover,
  .d-ct-campo textarea:hover { border-color: rgba(247, 245, 240, 0.5); }
  /* Foco: el contorno de 2 px en papel lo pone .d-body :focus-visible; acá el borde se
     enciende también, para que el campo activo se lea aunque el contorno quede tapado. */
  .d-ct-campo input:focus,
  .d-ct-campo textarea:focus { border-color: var(--d-papel); }
  /* El autocompletado de Chrome pinta el campo celeste: se devuelve al módulo. */
  .d-ct-campo input:-webkit-autofill { -webkit-text-fill-color: var(--d-papel); box-shadow: 0 0 0 1000px var(--d-modulo) inset; caret-color: var(--d-papel); }

  .d-ct-consiento { display: flex; align-items: flex-start; gap: 12px; font-size: 0.875rem; line-height: 1.5; color: var(--d-gris); cursor: pointer; max-width: 620px; }
  .d-ct-consiento input { flex: none; width: 18px; height: 18px; margin: 1px 0 0; accent-color: var(--d-papel); cursor: pointer; }
  .d-ct-consiento a { color: var(--d-papel); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  .d-ct-envio { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 16px; padding-top: 4px; }
  .d-ct-envio .d-btn:disabled { opacity: 0.6; cursor: progress; }
  /* El script reescribe className de .form-status: se estila desde el padre, nunca con
     una clase propia sobre el párrafo. Vacío no ocupa lugar. */
  .d-ct-envio :global(.form-status) { margin: 0; font-size: 0.875rem; line-height: 1.5; color: var(--d-gris); }
  .d-ct-envio :global(.form-status.err) { color: var(--d-papel); }

  /* Lo que reemplaza al formulario cuando el envío sale bien. */
  .d-ct-listo { background: var(--d-modulo); border-radius: var(--d-r); padding: 28px; display: flex; flex-direction: column; gap: 8px; }

  /* Al llegar por #contacto-form el módulo de navegación fijo no tapa el h2. */
  .d-ct { scroll-margin-top: 40px; }

  @media (max-width: 767px) {
    .d-cab--ct { padding-top: 112px; }
    /* Celular: etiqueta → formulario → correo directo. El correo no puede quedar antes del
       formulario: lo empujaría bajo el pliegue. */
    .d-ct {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: 'eti' 'zona' 'directo';
      gap: 28px;
      padding-top: 40px;
    }
    .d-ct-eti { padding-right: 0; gap: 10px; }
    .d-ct-directo { padding-top: 4px; }
    .d-ct-par { grid-template-columns: minmax(0, 1fr); }
    .d-ct-form { gap: 18px; }
    .d-ct { scroll-margin-top: 56px; }
    /* El número va sobre el título, como en Método: la columna de 56 px dejaba cada paso
       en 270 px de ancho. */
    .d-pasos-ct .d-fase { grid-template-columns: minmax(0, 1fr); }
    .d-pasos-ct .d-fase .d-cuerpo { grid-column: 1; }
