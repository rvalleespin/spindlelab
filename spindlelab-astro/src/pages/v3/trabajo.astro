  .d-cierre-trab .d-btns { margin-top: 28px; }
  /* Línea de precio en flujo de texto (spec §7): espacios reales entre las piezas, el
     separador aria-hidden y «$390.000 + IVA» que no se parte. Los márgenes se ajustan para
     que espacio real + margen midan lo mismo que en .d-precio. */
  .d-precio-trab { margin-top: 18px; }
  .d-precio-trab .d-pre-sep { margin: 0 0.5em 0 0.75em; }
