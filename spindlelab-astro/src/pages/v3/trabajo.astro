---
// ÍNDICE DE TRABAJO — sistema driftime (5-oct-2026).
//
// Contrato: marketing/oficina/obras-web/spindlelab-v3/spec-visual.md, §4 plantilla «Índice»:
// h1 60 px + entrada → piezas grandes con rótulo. Implementación de referencia:
// src/pages/v3/servicios/desarrollo-web.astro (cabecera, entrada, secciones pegajosas,
// galería) y src/pages/v3/servicios/index.astro (el otro índice).
//
// LA REFERENCIA: driftime.com/work. Una sola sección de proyectos, la imagen grande y el
// nombre chico debajo: la imagen hace el trabajo, la etiqueta solo identifica. Sus casos
// arman la galería en grillas asimétricas (a sangre, dos lado a lado, 1 + texto). Acá:
// una a sangre, un par 5 + 7 (no mitades iguales) y una de 8 columnas con su pie al lado
// (7 + 5 entre 1024 y 1279; apilada con el pie 5 + 7 entre 768 y 1023: el pie no baja de
// ~43 caracteres por línea en ningún ancho de tableta o escritorio, medido).
//
// QA INDEPENDIENTE (5-oct), lo que cambió: la línea de Raigal dice solo lo construido (una
// home); el alt del mockup en teléfono describe el teléfono; sin nota en la entrada (repetía
// la bajada y empujaba la obra bajo el aviso de cookies a 390); el cierre habla a todos, con
// el chequeo y el precio de entrada de Desarrollo Web, sin prometer piezas por rubro, y no
// se pega (--quieta); la barra de «Bernardo Combeau | Model» va en gris, en el h2 y en la
// etiqueta de la imagen; el grafo suma url, #breadcrumb y la lista de las cuatro piezas.
// Segunda pasada: el cierre nombraba a Gemini, que el chequeo no prueba en vivo; ahora dice
// ChatGPT, Claude y Perplexity, como el índice de servicios y el diagnóstico.
// QA2 (6-oct): la medida del pie y del cierre va en el párrafo y en em (28.5em, ≤ 68
// caracteres); el par del cierre es «Correr el chequeo» + «Pedir el diagnóstico» (Desarrollo
// Web lo lleva el «Siguiente»); la cabecera baja a 112 px en celular para que la obra asome
// sobre el aviso de cookies; «Herramienta · Producto propio» sin repetir «propio»; la línea
// de Raigal más corta. Las correcciones al JSON compartido están declaradas en spec §7.
//
// QA FINAL (6-oct): title con la consulta que la buscaría, «Trabajo: sitios que construimos ·
// SpindleLab» (técnica #13b; el de antes tenía 20 caracteres y ninguna palabra buscable); la
// etiqueta de cada imagen es el `rotulo` de obra-v3.json, el mismo de la home y de Desarrollo
// web (mirada #10: «Bernardo Combeau | Model · Cliente» mezclaba dos separadores y a 768 se
// partía en «Bernardo Combeau I / Model»). El nombre de marca con su barra queda solo donde se
// nombra el sitio: el h2 del pie, junto a su enlace. Miga con el componente Miga (técnica #12)
// y srcset con los mockups de 800 px (técnica #8).
//
// Clasifican por RUBRO, no por servicio, porque un prospecto se reconoce en su rubro, no en
// el nombre del servicio que le vendimos a otro. Acá igual.
//
// LAS CUATRO PIEZAS NO SON LO MISMO, Y EL SITIO LO DICE.
//   · cliente  — trabajo entregado a un cliente real (Combeau, con permiso)
//   · propio   — producto de la casa
//   · concepto — ejercicio: el cliente no existe
// El rótulo va en la pieza (arriba a la izquierda, spec §3) y se repite en el pie de cada
// una. La de concepto lleva además su rótulo en papel, y su pie dice que no existe.
//
// SIN DISPLAY: una interna tiene cero usos de Manrope 800 en mayúsculas (spec §2). La
// versión anterior de esta página ponía «TRABAJO» a 128 px en 800; ya no.
//
// EL JSON-LD va por el slot «head», como en desarrollo-web. La versión anterior lo pasaba
// como prop jsonLd al Layout, pero Layout.astro no declara esa prop: el grafo no salía en la
// página (medido el 5-oct: solo los tres nodos del Layout). Mismos dos nodos y mismo @id.
// isPartOf apuntaba a #sitio, un @id que no existe en ningún grafo del sitio; Layout emite
// el WebSite como #website, y es al que apuntan blog/ y nosotros/.
import Layout from '../../layouts/Layout.astro';
import NavV3 from '../../components/v3/NavV3.astro';
import FooterV3 from '../../components/v3/FooterV3.astro';
import Pieza from '../../components/v3/Pieza.astro';
import Miga from '../../components/v3/Miga.astro';
import '../../styles/driftime.css';
import obra from '../../data/obra-v3.json';
import oferta from '../../data/oferta-v3.json';
import { CONTACTO_V3 as CONTACTO } from '../../consts-v3';

const { casos } = obra;

// CORRECCIONES AL DATO COMPARTIDO (QA independiente, 5-oct). obra-v3.json no se edita desde
// una página: el cambio va propuesto a su dueño. Mientras tanto la página corrige lo suyo,
// y cada corrección se retira sola cuando el JSON la trae.
//  · Raigal: la línea decía «Sitio completo, del argumento clínico a la ficha de
//    tratamiento». Lo construido es UNA home (marketing/portafolio/01-raigal/ficha.md §Estado:
//    las internas siguen abiertas; sitio/ tiene un solo index.html, sin enlaces internos).
//    La línea nueva nombra solo las secciones que esa home tiene (verificadas en
//    sitio/index.html: #valores, #procedimiento, #especialista, «Lo que no te vamos a
//    prometer», #preguntas). QA2: «una home de una sola página» era redundante y la línea
//    tenía 31 palabras contra 17-20 de las otras tres; queda en 22, con «por ahora» porque
//    las internas siguen abiertas en la ficha. Redacción final: Clara.
//    Solo se reemplaza si el JSON trae todavía la frase vieja, exacta.
const LINEA_CORREGIDA: Record<string, { antes: string; ahora: string }> = {
  raigal: {
    antes: 'Clínica de implantología y rehabilitación oral. Sitio completo, del argumento clínico a la ficha de tratamiento.',
    ahora: 'Clínica de implantología. Por ahora, solo la portada: costo y plazos, etapas, la especialista, lo que no se promete y preguntas frecuentes.',
  },
};
//  · Verifica y Cumple: el rubro «Herramienta propia» junto al tipo «Producto propio» se
//    leía «Herramienta propia · Producto propio» (QA2, A10). El rubro que se propone al
//    dueño del JSON es «Herramienta»; mismo mecanismo: se retira solo cuando el JSON cambia.
const RUBRO_CORREGIDO: Record<string, { antes: string; ahora: string }> = {
  'verifica-y-cumple': { antes: 'Herramienta propia', ahora: 'Herramienta' },
};
//  · El mockup -alto es SOLO el teléfono (1000×1100, mirado). altMock describe el par
//    notebook + teléfono del -ancho. Hasta que el JSON traiga altMockAlto por caso, va acá.
const ALT_ALTO: Record<string, string> = {
  'combeau-modelo': 'El book de modelo de Bernardo Combeau abierto en un teléfono',
};

// El precio de entrada de Desarrollo Web, del mismo dato que la home y el índice de
// servicios: el primero de «$390.000 · $690.000 · $1.190.000». Spec §3: «Desde … + IVA».
const desdeWeb = oferta.momentos
  .flatMap((m: any) => m.items)
  .find((it: any) => it.href === '/v3/servicios/desarrollo-web/')
  ?.p.split(' · ')[0];

// «Bernardo Combeau | Model»: en Manrope la barra sube a la altura de las mayúsculas y se
// lee «Combeau I Model». En su propio sitio va en gris claro; acá, en --d-gris. El nombre no
// se toca: solo se parte para pintar la barra.
const partesNombre = (n: string) => n.split(' | ');

const ROTULO: Record<string, string> = {
  cliente: 'Cliente',
  propio: 'Producto propio',
  concepto: 'Pieza de concepto',
};

// Cada pieza con su forma en la composición: una a sangre, un par 5 + 7, y una de 8
// columnas con su pie al lado. Lo que pesa más en la página es trabajo de cliente; la pieza
// de concepto cierra y es la más chica de las anchas.
//   ancha — a todo el ancho, 16:9 (mockup de notebook + teléfono)
//   alta  — 5 de 12 columnas, 10:11 (mockup en teléfono)
//   media — 7 de 12, toma la altura de la alta (mockup de notebook + teléfono)
//   final — 8 de 12, 4:3, con el pie en las 4 columnas que quedan
// Raigal va en mockup y no en su portada plana: la portada trae el aviso de concepto
// impreso arriba, y el rótulo de la pieza le quedaba encima (medido el 5-oct). En el
// mockup el aviso queda dentro de las pantallas y el rótulo cae sobre el fondo.
// pos: el mockup a 16:9 se recorta (queda el 75 % del alto). Los dispositivos van del
// 18 % al 88,8 % del alto del archivo (medido). Anclado al 55 %, el notebook queda bajo el
// rótulo de la pieza y no detrás, y la base del teléfono sale entera.
const FORMAS: Record<string, { forma: string; src: (c: any) => string; alt: (c: any) => string; w: number; h: number; pos?: string }> = {
  'combeau-fotografia': { forma: 'ancha', src: (c) => c.mock, alt: (c) => c.altMock, w: 1600, h: 1200, pos: '50% 55%' },
  'combeau-modelo': { forma: 'alta', src: (c) => c.mockAlto, alt: (c) => c.altMockAlto ?? ALT_ALTO[c.slug] ?? c.altMock, w: 1000, h: 1100 },
  'verifica-y-cumple': { forma: 'media', src: (c) => c.mock, alt: (c) => c.altMock, w: 1600, h: 1200 },
  raigal: { forma: 'final', src: (c) => c.mock, alt: (c) => c.altMock, w: 1600, h: 1200 },
};

// PESO (QA final, técnica #8): cada mockup tiene su versión de 800 px. `sizes` es el ancho al
// que se pinta, con la cuenta del CSS de abajo (grilla de 12 en 100vw − 80, gutter 16): la
// ancha a todo el ancho; la alta en 5 columnas (0,417); la media en 7 columnas pero con el alto
// de la alta, así que el mockup 4:3 se pinta a 0,611 del ancho; la final en 8 columnas (7 entre
// 1024 y 1279, todo el ancho entre 768 y 1023). En celular, todas a todo el ancho.
const SIZES: Record<string, string> = {
  ancha: '(max-width: 767px) calc(100vw - 40px), calc(100vw - 80px)',
  alta: '(max-width: 767px) calc(100vw - 40px), calc((100vw - 80px) * 0.417)',
  media: '(max-width: 767px) calc(100vw - 40px), calc((100vw - 80px) * 0.611)',
  final: '(max-width: 767px) calc(100vw - 40px), (max-width: 1023px) calc(100vw - 80px), (max-width: 1279px) calc((100vw - 80px) * 0.583), calc((100vw - 80px) * 0.667)',
};
const srcsetDe = (src: string, w: number) => `${src.replace(/\.jpg$/, '-800.jpg')} 800w, ${src} ${w}w`;

const piezas = casos.map((c: any, i: number) => {
  const f = FORMAS[c.slug] ?? { forma: 'ancha', src: (x: any) => x.mock, alt: (x: any) => x.altMock, w: 1600, h: 1200 };
  const concepto = c.tipo === 'concepto';
  const fix = LINEA_CORREGIDA[c.slug];
  const fixRubro = RUBRO_CORREGIDO[c.slug];
  return {
    ...c,
    linea: fix && c.linea === fix.antes ? fix.ahora : c.linea,
    rubro: fixRubro && c.rubro === fixRubro.antes ? fixRubro.ahora : c.rubro,
    nombre: partesNombre(c.n),
    forma: f.forma,
    src: f.src(c),
    srcset: srcsetDe(f.src(c), f.w),
    sizes: SIZES[f.forma],
    altImg: f.alt(c),
    w: f.w,
    h: f.h,
    pos: f.pos,
    eager: i === 0,
    concepto,
    // El rótulo único de la obra (obra-v3.json), el mismo de la home y de Desarrollo web.
    etiquetas: [c.rotulo],
    // Lo que se lee en el enlace: el dominio, sin protocolo ni barra final.
    dominio: c.url ? c.url.replace(/^https?:\/\//, '').replace(/\/$/, '') : null,
  };
});

// Mismos dos nodos y mismo @id de la página. Se suma (QA, C8): url, el @id del breadcrumb
// (#breadcrumb, como en desarrollo-web y el índice de servicios) y mainEntity: la lista de
// las cuatro piezas, con su sitio cuando existe y, en Raigal, dicho que es un concepto.
const URL_PAGINA = 'https://spindlelab.cl/trabajo/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${URL_PAGINA}#pagina`,
      url: URL_PAGINA,
      name: 'Trabajo',
      description: obra.bajada,
      inLanguage: 'es-CL',
      isPartOf: { '@id': 'https://spindlelab.cl/#website' },
      breadcrumb: { '@id': `${URL_PAGINA}#breadcrumb` },
      mainEntity: {
        '@type': 'ItemList',
        '@id': `${URL_PAGINA}#piezas`,
        numberOfItems: piezas.length,
        itemListElement: piezas.map((p: any, i: number) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: p.url
            ? { '@type': 'WebSite', name: p.n, url: p.url, description: p.linea, creator: { '@id': 'https://spindlelab.cl/#org' } }
            : {
                '@type': 'CreativeWork',
                name: p.n,
                description: `Pieza de concepto: ${p.n} no existe y no es un cliente. Es un ejercicio de SpindleLab en el rubro de ${p.rubro.toLowerCase()}. ${p.linea}`,
                creator: { '@id': 'https://spindlelab.cl/#org' },
              },
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${URL_PAGINA}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://spindlelab.cl/' },
        { '@type': 'ListItem', position: 2, name: 'Trabajo' },
      ],
    },
  ],
};
---

<Layout
  title="Trabajo: sitios que construimos · SpindleLab"
  description={obra.bajada}
  bodyClass="d-body"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <NavV3 />

  <main>
    <header class="d-cab d-cab--trab">
      <Miga items={[{ label: 'Inicio', href: '/v3/' }, { label: 'Trabajo' }]} />
      <h1 class="d-h1">{obra.titulo}</h1>
    </header>

    {/* Sin nota: repetía la bajada (dos frases sobre el rotulado, ninguna sobre el trabajo)
        y a 390 empujaba la primera pieza bajo el aviso de cookies (QA, 5-oct). */}
    <div class="d-entrada d-entrada-trab">
      <p class="d-guia">{obra.bajada}</p>
    </div>

    {/* Las cuatro piezas. Cada una es un artículo: la imagen arriba y su pie debajo
        (nombre · rubro y tipo · la línea · el sitio en vivo). La imagen también enlaza,
        pero fuera del orden de tabulación: el enlace del pie es el que se anuncia. */}
    <div class="d-obras-trab">
      {piezas.map((p: any) => (
        <article class:list={['d-obra-trab', `d-obra-trab--${p.forma}`]} aria-labelledby={`o-${p.slug}`}>
          {p.url ? (
            <a class="d-obra-trab__img" href={p.url} target="_blank" rel="noopener" tabindex="-1">
              <Pieza src={p.src} srcset={p.srcset} sizes={p.sizes} alt={p.altImg} concepto={p.concepto} etiquetas={p.etiquetas} clase="d-obra-trab__fig" ancho={p.w} alto={p.h} eager={p.eager} posicion={p.pos} />
            </a>
          ) : (
            <div class="d-obra-trab__img">
              <Pieza src={p.src} srcset={p.srcset} sizes={p.sizes} alt={p.altImg} concepto={p.concepto} etiquetas={p.etiquetas} clase="d-obra-trab__fig" ancho={p.w} alto={p.h} eager={p.eager} posicion={p.pos} />
            </div>
          )}
          <div class="d-pie-trab">
            <div class="d-pie-trab__id">
              <h2 class="d-h3" id={`o-${p.slug}`}>{p.nombre.map((parte: string, i: number) => (i === 0 ? parte : [' ', <span class="d-barra-trab">|</span>, ' ', parte]))}</h2>
              <p class="d-rot">{p.rubro} · {ROTULO[p.tipo]}</p>
            </div>
            <div class="d-pie-trab__txt">
              <p class="d-cuerpo">{p.linea}</p>
              {p.concepto && (
                <p class="d-cuerpo"><b class="d-pie-trab__fuerte">{p.n} no existe.</b> Es un ejercicio para mostrar cómo trabajamos en este rubro, no un cliente.</p>
              )}
              {p.url && (
                <a class="d-btn d-btn--alt d-pie-trab__enlace" href={p.url} target="_blank" rel="noopener">
                  {p.dominio}<span class="d-sr">: ver el sitio de {p.n}, abre en una pestaña nueva</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    {/* El cierre, para todos: el que se reconoció en una pieza y el que no encontró su
        rubro. El paso gratis (el chequeo, que corre sobre cualquier sitio) y el precio de
        entrada de Desarrollo Web. Sin anunciar piezas futuras: el portafolio registra UNA
        pieza de concepto en el sitio (marketing/portafolio/README.md), no una serie por rubro.
        Sección corta: --quieta, la etiqueta no se pega (spec §7). Los motores que nombra el
        chequeo son los que functions/api/chequeo.js prueba (ChatGPT, Claude, Perplexity), con
        las mismas palabras que el índice de servicios: Gemini no se prueba en vivo. */}
    <section class="d-sec d-sec--quieta" aria-labelledby="s-cierre">
      <div class="d-eti"><h2 class="d-h2" id="s-cierre">Antes de construir el tuyo</h2></div>
      <div class="d-cierre-trab">
        <p class="d-guia">Pon tu dominio y ves en segundos si los robots de ChatGPT, Claude y Perplexity pueden entrar a tu sitio, sea cual sea el rubro. Es el mismo chequeo con el que partimos cada proyecto.</p>
        <p class="d-cuerpo">Si hay que construirlo de nuevo, eso es Desarrollo web: tres planes, y el valor final se cierra tras el diagnóstico gratuito.</p>
        <p class="d-precio d-precio-trab"><span class="d-pre-rot">Desde</span><span class="d-pre-sep" aria-hidden="true"></span> <span class="d-pre-junto-trab"><b>{desdeWeb}</b> <span class="d-pre-rot">+ IVA</span></span></p>
        {/* El par de cierre del sitio (spec §7, índice de servicios y Nosotros): el chequeo
            y el diagnóstico que el cuerpo nombra. Desarrollo Web lo lleva el «Siguiente»
            de abajo; un botón al mismo destino a 240 px repetía el llamado (QA2, A10). */}
        <div class="d-btns"><a class="d-btn" href="/v3/diagnostico/">Correr el chequeo</a><a class="d-btn d-btn--alt" href={CONTACTO}>Pedir el diagnóstico</a></div>
      </div>
    </section>

    <a class="d-siguiente" href="/v3/servicios/desarrollo-web/"><span class="d-chico d-gris">Siguiente</span><span class="d-h1">Desarrollo web&nbsp;→</span></a>
  </main>

  <FooterV3 />
</Layout>

<style>
  /* ------------------------------------------------------------ la composición */
  /* Grilla de 12, como .d-galeria. Cada artículo ocupa dos filas de la grilla (imagen y
     pie) con subgrid: así, en el par 5 + 7, las dos imágenes comparten alto y los dos pies
     arrancan a la misma altura, sin calcular a mano un ratio que calce. */
  .d-obras-trab {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--d-g);
    row-gap: 0;
    padding: 120px var(--d-m) 0;
  }
  .d-obra-trab {
    grid-column: 1 / -1;
    grid-row: span 2;
    display: grid;
    grid-template-columns: subgrid;
    grid-template-rows: subgrid;
    row-gap: 20px;
    margin-bottom: 120px;
  }
  .d-obra-trab:last-child { margin-bottom: 0; }
  .d-obra-trab--alta { grid-column: 1 / span 5; }
  .d-obra-trab--media { grid-column: 6 / -1; }

  .d-obra-trab__img { grid-column: 1 / -1; display: block; min-height: 0; text-decoration: none; }
  .d-obra-trab__img :global(.d-obra-trab__fig) { height: 100%; }
  .d-obra-trab--ancha :global(.d-obra-trab__fig) { aspect-ratio: 16 / 9; }
  .d-obra-trab--alta :global(.d-obra-trab__fig) { aspect-ratio: 10 / 11; }
  /* La media no lleva ratio: se estira al alto de la alta, su vecina de fila. */
  .d-obra-trab--final :global(.d-obra-trab__fig) { aspect-ratio: 4 / 3; }

  /* La final: imagen en 8 columnas y el pie en las 4 de la derecha, apoyado abajo (como
     el bloque «quién» de la home). Una sola fila: no necesita el subgrid de filas. */
  .d-obra-trab--final { grid-row: auto; grid-template-rows: auto; }
  .d-obra-trab--final .d-obra-trab__img { grid-column: 1 / span 8; }

  /* ------------------------------------------------------------ el pie de cada pieza */
  .d-pie-trab { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 14px; }
  .d-pie-trab__id { display: flex; flex-direction: column; gap: 4px; }
  .d-pie-trab__txt { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }
  /* La medida va en el párrafo y en em, no en el contenedor ni en px (manual §05, ≤ 68
     caracteres; spec §3 y §7): con 620 px y letra de 17 px eran 36,5 em y el pie llegaba a
     75-84 caracteres (QA2). 28.5em es el valor que la spec midió con Range para el cuerpo
     de 18 px en Manrope, el mismo de .d-fila-sidx__d del índice de servicios. */
  .d-pie-trab__txt .d-cuerpo { max-width: 28.5em; }
  .d-pie-trab__fuerte { color: var(--d-papel); font-weight: 600; }
  .d-pie-trab__enlace { margin-top: 6px; gap: 8px; }

  /* En la pieza a todo el ancho, el pie se parte 5 + 7, como las secciones pegajosas que
     vienen después: el nombre a la izquierda, la línea y el enlace a la derecha. */
  .d-obra-trab--ancha .d-pie-trab { display: grid; grid-template-columns: subgrid; }
  .d-obra-trab--ancha .d-pie-trab__id { grid-column: 1 / span 5; }
  .d-obra-trab--ancha .d-pie-trab__txt { grid-column: 6 / -1; }
  .d-obra-trab--final .d-pie-trab { grid-column: 9 / -1; align-self: end; padding-left: clamp(0px, 1.5vw, 24px); }

  /* «Bernardo Combeau | Model» en el h2 del pie: la barra en gris, como en su propio sitio.
     La etiqueta de la imagen ya no la lleva (usa el `rotulo` de la obra). */
  .d-barra-trab { color: var(--d-gris); font-weight: 400; }
  .d-obra-trab__img { position: relative; }

  /* La entrada sin nota: la bajada en las 7 columnas de la derecha, como la guía de
     Desarrollo Web. En celular, .d-entrada ya apila. */
  .d-entrada-trab .d-guia { grid-column: 2; }
  /* La bajada también es texto corrido (manual §05, ≤ 68): sin tope medía 69 a 1280 y 1440
     y 96 a 1920. Mismo valor que la entrada de Método (28.5em a 24 px); medido con Range. */
  .d-entrada-trab .d-guia { max-width: 28.5em; }

  /* ------------------------------------------------------------ el cierre */
  .d-cierre-trab { display: flex; flex-direction: column; align-items: flex-start; }
