---
// ÍNDICE DE TRABAJO — la página que faltaba.
//
// Medido en la referencia (driftime.com/work): 3.298px, UNA sola sección, diez proyectos
// en grilla. Su H1 va a 120px, peso 800 y mayúsculas («OUR WORK AND PARTNERSHIPS») y los
// nombres de proyecto a 16px peso 400. Esa distancia entre los dos niveles —120 contra
// 16, sin nada en medio— es lo que hace que la página se lea de un golpe: la imagen hace
// el trabajo, la etiqueta solo identifica.
//
// Clasifican por RUBRO, no por servicio: Arts & Heritage, Financial Services, Nonprofit…
// Acá se hace igual, porque un prospecto se reconoce en su rubro, no en el nombre del
// servicio que le vendimos a otro.
//
// LAS CUATRO PIEZAS NO SON LO MISMO, Y EL SITIO LO DICE.
//   · cliente  — trabajo entregado a un cliente real
//   · propio   — producto de la casa
//   · concepto — ejercicio: el cliente no existe
// El rótulo va en la tarjeta, no en una nota al pie. El manual prohíbe prueba social
// inventada, y una grilla de trabajos sin distinguir cuál es cuál la rompe de frente.
import Layout from '../../layouts/Layout.astro';
import NavV3 from '../../components/v3/NavV3.astro';
import FooterV3 from '../../components/v3/FooterV3.astro';
import { caja } from '../../utils/caja';
import obra from '../../data/obra-v3.json';
import '../../styles/campos-v3.css';

const { casos } = obra;

const ROTULO = {
  cliente: 'Cliente',
  propio: 'Producto propio',
  concepto: 'Pieza de concepto',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://spindlelab.cl/trabajo/#pagina',
      name: 'Trabajo',
      description: obra.bajada,
      isPartOf: { '@id': 'https://spindlelab.cl/#sitio' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://spindlelab.cl/' },
        { '@type': 'ListItem', position: 2, name: 'Trabajo' },
      ],
    },
  ],
};
---

<Layout
  title="Trabajo · SpindleLab"
  description={obra.bajada}
  jsonLd={jsonLd}
>
  <NavV3 />

  <main class="text-papel">
    <section class="px-6 md:px-medianil pt-32 sm:pt-40 md:pt-44 pb-20 md:pb-28">
      <nav aria-label="Miga de pan" class="rotulo text-base flex gap-2 mb-10">
        <a href="/v3/" class="hover:opacity-70 transition-opacity">Inicio</a>
        <span aria-hidden="true">·</span>
        <span>Trabajo</span>
      </nav>

      <h1
        class:list={['font-extrabold m-0 max-w-[14ch]', caja(obra.titulo)]}
        style="font-size:clamp(2.25rem, 8.4vw, 8rem); line-height:0.88; letter-spacing:0"
      >
        {obra.titulo}
      </h1>

      <p class="mt-10 text-humo text-xl md:text-2xl leading-relaxed max-w-prosa">
        {obra.bajada}
      </p>
    </section>

    {/* UNA sola sección con la grilla, como la referencia. Dos columnas en escritorio:
        con cuatro piezas, cuatro columnas las dejaría del tamaño de una estampilla y la
        imagen es lo que tiene que hacer el trabajo. */}
    <section class="px-6 md:px-medianil pb-24 md:pb-40">
      <ul class="list-none p-0 m-0 grid gap-x-8 gap-y-16 md:grid-cols-2">
        {
          casos.map((c: any) => (
            <li>
              <article>
                {/* TRES DE LAS CUATRO ENLAZAN AL SITIO VIVO. Un índice de trabajo que no
                    deja entrar a ver el trabajo es un álbum de capturas. La de concepto no
                    lleva enlace porque no hay a dónde ir, y eso también dice lo que es. */}
                {c.url ? (
                  <a href={c.url} target="_blank" rel="noopener" class="grupo-obra block focus-visible:outline focus-visible:outline-2 focus-visible:outline-papel focus-visible:outline-offset-4">
                    <img src={c.img} alt={c.alt} width={c.w} height={c.h} loading="lazy" decoding="async" class="media-campo" />
                  </a>
                ) : (
                  <img src={c.img} alt={c.alt} width={c.w} height={c.h} loading="lazy" decoding="async" class="media-campo" />
                )}

                <div class="mt-4 flex items-baseline gap-3 flex-wrap">
                  <h2 class="m-0 text-base font-bold">{c.n}</h2>
                  <span class="rotulo text-base">{c.rubro}</span>
                  <span class="rotulo text-base">·</span>
                  <span class="rotulo text-base">{ROTULO[c.tipo as keyof typeof ROTULO]}</span>
                  {c.url && (
                    <a href={c.url} target="_blank" rel="noopener" class="rotulo text-base underline underline-offset-4 hover:opacity-70 transition-opacity">
                      Ver el sitio
                    </a>
                  )}
                </div>

                <p class="m-0 mt-2.5 text-humo text-base leading-relaxed max-w-prosa">
                  {c.linea}
                </p>

                {c.tipo === 'concepto' && (
                  <p class="m-0 mt-2.5 text-base leading-relaxed max-w-prosa">
                    <strong>{c.n} no existe.</strong> Es un ejercicio para mostrar cómo
                    trabajamos en este rubro, no un cliente.
                  </p>
                )}
              </article>
            </li>
          ))
        }
      </ul>

      {/* Lo que falta, dicho en la página en vez de escondido. Una grilla de cuatro con
          dos ejercicios se explica sola si se dice por qué; si no se dice, el visitante
          saca su propia conclusión y es peor. */}
      <p class="mt-16 rotulo text-base leading-relaxed max-w-prosa">
        Estamos construyendo una pieza de concepto por rubro. Si el tuyo no está todavía,
        el chequeo funciona igual sobre tu sitio.
      </p>
      <a href="/v3/diagnostico/" class="boton-campo mt-6">Correr el chequeo</a>
    </section>
  </main>

  <FooterV3 />
</Layout>
