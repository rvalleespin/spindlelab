  .d-precio-trab .d-pre-rot:last-child { margin-left: 0; }

  /* ------------------------------------------------------------ tableta */
  /* La final en 8 + 4 deja el pie en ~207 px a 768 (24 caracteres por línea). Hasta 1023:
     imagen a todo el ancho y el pie debajo, partido 5 + 7 como el de la pieza ancha. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .d-obra-trab--final { grid-template-rows: auto auto; row-gap: 20px; }
    .d-obra-trab--final .d-obra-trab__img { grid-column: 1 / -1; }
