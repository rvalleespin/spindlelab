---
// MÉTODO SOBRE A · ARCHIVO (obra E12, corrida 2, tanda 5). Diego, 19-oct-2026.
//
// Contrato: spindlelab-v3/spec-visual.md §2.4 (la plantilla interior; fila «/v3/metodo/»: cabecera; «Del diagnóstico al
// monitoreo» como las fases de Desarrollo web; «Tres reglas que no negociamos» (lista); «Lo que necesitamos de ti»;
// cierre; sin franja). Lo que la spec no cubría está en spindlelab-v3/desvios.md, tanda 5.
//
// El texto: lo que Clara cambia (texto/metodo.json) y lo que queda tal cual desde su dato (paginas-v3.json y lo que la
// página de driftime escribía por su cuenta). Lo arma metodo() en interiores.mjs, que hace caer el build si un texto de
// Clara no reemplaza al que dice, o si un precio no está en los JSON. Señales de Simón, e12/senales-obra.md §2.8.
import Layout from '../../layouts/Layout.astro';
import PaginaA from '../../components/a/PaginaA.astro';
import Miga from '../../components/a/Miga.astro';
import Icono from '../../components/a/Icono.astro';
import { LAYOUT_A } from '../../components/a/layout-a';
import { metodo } from '../../data/archivo/interiores.mjs';

const m = metodo();
---
<Layout title={m.title} description={m.description} ogImage={m.og.src} ogImageAlt={m.og.alt} {...LAYOUT_A}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(m.jsonLd)} />
  <PaginaA>
    {/* 1 · CABECERA (§2.4.1) */}
    <section class="reticula int-cab" aria-labelledby="h-titulo">
      <Miga items={[{ texto: m.miga[0], href: '/v3/' }, { texto: m.miga[1] }]} />
      <h1 class="t-declaracion" id="h-titulo"><span class="tinta">{m.h1.tinta}</span> <span class="gris">{m.h1.gris}</span></h1>
      <p class="cuerpo caja">{m.linea}</p>
      <p class="cuerpo caja">{m.lead}</p>
      <p class="cuerpo caja">{m.puerta.map((p) => (p.href ? <a href={p.href}>{p.texto}</a> : p.texto))}</p>
      <div class="botones">
        {m.botones.map((b) => <a class={`boton boton--${b.clase}`} href={b.href}>{b.texto}</a>)}
      </div>
    </section>

    {/* 2 · DEL DIAGNÓSTICO AL MONITOREO: las cuatro fases en la forma de las de Desarrollo web (c5–c12) */}
    <section class="seccion reticula" id="fases" aria-labelledby="h-fases">
      <div class="int-sec__cab">
        <h2 class="t-declaracion" id="h-fases">{m.fases.h2}</h2>
        <p class="chico"><span class="tinta">{m.nota.tinta}</span> {m.nota.resto}</p>
      </div>
      <ol class="int-sec__cuerpo">
        {m.fases.lista.map((f) => (
          <li class="fase">
            <h3 class="t-fase"><span aria-hidden="true">{f.numero}</span>{f.nombre}</h3>
            <div class="fase__der">
              <p class="cuerpo">{f.cuerpo.map((p) => (p.href ? <a href={p.href}>{p.texto}</a> : p.texto))}</p>
              <dl class="datos-fase">
                {f.datos.map((d) => (
                  <div class="datos-fase__fila"><dt class="rotulo">{d.k}</dt><dd class="chico">{d.v.map((x) => <span class="datos-fase__linea">{x}</span>)}</dd></div>
                ))}
                {f.cuesta && (
                  <div class="datos-fase__fila datos-fase__fila--entera">
                    <dt class="rotulo">Cuánto cuesta</dt>
                    <dd class="chico">{f.cuesta.t}{f.cuesta.href && <> <a href={f.cuesta.href}>{f.cuesta.enlace}<Icono nombre="flecha" /></a></>}</dd>
                  </div>
                )}
              </dl>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* 3 · TRES REGLAS QUE NO NEGOCIAMOS (lista, c5–c12) */}
    <section class="seccion reticula" aria-labelledby="h-reglas">
      <div class="int-sec__cab"><h2 class="t-declaracion" id="h-reglas">{m.reglas.h2}</h2></div>
      <ul class="int-sec__cuerpo int-lista">
        {m.reglas.lista.map((r) => <li><h3 class="int-lista__t tinta">{r.t}</h3><p class="cuerpo">{r.d}</p></li>)}
      </ul>
    </section>

    {/* 4 · LO QUE NECESITAMOS DE TI (lista, c5–c12) */}
    <section class="seccion reticula" aria-labelledby="h-poco">
      <div class="int-sec__cab">
        <h2 class="t-declaracion" id="h-poco">{m.poco.h2}</h2>
        <p class="chico">{m.poco.bajada}</p>
      </div>
      <dl class="int-sec__cuerpo int-lista">
        {m.poco.lista.map((x) => <div class="int-lista__fila"><dt class="int-lista__t tinta">{x.t}</dt><dd class="cuerpo">{x.d}</dd></div>)}
      </dl>
    </section>

    {/* 5 · CIERRE (§2.4.4) */}
    <section class="seccion reticula" aria-labelledby="h-cierre">
      <div class="cierre">
        <h2 class="t-declaracion" id="h-cierre">{m.cierre.h2}</h2>
        <p class="cuerpo">{m.cierre.p}</p>
        <div class="botones">
          {m.cierre.botones.map((b, i) => <a class={`boton boton--${b.clase}`} href={b.href}>{b.texto}{i === 0 && <Icono nombre="flecha" />}</a>)}
        </div>
      </div>
    </section>
  </PaginaA>
</Layout>
