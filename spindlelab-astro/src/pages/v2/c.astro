---
// MAQUETA C — «Galería» · versión 2, con lo que pidió Ramón el 27-sep:
//   1. Cambio de tipografía  → Manrope toma titulares y cuerpo; Gabarito queda SOLO
//      en el wordmark, que así deja de ser «el titular grande» y pasa a leerse como firma.
//   2. Botones como menú     → la navegación son píldoras, no una barra de enlaces.
//   3. Cuatro recuadros      → grilla de 4 paneles enmarcados, mezclando obra y servicios.
//
// Se adaptan PATRONES de la referencia (píldoras, grilla de cuatro, jerarquía), no se
// copia el sitio: ni su copy, ni sus imágenes, ni su tipografía propietaria. La página
// de driftime.com se renderiza por JS, así que su CSS no se pudo leer; lo que hay acá es
// una construcción propia en la marca de SpindleLab.
//
// Lienzo: negro CÁLIDO #14110E (extensión propuesta, pendiente de aprobación). Sobre un
// negro frío el dorado tira a mostaza; sobre este lee como dorado.
// Dorado: UNA sola vez en la vista, en el punto del wordmark (manual §02 y §06).
import Layout from '../../layouts/Layout.astro';
import { CONTACTO } from '../../consts';

const menu = [
  { href: '#obra', label: 'Obra' },
  { href: '#servicios', label: 'Servicios' },
  { href: '/metodo/', label: 'Método' },
];

// Los cuatro recuadros. Mezcla obra y servicio, como se pidió.
// Nada inventado: el segundo proyecto existe pero todavía no se lanza y el cliente no
// dio permiso de caso público, así que va sin nombre y declarado «en desarrollo».
const paneles = [
  {
    tipo: 'obra',
    etiqueta: 'Obra · fotografía',
    titulo: 'Bernardo Combeau',
    linea: 'Sitio completo y panel de administración.',
    imagen: '/mockup-interno/proyecto-bernardo.png',
  },
  {
    // Marco vacío a propósito: la obra existe pero todavía no se cuelga. En una galería
    // eso se entiende solo, y es honesto. Un rectángulo gris con el título encima se leía
    // como imagen rota, que es lo contrario de lo que queremos transmitir.
    tipo: 'obra-pendiente',
    etiqueta: 'Obra · en desarrollo',
    titulo: 'Galería de arte',
    linea: 'Catálogo bilingüe y venta por obra. Se cuelga en noviembre.',
  },
  {
    tipo: 'servicio',
    etiqueta: 'Servicio',
    titulo: 'Diseño y desarrollo web',
    linea: 'El sitio completo, con la estructura técnica resuelta desde el primer día.',
    href: '/servicios/desarrollo-web/',
  },
  {
    tipo: 'servicio',
    etiqueta: 'Servicio',
    titulo: 'Visibilidad en IA',
    linea: 'Para que ChatGPT, Gemini y Perplexity puedan citarte cuando preguntan por tu rubro.',
    href: '/servicios/visibilidad-en-ia/',
  },
];
---

<Layout
  title="Maqueta C · Galería · exploración rebranding"
  description="Maqueta interna para decidir. No es una página publicada."
  bodyClass="bg-tinta-galeria font-texto"
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <!-- 2 · EL MENÚ SON BOTONES. No hay barra: las píldoras son la única cromía. -->
  <header class="fixed top-0 inset-x-0 z-50 px-4 sm:px-6 lg:px-8 py-4">
    <div class="flex items-center justify-between gap-3">
      <a
        href="/"
        class="font-wordmark text-xl sm:text-2xl text-papel tracking-tight rounded-full bg-tinta-galeria/85 backdrop-blur border border-white/15 px-5 py-2"
      >
        SpindleLab<span class="text-gold">.</span>
      </a>

      <nav aria-label="Principal" class="flex items-center gap-2">
        {
          menu.map((m) => (
            <a
              href={m.href}
              class="hidden sm:inline-flex items-center rounded-full bg-tinta-galeria/85 backdrop-blur border border-white/15 px-5 py-2.5 text-sm font-semibold text-papel hover:bg-papel hover:text-tinta-galeria hover:border-papel transition-colors"
            >
              {m.label}
            </a>
          ))
        }
        <a
          href={CONTACTO}
          class="inline-flex items-center rounded-full bg-papel border border-papel px-5 py-2.5 text-sm font-semibold text-tinta-galeria hover:bg-white transition-colors"
        >
          Contacto
        </a>
      </nav>
    </div>

    <!-- En móvil las píldoras no caben en la misma fila. Antes se ocultaban, y como acá
         los botones SON el menú, eso dejaba el sitio sin navegación: no se llegaba a Obra,
         Servicios ni Método. Ahora bajan a una segunda fila que se arrastra de lado. -->
    <nav aria-label="Secciones" class="sm:hidden mt-3 -mx-4 px-4 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {
        menu.map((m) => (
          <a
            href={m.href}
            class="flex-none inline-flex items-center rounded-full bg-tinta-galeria/85 backdrop-blur border border-white/15 px-4 py-2 text-sm font-semibold text-papel"
          >
            {m.label}
          </a>
        ))
      }
    </nav>
  </header>

  <main class="text-papel">
    <!-- 1 · TIPOGRAFÍA NUEVA. El titular ya no es Gabarito: es Manrope 800, muy apretada. -->
    <!-- pt-40 en móvil porque ahí el menú ocupa dos filas (ver header). -->
    <section class="px-5 sm:px-8 lg:px-10 pt-40 sm:pt-36 md:pt-44 pb-20 md:pb-28">
      <p class="text-white/40 text-xs font-bold uppercase" style="letter-spacing:0.16em">
        Estudio de diseño y SEO técnico · Santiago
      </p>
      <h1
        class="mt-7 font-texto font-extrabold text-fluid-2xl max-w-[11ch]"
        style="letter-spacing:-0.045em; text-wrap:balance"
      >
        Sitios que se miran dos veces.
      </h1>
      <p class="mt-9 text-white/55 text-lg md:text-xl leading-relaxed max-w-prosa">
        Los diseñamos, los construimos, y dejamos resuelto lo que decide si aparecen en
        Google y si la IA puede citarlos.
      </p>
    </section>

    <!-- La pieza mayor: paspartú de papel, márgenes anchos, nada encima. -->
    <figure id="obra" class="m-0 px-5 sm:px-10 lg:px-20 pb-6 scroll-mt-28">
      <div class="bg-papel p-3 sm:p-5 md:p-7">
        <div class="relative w-full aspect-[16/10] overflow-hidden bg-tinta">
          <img
            src="/mockup-interno/proyecto-bernardo.png"
            alt="Sitio de Bernardo Combeau, fotógrafo de retrato en Santiago, diseñado y construido por SpindleLab"
            width="1440"
            height="1000"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover object-top"
          />
        </div>
      </div>
      <figcaption class="pt-5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
        <span class="text-lg md:text-xl font-bold text-papel">Bernardo Combeau</span>
        <span class="text-white/40 text-xs font-bold uppercase" style="letter-spacing:0.16em">
          Fotografía de retrato · sitio y panel · Santiago
        </span>
      </figcaption>
    </figure>

    <!-- 3 · LOS CUATRO RECUADROS. Mismo marco para todos, para que se lean como cuatro
         objetos de la misma colección: dos de obra y dos de servicio. -->
    <section id="servicios" class="px-5 sm:px-10 lg:px-20 pt-20 md:pt-28 pb-28 md:pb-40 scroll-mt-28">
      <h2
        class="font-texto font-extrabold text-fluid-xl max-w-[16ch] mb-10 md:mb-14"
        style="letter-spacing:-0.04em; text-wrap:balance"
      >
        Lo que hacemos y para quién.
      </h2>

      <div class="grid gap-4 sm:gap-5 md:grid-cols-2 items-stretch">
        {
          paneles.map((p) =>
            p.tipo === 'obra' ? (
              // Obra colgada: marco de papel con la pieza dentro.
              <article class="bg-papel text-tinta-galeria p-3 sm:p-4 flex flex-col">
                <div class="relative w-full aspect-[16/10] overflow-hidden bg-tinta">
                  <img
                    src={p.imagen}
                    alt={`Sitio de ${p.titulo}, diseñado y construido por SpindleLab`}
                    width="1440"
                    height="1000"
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 w-full h-full object-cover object-top"
                  />
                </div>
                <div class="pt-5 pb-1 px-1 flex-1 flex flex-col">
                  <span class="text-tinta-galeria/45 text-xs font-bold uppercase" style="letter-spacing:0.16em">
                    {p.etiqueta}
                  </span>
                  <span class="mt-3 text-lg font-bold">{p.titulo}</span>
                  <span class="mt-2 text-tinta-galeria/65 text-sm leading-relaxed">{p.linea}</span>
                </div>
              </article>
            ) : p.tipo === 'obra-pendiente' ? (
              // Marco vacío: la obra existe, todavía no se cuelga. Sin papel y sin
              // relleno gris, para que se lea como decisión y no como imagen que falló.
              <article class="border border-white/20 p-3 sm:p-4 flex flex-col text-papel">
                <div class="relative w-full aspect-[16/10] border border-white/10 flex items-center justify-center">
                  <span class="text-white/30 text-xs font-bold uppercase" style="letter-spacing:0.16em">
                    Aún no se cuelga
                  </span>
                </div>
                <div class="pt-5 pb-1 px-1 flex-1 flex flex-col">
                  <span class="text-white/40 text-xs font-bold uppercase" style="letter-spacing:0.16em">
                    {p.etiqueta}
                  </span>
                  <span class="mt-3 text-lg font-bold">{p.titulo}</span>
                  <span class="mt-2 text-white/55 text-sm leading-relaxed">{p.linea}</span>
                </div>
              </article>
            ) : (
              // Servicio: panel de papel, puramente tipográfico. Sin caja de imagen
              // vacía: el tipo ocupa el panel y no queda ningún hueco que explicar.
              <article class="bg-papel text-tinta-galeria p-6 sm:p-8 flex flex-col">
                <span class="text-tinta-galeria/45 text-xs font-bold uppercase" style="letter-spacing:0.16em">
                  {p.etiqueta}
                </span>
                <span
                  class="mt-5 font-texto font-extrabold text-3xl sm:text-4xl leading-[1.05] max-w-[13ch]"
                  style="letter-spacing:-0.04em; text-wrap:balance"
                >
                  {p.titulo}
                </span>
                <span class="mt-4 text-tinta-galeria/65 text-base leading-relaxed max-w-prosa">
                  {p.linea}
                </span>
                {p.href && (
                  <a
                    href={p.href}
                    class="mt-auto pt-8 inline-flex items-center gap-2 text-sm font-bold text-tinta-galeria hover:gap-3 transition-all"
                  >
                    Ver más <span aria-hidden="true">→</span>
                  </a>
                )}
              </article>
            )
          )
        }
      </div>

      <div class="mt-14 md:mt-20 flex items-center gap-6 flex-wrap">
        <a
          href={CONTACTO}
          class="rounded-full bg-papel hover:bg-white text-tinta-galeria text-sm font-bold px-7 py-3.5 transition-colors"
        >
          Conversemos tu proyecto
        </a>
        <a
          href="/diagnostico/"
          class="rounded-full border border-white/20 hover:border-papel text-papel text-sm font-bold px-7 py-3.5 transition-colors"
        >
          Ya tengo sitio, quiero ver qué lo frena
        </a>
      </div>
    </section>
  </main>
</Layout>
