   204	    }],
   205	    config: {
   206	      online: {
   207	        success_url: urls.exito,
   208	        pending_url: urls.pendiente,
   209	        failure_url: urls.rechazo,
   210	        // Sin `auto_return`, la persona paga y se queda en Mercado Pago en vez de aterrizar en
   211	        // su pantalla del pedido. `approved` la devuelve solo cuando el pago se aprobó; exige
   212	        // `success_url`, que ya va arriba.
   213	        auto_return: 'approved',
   214	      },
   215	    },
   216	    // Sin vencimiento, un pedido que nadie paga se queda en `creado` para siempre. Con un día,
   217	    // Mercado Pago lo pasa a `expired`, que el webhook ya sabe tratar como rechazo. Es duración
   218	    // ISO 8601, no una fecha.
   219	    expiration_time: 'P1D',
   220	  };
   221	}
   222	
   223	/* ================================================================== *
   224	 * El esquema. Va acá para que viva al lado del código que lo usa.    *
   225	 * ================================================================== */
   226	
   227	export const ESQUEMA = `
   228	CREATE TABLE IF NOT EXISTS pedidos (
   229	  id                  TEXT PRIMARY KEY,
   230	  creado_en           TEXT NOT NULL,
   231	  estado              TEXT NOT NULL,
   232	
   233	  -- Qué se compró, CONGELADO. Nada de esto se recalcula después.
   234	  dominio             TEXT NOT NULL,
   235	  url_medida          TEXT,
   236	  senales_contratadas TEXT NOT NULL,
   237	  senales_fuera       TEXT,
   238	  informe_json        TEXT NOT NULL,
   239	  monto_neto          INTEGER NOT NULL,
   240	  monto_total         INTEGER NOT NULL,
   241	
   242	  -- Lo único que se pide antes de pagar.
   243	  correo              TEXT NOT NULL,
   244	
   245	  -- Mercado Pago
   246	  mp_order_id         TEXT,
   247	  mp_payment_id       TEXT,
   248	  pagado_en           TEXT,
   249	
   250	  -- De dónde vino, entero
   251	  utm_source          TEXT,
   252	  utm_medium          TEXT,
   253	  utm_campaign        TEXT,
   254	  utm_content         TEXT,
   255	  utm_term            TEXT,
   256	
   257	  -- Lo que se pide DESPUÉS del pago, para la factura y para trabajar
   258	  razon_social        TEXT,
   259	  rut                 TEXT,
   260	  giro                TEXT,
   261	  direccion           TEXT,
   262	  plataforma          TEXT,
   263	  acceso_recibido_en  TEXT,
   264	
   265	  entregado_en        TEXT,
   266	  informe_final_json  TEXT
   267	);
   268	
   269	-- Para que el webhook encuentre el pedido por el id de Mercado Pago sin recorrer la tabla.
   270	CREATE INDEX IF NOT EXISTS idx_pedidos_mp_order ON pedidos (mp_order_id);
   271	CREATE INDEX IF NOT EXISTS idx_pedidos_mp_payment ON pedidos (mp_payment_id);
   272	CREATE INDEX IF NOT EXISTS idx_pedidos_estado ON pedidos (estado, creado_en);
   273	
   274	-- Cada notificación que llega, una vez. Es la protección contra repetición: Mercado Pago
   275	-- reintenta cada 15 minutos hasta recibir un 200, así que el mismo evento llega varias veces.
   276	-- Con la clave primaria acá, procesarlo dos veces es imposible por construcción y no por
   277	-- cuidado de quien escriba el handler.
   278	CREATE TABLE IF NOT EXISTS eventos_mp (
   279	  id          TEXT PRIMARY KEY,
   280	  recibido_en TEXT NOT NULL,
   281	  tipo        TEXT,
   282	  pedido_id   TEXT,
   283	  resultado   TEXT
   284	);
   285	`;
     1	/**
     2	 * Guardar y leer pedidos. Es la única parte del cobro que habla con la base.
     3	 *
     4	 * Todo lo que recibe `db` espera la interfaz de D1:
     5	 *   db.prepare(sql).bind(...).run()    → { meta: { changes } }
     6	 *   db.prepare(sql).bind(...).first()  → la primera fila, o null
     7	 *
     8	 * Se escribió contra esa interfaz y se prueba contra SQLite de verdad (el `node:sqlite` que
     9	 * trae Node 24, con un adaptador de cuatro líneas). No es un simulacro: es el mismo motor que
    10	 * corre debajo de D1, con el mismo esquema, así que lo que pasa en la prueba pasa en producción.
    11	 *
    12	 * ──────────────────────────────────────────────────────────────────────────────────────────
    13	 * LAS DOS COSAS QUE ESTE ARCHIVO TIENE QUE GARANTIZAR
    14	 *
    15	 * 1. QUE UN EVENTO SE PROCESE UNA SOLA VEZ. Mercado Pago reintenta ocho veces y el panel tiene
    16	 *    botón de reenviar, así que la misma notificación va a llegar varias veces, a veces a la
    17	 *    vez. La defensa no es un `if` en el handler —entre leer y escribir cabe otro proceso—
    18	 *    sino la clave primaria de `eventos_mp` y un `INSERT OR IGNORE`: la base decide quién
    19	 *    llegó primero, y el segundo se entera porque no cambió ninguna fila.
    20	 *
    21	 * 2. QUE EL ESTADO NO SE PISE. `marcarEstado` lleva el estado que espera encontrar en el
    22	 *    `WHERE`. Si otro proceso ya lo movió, el UPDATE no toca nada y devuelve `movido: false`
    23	 *    en vez de sobrescribir. Comprobar antes con un SELECT y después escribir deja una ventana
    24	 *    por la que se cuela el reintento; esto no la deja.
    25	 */
    26	
    27	import { ESTADOS, transicionValida } from './pedidos.js';
    28	
    29	/** Las columnas que se escriben al crear. En un solo lugar, para que el INSERT no se desfase. */
    30	const COLUMNAS_CREAR = [
    31	  'id', 'creado_en', 'estado', 'dominio', 'url_medida',
    32	  'senales_contratadas', 'senales_fuera', 'informe_json', 'monto_neto', 'monto_total',
    33	  'correo', 'mp_order_id',
    34	  'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term',
    35	];
    36	
    37	/**
    38	 * Crea el pedido. El estado inicial siempre es `creado`: no se acepta desde afuera, porque
    39	 * nacer pagado no es algo que el cliente pueda pedir.
    40	 */
    41	export async function crearPedido(db, datos) {
    42	  const fila = {
    43	    id: datos.id,
    44	    creado_en: datos.creado_en || new Date().toISOString(),
    45	    estado: ESTADOS.CREADO,
    46	    dominio: datos.dominio,
    47	    url_medida: datos.url_medida ?? null,
    48	    senales_contratadas: JSON.stringify(datos.senales_contratadas || []),
    49	    senales_fuera: JSON.stringify(datos.senales_fuera || []),
    50	    informe_json: datos.informe_json,
    51	    monto_neto: datos.monto_neto,
    52	    monto_total: datos.monto_total,
    53	    correo: datos.correo,
    54	    mp_order_id: datos.mp_order_id ?? null,
    55	    utm_source: datos.utm_source ?? null,
    56	    utm_medium: datos.utm_medium ?? null,
    57	    utm_campaign: datos.utm_campaign ?? null,
    58	    utm_content: datos.utm_content ?? null,
    59	    utm_term: datos.utm_term ?? null,
    60	  };
    61	  const huecos = COLUMNAS_CREAR.map(() => '?').join(', ');
    62	  await db.prepare(
    63	    `INSERT INTO pedidos (${COLUMNAS_CREAR.join(', ')}) VALUES (${huecos})`,
    64	  ).bind(...COLUMNAS_CREAR.map((c) => fila[c])).run();
    65	  return fila;
    66	}
    67	
    68	/** Devuelve el pedido con las listas ya deserializadas, o null. */
    69	export async function leerPedido(db, id) {
    70	  if (!id) return null;
    71	  const f = await db.prepare('SELECT * FROM pedidos WHERE id = ?').bind(id).first();
    72	  return f ? hidratar(f) : null;
    73	}
    74	
    75	/** Busca el pedido por el id de pago de Mercado Pago. Lo usa el webhook. */
    76	export async function buscarPorPago(db, mpPaymentId) {
    77	  if (!mpPaymentId) return null;
    78	  const f = await db.prepare('SELECT * FROM pedidos WHERE mp_payment_id = ?')
    79	    .bind(String(mpPaymentId)).first();
    80	  return f ? hidratar(f) : null;
    81	}
    82	
    83	/** Las dos columnas que viajan como JSON vuelven como lista. El resto se deja tal cual. */
    84	function hidratar(f) {
    85	  const leer = (t) => { try { return JSON.parse(t || '[]'); } catch { return []; } };
    86	  return {
    87	    ...f,
    88	    senales_contratadas: leer(f.senales_contratadas),
    89	    senales_fuera: leer(f.senales_fuera),
    90	  };
    91	}
    92	
    93	/**
    94	 * Mueve el estado del pedido, comprobando la transición y sin pisar a nadie.
    95	 *
    96	 * El `WHERE ... AND estado = ?` es lo que hace esto seguro: si entre que leímos y escribimos
    97	 * otro proceso ya movió el pedido, el UPDATE no encuentra la fila y no cambia nada. Devuelve
    98	 * `{ movido: false, motivo: 'ya-se-movio' }` en vez de sobrescribir.
    99	 *
   100	 * `extra` solo acepta las columnas de la lista blanca. No se arma SQL con nombres que vengan
   101	 * de afuera.
   102	 */
   103	const EXTRA_PERMITIDO = new Set([
   104	  'mp_payment_id', 'mp_order_id', 'pagado_en', 'entregado_en', 'informe_final_json',
   105	]);
   106	
   107	/**
   108	 * El pedido en `creado` más nuevo de una pareja (dominio, correo), dentro de una ventana.
   109	 *
   110	 * ── POR QUÉ HACE FALTA ───────────────────────────────────────────────────────────────────
   111	 *
   112	 * Es la defensa contra el doble clic, y hace falta porque la clave de idempotencia de Mercado
   113	 * Pago **no alcanza sola**. Esa clave protege contra que repitamos la MISMA petición; un doble
   114	 * clic manda DOS, y si cada una generara su propio id de pedido, cada una traería su propia
   115	 * clave y Mercado Pago crearía dos órdenes. Dos cobros posibles por el mismo kit.
   116	 *
   117	 * Deshabilitar el botón en el navegador no sirve como defensa: el navegador puede mentir, o
   118	 * simplemente la segunda petición ya salió. La defensa tiene que estar de este lado.
   119	 *
   120	 * Con esto, la segunda petición encuentra el pedido de la primera y **reusa su id** como clave,
   121	 * y ahí sí la idempotencia hace su trabajo: Mercado Pago devuelve la orden que ya existía.
   122	 *
   123	 * `desdeIso` acota la ventana. No se busca «cualquier pedido en creado de esta persona» porque
   124	 * entonces alguien que lo intentó la semana pasada y abandonó nunca podría volver a comprar:
   125	 * quedaría reusando para siempre una orden vencida.
   126	 *
   127	 * El filtro va sobre `estado` y `creado_en`, que es justo el índice que ya existe
   128	 * (`idx_pedidos_estado`). El `dominio` y el `correo` se comparan sobre el resultado.
   129	 */
   130	export async function buscarPedidoReciente(db, { dominio, correo, desdeIso } = {}) {
   131	  if (!dominio || !correo || !desdeIso) return null;
   132	  const f = await db.prepare(
   133	    `SELECT * FROM pedidos
   134	      WHERE estado = ? AND creado_en >= ? AND dominio = ? AND correo = ?
   135	      ORDER BY creado_en DESC LIMIT 1`,
   136	  ).bind(ESTADOS.CREADO, desdeIso, String(dominio), String(correo)).first();
   137	  return f ? hidratar(f) : null;
   138	}
   139	
   140	export async function marcarEstado(db, id, desde, hasta, extra = {}) {
   141	  if (!transicionValida(desde, hasta)) {
   142	    return { movido: false, motivo: 'transicion-invalida' };
   143	  }
   144	  const cols = Object.keys(extra).filter((c) => EXTRA_PERMITIDO.has(c));
   145	  const sets = ['estado = ?', ...cols.map((c) => `${c} = ?`)];
   146	  const vals = [hasta, ...cols.map((c) => extra[c]), id, desde];
   147	
   148	  const r = await db.prepare(
   149	    `UPDATE pedidos SET ${sets.join(', ')} WHERE id = ? AND estado = ?`,
   150	  ).bind(...vals).run();
   151	
   152	  const cambios = (r && r.meta && r.meta.changes) || 0;
   153	  return cambios > 0
   154	    ? { movido: true, motivo: 'ok' }
   155	    : { movido: false, motivo: 'ya-se-movio' };
   156	}
   157	
   158	/**
   159	 * Cuánto puede quedar un reclamo sin terminar antes de que otro intento se lo pueda llevar.
   160	 *
   161	 * El calendario de reintentos de Mercado Pago es 0, 15 min, 30 min, 6 h, 48 h, 96 h, 96 h,
   162	 * 96 h. Con diez minutos, el reintento de los 15 ya puede rescatar un reclamo abandonado, que
   163	 * es el primero que llega y el que más importa.
   164	 *
   165	 * El riesgo de una ventana corta sería que dos intentos procesaran a la vez, y está cubierto
   166	 * aparte: `marcarEstado` lleva el estado esperado en el WHERE, así que el segundo encuentra el
   167	 * pedido ya movido y reporta `ya-se-movio` sin tocar nada. Y nuestro propio handler tarda
   168	 * segundos, no minutos: el tope que Mercado Pago anuncia en `x-socket-timeout` son 22.000 ms.
   169	 */
   170	export const VENTANA_RECLAMO_MS = 10 * 60 * 1000;
   171	
   172	/**
   173	 * Registra que llegó un evento, y dice si es la PRIMERA vez.
   174	 *
   175	 * Acá está la idempotencia de verdad. `INSERT OR IGNORE` sobre una clave primaria es atómico:
   176	 * si dos reintentos llegan al mismo tiempo, uno inserta y el otro no cambia nada. El que no
   177	 * cambió nada recibe `primeraVez: false` y no hace el trabajo de nuevo.
   178	 *
   179	 * Lo que NO se hace: leer primero y escribir después. Entre las dos operaciones cabe el otro
   180	 * reintento, y los dos se creerían el primero.
   181	 *
   182	 * ── EL RECLAMO ABANDONADO (24-oct-2026) ──────────────────────────────────────────────────
   183	 *
   184	 * Reclamar y no terminar deja el evento muerto. El handler suelta el reclamo cuando el
   185	 * trabajo falla de forma recuperable, pero soltarlo es un DELETE contra la misma base cuyo
   186	 * fallo disparó la liberación: en el caso típico —D1 con un hipo— el DELETE falla también, y
   187	 * entonces el reintento ve el evento registrado, contesta «repetido» y se va. El cliente pagó
   188	 * y el pedido se queda en `creado` para siempre, sin rastro en ninguna parte.
   189	 *
   190	 * Por eso el reclamo ahora VENCE, y no se confía en que la liberación haya salido bien.
   191	 *
   192	 * El invariante que lo hace posible ya existía: **toda salida terminada del handler pasa por
   193	 * `anotarResultado`**, así que una fila con `resultado IS NULL` es, por construcción, un
   194	 * reclamo que nadie terminó. Si además está vieja, se puede volver a reclamar.
   195	 *
   196	 * El re-reclamo es un UPDATE con la condición adentro (`WHERE id = ? AND resultado IS NULL AND
   197	 * recibido_en < ?`) y se mira `changes`, así que sigue siendo atómico: de dos reintentos
   198	 * simultáneos, uno se lleva la fila y el otro ve `changes = 0`.
   199	 *
   200	 * ⚠️ La comparación de fechas se hace **entre cadenas ISO de JavaScript**, no con las funciones
   201	 * de fecha de SQLite. No es un capricho: `recibido_en` se guarda con `toISOString()`
   202	 * (`2026-10-24T01:40:17.697Z`) y `datetime('now','-10 minutes')` devuelve
   203	 * `2026-10-24 01:40:17`, con un espacio donde el otro tiene una `T`. Como `'T'` (0x54) es mayor
   204	 * que `' '` (0x20), **toda fila del mismo día compararía mayor** y el vencimiento no se
   205	 * activaría nunca. Con las dos puntas en el mismo formato de ancho fijo, el orden
   206	 * lexicográfico de ISO-8601 en UTC es el orden cronológico y la comparación es exacta.
   207	 */
   208	export async function registrarEvento(
   209	  db, clave, { tipo = null, pedidoId = null, resultado = null, ahoraMs = null } = {},
   210	) {
   211	  if (!clave) return { primeraVez: false, motivo: 'sin-clave' };
   212	  const ahora = ahoraMs === null ? Date.now() : ahoraMs;
   213	  const r = await db.prepare(
   214	    'INSERT OR IGNORE INTO eventos_mp (id, recibido_en, tipo, pedido_id, resultado) VALUES (?, ?, ?, ?, ?)',
   215	  ).bind(clave, new Date(ahora).toISOString(), tipo, pedidoId, resultado).run();
   216	  if (((r && r.meta && r.meta.changes) || 0) > 0) {
   217	    return { primeraVez: true, motivo: 'nuevo' };
   218	  }
   219	
   220	  // No entró: la fila ya estaba. ¿Es un reclamo que alguien abandonó?
   221	  const corte = new Date(ahora - VENTANA_RECLAMO_MS).toISOString();
   222	  const re = await db.prepare(
   223	    'UPDATE eventos_mp SET recibido_en = ? WHERE id = ? AND resultado IS NULL AND recibido_en < ?',
   224	  ).bind(new Date(ahora).toISOString(), clave, corte).run();
   225	  if (((re && re.meta && re.meta.changes) || 0) > 0) {
   226	    return { primeraVez: true, motivo: 'reclamo-vencido' };
   227	  }
   228	
   229	  return { primeraVez: false, motivo: 'repetido' };
   230	}
   231	
   232	/**
   233	 * Suelta un evento que se había reclamado pero no se pudo procesar.
   234	 *
   235	 * POR QUÉ HACE FALTA. `registrarEvento` es un reclamo: el primero que llega se queda con el
   236	 * evento y los reintentos se van. Eso está bien mientras el trabajo salga. Pero si entre el
   237	 * reclamo y el trabajo algo falla de forma recuperable —la API de Mercado Pago no contesta,
   238	 * por ejemplo— el evento queda reclamado y NUNCA procesado: el reintento llega, ve que ya
   239	 * está registrado, y se va sin hacer nada.
   240	 *
   241	 * Es la forma más silenciosa de perder un pago. Por eso, cuando el fallo es de los que un
   242	 * reintento podría arreglar, se suelta la fila y se contesta un error para que Mercado Pago
   243	 * vuelva a intentar.
   244	 */
   245	export async function liberarEvento(db, clave) {
   246	  if (!clave) return { soltado: false, motivo: 'sin-clave' };
   247	  try {
   248	    await db.prepare('DELETE FROM eventos_mp WHERE id = ?').bind(clave).run();
   249	    return { soltado: true, motivo: 'ok' };
   250	  } catch (e) {
   251	    // El error se traga —no hay nada mejor que hacer con él acá— pero NO se oculta al que
   252	    // llama. Antes esta función no devolvía nada, así que el handler contestaba 503 creyendo
   253	    // que había soltado el reclamo cuando no. Y el caso en que el DELETE falla es justamente
   254	    // el típico: se llama porque la base falló, así que la base ya está caída.
   255	    //
   256	    // Que el reclamo se recupere igual lo resuelve el vencimiento de `registrarEvento`; esto
   257	    // es para que la respuesta no mienta y el motivo se pueda leer en el registro de entregas
   258	    // de Mercado Pago y en `wrangler pages deployment tail`, que es toda la observabilidad que
   259	    // hay.
   260	    return { soltado: false, motivo: `no-se-pudo-soltar:${(e && e.message) || 'error'}` };
   261	  }
   262	}
   263	
   264	/** Deja escrito cómo terminó un evento, para poder depurar después. */
   265	export async function anotarResultado(db, clave, resultado) {
   266	  if (!clave) return { anotado: false, motivo: 'sin-clave' };
   267	  // Es una nota de auditoría: no puede tumbar la respuesta del handler ni cambiar lo que se le
   268	  // contesta a Mercado Pago. Antes iba a pelo, y sus cuatro llamadas en el handler están fuera
   269	  // de todo try, así que un hipo de D1 en el camino feliz —con el pedido YA marcado como
   270	  // pagado— se convertía en un 500 y Mercado Pago lo reintentaba ocho veces sobre un trabajo
   271	  // que ya estaba hecho.
   272	  try {
   273	    await db.prepare('UPDATE eventos_mp SET resultado = ? WHERE id = ?')
   274	      .bind(String(resultado).slice(0, 200), clave).run();
   275	    return { anotado: true, motivo: 'ok' };
   276	  } catch (e) {
   277	    return { anotado: false, motivo: `no-se-pudo-anotar:${(e && e.message) || 'error'}` };
   278	  }
   279	}
   280	
   281	/**
   282	 * Los datos que se piden DESPUÉS del pago: facturación, plataforma y el aviso de que llegó el
   283	 * acceso.
   284	 *
   285	 * Solo se aceptan sobre un pedido ya pagado. Antes del pago no hay por qué tenerlos, y
   286	 * aceptarlos sería guardar datos de alguien que todavía no compró.
   287	 */
   288	const INTAKE_PERMITIDO = new Set([
   289	  'razon_social', 'rut', 'giro', 'direccion', 'plataforma', 'acceso_recibido_en',
   290	]);
   291	
   292	export async function guardarIntake(db, id, datos) {
   293	  const cols = Object.keys(datos || {}).filter((c) => INTAKE_PERMITIDO.has(c));
   294	  if (!cols.length) return { guardado: false, motivo: 'sin-campos' };
   295	
   296	  const sets = cols.map((c) => `${c} = ?`).join(', ');
   297	  const vals = [...cols.map((c) => datos[c]), id];
   298	
   299	  // El `IN` del WHERE es la regla: solo sobre un pedido que ya pagó.
   300	  const r = await db.prepare(
   301	    `UPDATE pedidos SET ${sets} WHERE id = ? AND estado IN ('${ESTADOS.PAGADO}', '${ESTADOS.ENTREGADO}')`,
   302	  ).bind(...vals).run();
   303	
   304	  const cambios = (r && r.meta && r.meta.changes) || 0;
   305	  return cambios > 0
   306	    ? { guardado: true, motivo: 'ok', campos: cols }
   307	    : { guardado: false, motivo: 'no-pagado-o-no-existe' };
   308	}
   309	
   310	/**
   311	 * Lo que se le puede mostrar a quien abre su pedido.
   312	 *
   313	 * Deja fuera el informe completo y los datos de facturación: para la pantalla de estado no
   314	 * hacen falta, y lo que no se manda no se puede filtrar.
   315	 */
   316	export function vistaPublica(pedido) {
   317	  if (!pedido) return null;
   318	  return {
   319	    id: pedido.id,
   320	    estado: pedido.estado,
   321	    creado_en: pedido.creado_en,
   322	    dominio: pedido.dominio,
   323	    url_medida: pedido.url_medida,
   324	    senales_contratadas: pedido.senales_contratadas,
   325	    senales_fuera: pedido.senales_fuera,
   326	    monto_total: pedido.monto_total,
   327	    pagado_en: pedido.pagado_en,
   328	    entregado_en: pedido.entregado_en,
   329	    falta_acceso: pedido.estado === ESTADOS.PAGADO && !pedido.acceso_recibido_en,
   330	  };
