   527	/**
   528	 * Qué contestarle a Mercado Pago.
   529	 *
   530	 * La doc es clara: espera 200 o 201 dentro de 22 segundos, y si no lo recibe reintenta ocho
   531	 * veces. Eso obliga a una distinción que es fácil de errar:
   532	 *
   533	 *   - Si la notificación se entendió, SE CONTESTA 200, aunque el resultado haya sido «ignorar»
   534	 *     o «revisar». Reintentar no va a cambiar nada y lo único que se logra son ocho copias del
   535	 *     mismo problema.
   536	 *   - Solo se devuelve un error cuando reintentar PODRÍA funcionar: no se pudo leer el pago
   537	 *     contra la API, o la base de datos no respondió. Ahí el reintento es justamente lo que
   538	 *     queremos.
   539	 *   - Y 401 cuando la firma no valida, que es lo que la doc pide.
   540	 */
   541	export function respuestaParaMP({ firmaValida, accion, motivo }) {
   542	  if (!firmaValida) return { estado: 401, cuerpo: { ok: false, motivo: 'firma' } };
   543	  if (motivo === 'sin-pago') return { estado: 503, cuerpo: { ok: false, motivo } };
   544	  return { estado: 200, cuerpo: { ok: true, accion, motivo } };
   545	}

