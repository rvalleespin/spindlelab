   134	export function normalizarDominio(entrada) {
   135	  if (typeof entrada !== 'string') return { error: 'Escribe un dominio.' };
   136	  let s = entrada.trim().toLowerCase();
   137	  if (!s) return { error: 'Escribe un dominio.' };
   138	  if (s.length > 253) return { error: 'Ese dominio es demasiado largo.' };
   139	
   140	  // El www YA NO se borra. Antes se quitaba siempre, y los sitios que solo viven en www (el
   141	  // dominio pelado no tiene DNS, no conecta o se redirige a sí mismo sin fin) recibían "no
   142	  // existe" o "bucle" aunque la persona hubiera escrito la dirección correcta. Ahora se
   143	  // revisa lo que se escribió, y si esa variante no abre, `abrirPortada` prueba la otra.
   144	  s = s.replace(/^[a-z][a-z0-9+.-]*:\/\//, '').replace(/\/.*$/, '');
   145	  if (s.includes('@')) return { error: 'Escribe un dominio, no un correo.' };
   146	
   147	  const [host, puerto] = s.split(':');
   148	  if (puerto && puerto !== '80' && puerto !== '443') {
   149	    return { error: 'Escribe solo el dominio, sin el número que va después de los dos puntos.' };
   150	  }
   151	  if (!host || HOST_PROHIBIDO.test(host)) {
   152	    return { error: 'Esa dirección apunta a una red interna, no a un sitio público, así que no hay nada que revisar.' };
   153	  }
   154	  if (esIpLiteral(host)) {
   155	    return { error: 'Escribe un dominio, no una dirección IP.' };
   156	  }
   157	  if (llevaIpDentro(host)) {
   158	    return { error: 'Esa dirección apunta a una red interna, no a un sitio público, así que no hay nada que revisar.' };
   159	  }
   160	  if (!/^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/.test(host)) {
   161	    return { error: 'Eso no parece un dominio. Escríbelo como tuempresa.cl, sin https:// ni barras.' };
   162	  }
   163	  return { dominio: host };
   164	}
