   512	      // segundos dejan margen para contestar dentro de su ventana.
   513	      signal: AbortSignal.timeout(MS_LECTURA_ORDEN),
   514	      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
